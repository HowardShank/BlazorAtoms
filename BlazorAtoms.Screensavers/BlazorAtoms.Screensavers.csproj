<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Screensavers</PackageId>
    <Title>Blazor Screensavers</Title>
    <Description>Screensaver components for Blazor. Provides various animated screensavers for Blazor applications. Server or WebAssembly, minimal JS.</Description>
    <PackageTags>Blazor;Screensaver;Animation;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
