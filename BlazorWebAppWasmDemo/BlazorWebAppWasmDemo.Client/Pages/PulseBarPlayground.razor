@page "/playground/pulsebar"
@rendermode InteractiveWebAssembly

@using System.Globalization
@using BlazorAtoms.BusyIndicators.Indicators

<PageTitle>AtomPulseBar Playground</PageTitle>

<style>
    .stage-outer {
        background: radial-gradient(ellipse at center, #0b1019 0%, #07090d 100%);
        border: 1px solid #1b2330;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .stage {
        margin: 0 auto;
        outline: 1px dashed #25303f;
        outline-offset: 6px;
    }

    .stage-label {
        color: #6f7d8c;
        font-size: .8rem;
        text-align: center;
        margin-top: 1rem;
    }

    .controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem 1.5rem;
        background: #0d1118;
        border: 1px solid #1b2330;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        color: #cfd8e3;
    }

    .ctrl {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .ctrl label {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #8794a3;
        display: flex;
        justify-content: space-between;
        gap: .5rem;
    }

    .ctrl label .val {
        color: #5fb7c9;
        font-family: ui-monospace, Consolas, monospace;
        text-transform: none;
    }

    .controls input[type=range] {
        width: 100%;
        accent-color: #00b3c4;
    }

    .controls input[type=color] {
        width: 100%;
        height: 32px;
        background: none;
        border: 1px solid #1b2330;
        border-radius: 6px;
        padding: 2px;
    }

    .ctrl .row {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .ctrl .row input[type=checkbox] {
        accent-color: #00b3c4;
        width: 16px;
        height: 16px;
    }

    .ctrl .row label {
        text-transform: none;
        letter-spacing: 0;
        color: #cfd8e3;
        font-size: .85rem;
        justify-content: flex-start;
    }
</style>

<h1>AtomPulseBar playground</h1>
<p>Tune <code>&lt;AtomPulseBar&gt;</code> live. The animation stays pure CSS; changing a control rebuilds the SVG.
   The dashed box is a resizable stand-in for your container, so you can watch the bar fill 100% of its width.</p>
<p><a href="demo">&larr; Back to demo</a> &middot; <a href="playground/pulsescanner">AtomPulseScanner playground &rarr;</a></p>

<div class="stage-outer">
    <div class="stage" style="width:@(ContainerWidth)%">
        <AtomPulseBar Speed="@Speed" Color="@Color" TailLength="@TailLength" TailSpread="@TailSpread"
                  BlockWidth="@BlockWidth" HeadWidth="@EffectiveHeadWidth" Height="@Height"
                  CornerRadius="@CornerRadius" ShowTrack="@ShowTrack" TrackOpacity="@TrackOpacity" />
    </div>
    <div class="stage-label">dashed outline = your container &middot; bar = 100% of its width</div>
</div>

<div class="controls">
    <div class="ctrl">
        <label>Speed (s/sweep) <span class="val">@(Speed.ToString(Inv))s</span></label>
        <input type="range" min="0.3" max="6" step="0.1"
               @bind="Speed" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Color <span class="val">@Color</span></label>
        <input type="color" @bind="Color" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>Tail length <span class="val">@TailLength</span></label>
        <input type="range" min="0" max="30" step="1"
               @bind="TailLength" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>Tail spread <span class="val">@TailSpread.ToString(Inv)</span></label>
        <input type="range" min="0.05" max="0.6" step="0.01"
               @bind="TailSpread" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Block width (tail) <span class="val">@BlockWidth.ToString(Inv)</span></label>
        <input type="range" min="0.02" max="0.5" step="0.01"
               @bind="BlockWidth" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Head width <span class="val">@(HeadLinked ? "(linked)" : HeadWidth.ToString(Inv))</span></label>
        <input type="range" min="0.02" max="0.5" step="0.01"
               @bind="HeadWidth" @bind:event="oninput" @bind:culture="Inv"
               disabled="@HeadLinked" style="@(HeadLinked ? "opacity:.5" : "")" />
        <div class="row">
            <input type="checkbox" id="headLinked" @bind="HeadLinked" />
            <label for="headLinked">Link head to block width</label>
        </div>
    </div>
    <div class="ctrl">
        <label>Height (px) <span class="val">@(Height.ToString(Inv))px</span></label>
        <input type="range" min="4" max="60" step="1"
               @bind="Height" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Corner radius <span class="val">@CornerRadius.ToString(Inv)</span></label>
        <input type="range" min="0" max="50" step="1"
               @bind="CornerRadius" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Track opacity <span class="val">@TrackOpacity.ToString(Inv)</span></label>
        <input type="range" min="0" max="0.5" step="0.01"
               @bind="TrackOpacity" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Track / container</label>
        <div class="row">
            <input type="checkbox" id="showTrack" @bind="ShowTrack" />
            <label for="showTrack">Show track</label>
        </div>
        <label style="margin-top:.4rem">Container width <span class="val">@(ContainerWidth)%</span></label>
        <input type="range" min="40" max="100" step="1"
               @bind="ContainerWidth" @bind:event="oninput" />
    </div>
</div>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    // AtomPulseBar playground state — defaults match AtomPulseBar.razor.
    private double Speed = 2.0;
    private string Color = "#00ffee";
    private int TailLength = 12;
    private double TailSpread = 0.22;
    private double BlockWidth = 0.14;
    private double HeadWidth = 0.14;
    private bool HeadLinked = true;
    private double Height = 14;
    private double CornerRadius = 16;
    private double TrackOpacity = 0.12;
    private bool ShowTrack = true;
    private int ContainerWidth = 100;

    // When linked, pass null so AtomPulseBar falls back to BlockWidth for the head.
    private double? EffectiveHeadWidth => HeadLinked ? null : HeadWidth;
}
