@inherits LayoutComponentBase
@using BlazorAtoms.Breadcrumbs
<style>
    main {
        min-width: 0px;
        flex: 1 1 0%;
    }

    article {
        max-width: 100%;
        box-sizing: border-box;
    }
</style>
<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div id="top-row" class="top-row px-4">
            <AtomBreadcrumbBar />

            <a href="about">About</a>
        </div>

        <div class="px-4">
            <AtomBreadcrumbBar />
        </div>

        <article id="content" class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
