@* AtomCardsMark.razor — BlazorAtoms "Cards" brand mark. Thin wrapper over the shared AtomMark engine.
   Payload (symbol / number / label / colors) is baked here; chrome (tile shape, flame, fonts, the
   "Blazor" wordmark) is inherited from AtomMark's defaults. Needs AtomMark.razor in the same folder
   (or @using its namespace). Override Layout (Icon|Lockup|Stacked) or Size; the brand payload is fixed. *@
<AtomMark Layout="@Layout" Size="@Size"
          Number="48" Symbol="Cd" Label="CARDS" Word2="CARDS"
          TileTop="#957fe9" TileBottom="#6a4be0" Stroke="#3314a7" Ember="#ad9ceb" Cream="#ffffff"
          FlameTip="#fce792" FlameMid="#fa9829" FlameBase="#f5450a"
          InnerTop="#ffedb8" InnerBottom="#ffb13d"
          Word2Top="#fa9829" Word2Bottom="#6a4be0" SymbolColor="#FFFFFF" />

@code {
    /// <summary>Layout arrangement — Icon (default), Lockup, or Stacked.</summary>
    [Parameter] public AtomMark.MarkLayout Layout { get; set; } = AtomMark.MarkLayout.Icon;

    /// <summary>Overall size in px — icon edge, or lockup/stacked height (width keeps aspect).</summary>
    [Parameter] public int Size { get; set; } = 128;
}
