<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- Makes `dotnet run` serve this project on its own: without it a standalone WASM project has
         no RunCommand and the process exits without listening on anything. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Demos.Shared is the only project reference a demo host needs: it owns the site chrome
         (MainLayout, NavMenu), every playground view, and RouteInfoService, and it carries the
         BlazorAtoms.* and Branding references those need. Types and static web assets both flow
         transitively, so listing individual component libraries here duplicates that graph and
         goes stale — see the note in CLAUDE.md's new-library checklist. -->
    <ProjectReference Include="..\Demos.Shared\Demos.Shared.csproj" />
  </ItemGroup>

</Project>
