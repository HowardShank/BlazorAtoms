<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- TRANSITIONAL — delete once samples\BlazorWebAppWasmDemo\{BlazorWebAppWasmDemo,
       BlazorWebAppWasmDemo.Client}\ are removed from disk. This project sits at the sample folder
       root (mirroring BlazorWebAppSvrDemo), so its default **\*.cs and **\*.razor globs would
       otherwise swallow the two old project directories nested beneath it: duplicate component
       types, duplicate @page routes, two Program classes. DefaultItemExcludes is the right knob
       because the Razor SDK's own .razor glob honours it (Sdk.Razor.CurrentVersion.props: Content
       Include="**\*.razor" Exclude="$(DefaultItemExcludes);…", and RazorComponent is derived from
       @(Content) in Sdk.Razor.CurrentVersion.targets). -->
  <PropertyGroup>
    <DefaultItemExcludes>$(DefaultItemExcludes);BlazorWebAppWasmDemo\**;BlazorWebAppWasmDemo.Client\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <!-- Makes `dotnet run` serve this project on its own: without it a standalone WASM project has
         no RunCommand and the process exits without listening on anything. -->
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorAtoms.ActivityIndicators\BlazorAtoms.ActivityIndicators.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Barcodes\BlazorAtoms.Barcodes.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Tooltips\BlazorAtoms.Tooltips.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Badges\BlazorAtoms.Badges.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Avatars\BlazorAtoms.Avatars.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Clocks\BlazorAtoms.Clocks.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Canvas\BlazorAtoms.Canvas.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Ratings\BlazorAtoms.Ratings.csproj" />
    <ProjectReference Include="..\..\src\BlazorAtoms.Equipment\BlazorAtoms.Equipment.csproj" />
    <ProjectReference Include="..\BlazorAtoms.Branding\BlazorAtoms.Branding.csproj" />
    <ProjectReference Include="..\Demos.Shared\Demos.Shared.csproj" />
  </ItemGroup>

</Project>
