<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Demos.Shared is the only project reference a demo host needs: it owns the site chrome
         (MainLayout, NavMenu), every playground view, and RouteInfoService, and it carries the
         BlazorAtoms.* and Branding references those need. Types and static web assets both flow
         transitively, so listing individual component libraries here duplicates that graph and
         goes stale — see the note in CLAUDE.md's new-library checklist. -->
    <ProjectReference Include="..\..\Demos.Shared\Demos.Shared.csproj" />
    <ProjectReference Include="..\BlazorWebAppAutoDemo.Client\BlazorWebAppAutoDemo.Client.csproj" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.Server" />
  </ItemGroup>

</Project>
