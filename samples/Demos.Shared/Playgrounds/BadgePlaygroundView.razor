@using BlazorAtoms.Badges

<PageTitle>AtomBadge Playground</PageTitle>

<style>
    .tt-stage-outer { display:flex; align-items:center; justify-content:center; gap:2.5rem; min-height:200px;
        background: radial-gradient(ellipse at center,#0b1019 0%,#07090d 100%); border:1px solid #1b2330;
        border-radius:12px; padding:1.5rem; margin-bottom:1.5rem; }
    .tt-host { width:56px; height:56px; display:flex; align-items:center; justify-content:center;
        font-size:1.6rem; background:#161b26; border:1px solid #2a3242; border-radius:12px; color:#e5e9f0; }
    .tt-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:1rem 1.5rem;
        background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; }
    .tt-ctrl { display:flex; flex-direction:column; gap:.35rem; }
    .tt-ctrl label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .tt-ctrl label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .tt-controls input[type=text], .tt-controls input[type=number], .tt-controls select { width:100%; accent-color:#00b3c4; }
    .tt-controls input[type=color] { height:32px; background:none; border:1px solid #1b2330; border-radius:6px; padding:2px; }
    .tt-ctrl .row { display:flex; align-items:center; gap:.5rem; }
    .tt-ctrl .row input[type=checkbox] { accent-color:#00b3c4; width:16px; height:16px; }
    .tt-ctrl .row label { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
    .tt-ctrl .row.color { gap:.4rem; }
    .tt-ctrl .row.color input[type=color] { flex:none; width:34px; }
    .tt-ctrl .row.color input[type=text] { flex:1 1 auto; min-width:0; }
</style>

<h1>AtomBadge playground</h1>
<p>One badge for every job: a label/count in many shapes (pill/circle/square/rounded + SVG star/hexagon/diamond/shield/burst/ribbon), inline or overlaying a host. Motion is opt-in via <code>Animation</code> (default <code>None</code>) and respects reduced-motion.</p>
<p><a href="playground/activityindicators">&larr; Back to demo</a></p>

<div class="tt-stage-outer">
    <div>
        @if (Overlay)
        {
            <AtomBadge Value="@BadgeValue" Max="@Max" ShowZero="@ShowZero" Dot="@Dot"
                       Placement="@Placement" Shape="@Shape" Variant="@Variant"
                       Animation="@Animation" Trigger="@Trigger"
                       Background="@(OverrideBg ? Blank(Bg) : null)" TextColor="@(OverrideFg ? Blank(Fg) : null)"
                       BorderColor="@(OverrideBorder ? Blank(BorderCol) : null)" BorderWidth="@(BorderWidth > 0 ? BorderWidth : null)"
                       Size="@Size" Width="@Blank(Width)" Height="@Blank(Height)" Radius="@Radius"
                       Duration="@Duration" Delay="@Delay"
                       Offset="@(UseOffset ? Offset : null)" OffsetX="@OffsetX" OffsetY="@OffsetY"
                       MaxWidth="@Blank(MaxWidth)" AriaLabel="@Blank(AriaLabel)"
                       CssClass="@Blank(HatchClass)" Style="@Blank(HatchStyle)" title="@Blank(HatchTitle)">
                <div class="tt-host">🔔</div>
            </AtomBadge>
        }
        else
        {
            <AtomBadge Value="@BadgeValue" Max="@Max" ShowZero="@ShowZero" Dot="@Dot"
                       Shape="@Shape" Variant="@Variant" Animation="@Animation" Trigger="@Trigger"
                       Background="@(OverrideBg ? Blank(Bg) : null)" TextColor="@(OverrideFg ? Blank(Fg) : null)"
                       BorderColor="@(OverrideBorder ? Blank(BorderCol) : null)" BorderWidth="@(BorderWidth > 0 ? BorderWidth : null)"
                       Size="@Size" Width="@Blank(Width)" Height="@Blank(Height)" Radius="@Radius"
                       Duration="@Duration" Delay="@Delay"
                       MaxWidth="@Blank(MaxWidth)" AriaLabel="@Blank(AriaLabel)"
                       CssClass="@Blank(HatchClass)" Style="@Blank(HatchStyle)" title="@Blank(HatchTitle)" />
        }
    </div>
</div>

<div class="tt-controls">
    <div class="tt-ctrl"><label>Value</label>
        <input type="text" @bind="RawValue" @bind:event="oninput" placeholder="text or number" />
    </div>
    <div class="tt-ctrl"><label>Max (0=none) <span class="val">@Max</span></label><input type="number" min="0" @bind="Max" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Placement</label><select @bind="Placement" disabled="@(!Overlay)">@foreach (var p in Enum.GetValues<Placement>()){<option value="@p">@p</option>}</select></div>
    <div class="tt-ctrl"><label>Shape</label><select @bind="Shape">@foreach (var s in Enum.GetValues<Shape>()){<option value="@s">@s</option>}</select></div>
    <div class="tt-ctrl"><label>Variant</label><select @bind="Variant">@foreach (var v in Enum.GetValues<Variant>()){<option value="@v">@v</option>}</select></div>
    <div class="tt-ctrl"><label>Animation</label><select @bind="Animation">@foreach (var a in Enum.GetValues<BadgeAnimation>()){<option value="@a">@a</option>}</select></div>
    <div class="tt-ctrl"><label>Trigger</label><select @bind="Trigger">@foreach (var t in Enum.GetValues<AnimationTrigger>()){<option value="@t">@t</option>}</select></div>
    <div class="tt-ctrl"><label>Size (px) <span class="val">@Size</span></label><input type="number" min="10" max="72" @bind="Size" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Width (e.g. 40px)</label><input type="text" @bind="Width" @bind:event="oninput" placeholder="auto" /></div>
    <div class="tt-ctrl"><label>Height (e.g. 24px)</label><input type="text" @bind="Height" @bind:event="oninput" placeholder="auto" /></div>
    <div class="tt-ctrl"><label>Radius px (Rounded) <span class="val">@Radius</span></label><input type="number" min="0" max="30" @bind="Radius" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Max width (e.g. 6ch)</label><input type="text" @bind="MaxWidth" @bind:event="oninput" placeholder="none" /></div>
    <div class="tt-ctrl"><label>Duration s <span class="val">@Duration</span></label><input type="number" min="0.1" max="4" step="0.1" @bind="Duration" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Delay s <span class="val">@Delay</span></label><input type="number" min="0" max="3" step="0.1" @bind="Delay" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Offset px (straddle) <span class="val">@Offset</span></label><div class="row"><input type="checkbox" @bind="UseOffset" disabled="@(!Overlay)" /><input type="number" min="0" max="40" @bind="Offset" @bind:event="oninput" disabled="@(!Overlay || !UseOffset)" /></div></div>
    <div class="tt-ctrl"><label>Offset X px <span class="val">@OffsetX</span></label><input type="number" min="-40" max="40" @bind="OffsetX" @bind:event="oninput" disabled="@(!Overlay)" /></div>
    <div class="tt-ctrl"><label>Offset Y px <span class="val">@OffsetY</span></label><input type="number" min="-40" max="40" @bind="OffsetY" @bind:event="oninput" disabled="@(!Overlay)" /></div>
    <div class="tt-ctrl"><label>Background</label><div class="row color"><input type="checkbox" @bind="OverrideBg" title="Override variant default" /><input type="color" aria-label="Background picker" @bind="Bg" @bind:event="oninput" disabled="@(!OverrideBg)" /><input type="text" @bind="Bg" @bind:event="oninput" disabled="@(!OverrideBg)" placeholder="(variant default)" /></div></div>
    <div class="tt-ctrl"><label>Text color</label><div class="row color"><input type="checkbox" @bind="OverrideFg" title="Override variant default" /><input type="color" aria-label="Text color picker" @bind="Fg" @bind:event="oninput" disabled="@(!OverrideFg)" /><input type="text" @bind="Fg" @bind:event="oninput" disabled="@(!OverrideFg)" placeholder="(variant default)" /></div></div>
    <div class="tt-ctrl"><label>Border color</label><div class="row color"><input type="checkbox" @bind="OverrideBorder" title="Override variant default" /><input type="color" aria-label="Border color picker" @bind="BorderCol" @bind:event="oninput" disabled="@(!OverrideBorder)" /><input type="text" @bind="BorderCol" @bind:event="oninput" disabled="@(!OverrideBorder)" placeholder="(variant default)" /></div></div>
    <div class="tt-ctrl"><label>Border width px <span class="val">@BorderWidth</span></label><input type="number" min="0" max="6" step="0.5" @bind="BorderWidth" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Options</label>
        <div class="row"><input type="checkbox" id="ov" @bind="Overlay" /><label for="ov">Overlay a host</label></div>
        <div class="row"><input type="checkbox" id="dot" @bind="Dot" /><label for="dot">Dot</label></div>
        <div class="row"><input type="checkbox" id="sz" @bind="ShowZero" /><label for="sz">Show zero</label></div>
    </div>
    <div class="tt-ctrl"><label>Aria label</label><input type="text" @bind="AriaLabel" @bind:event="oninput" placeholder="(display text)" /></div>
    <div class="tt-ctrl"><label>Extra class (CssClass)</label><input type="text" placeholder="(none)" @bind="HatchClass" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Extra style (Style)</label><input type="text" placeholder="(none)" @bind="HatchStyle" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>title attr (splat)</label><input type="text" placeholder="(none)" @bind="HatchTitle" @bind:event="oninput" /></div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomBadgeExample.razor" />

@code {
    private string RawValue = "3";
    private int Max = 99;
    private bool ShowZero;
    private bool Dot;
    private bool Overlay = true;
    private Placement Placement = Placement.TopEnd;
    private Shape Shape = Shape.Pill;
    private Variant Variant = Variant.Danger;
    // Default the control to Pop so the demo moves; the component's own default is None.
    private BadgeAnimation Animation = BadgeAnimation.Pop;
    private AnimationTrigger Trigger = AnimationTrigger.OnChange;
    private double Size = 20;
    private string Width = "";
    private string Height = "";
    private double Radius = 6;
    private string MaxWidth = "";
    private double Duration = 0.5;
    private double Delay = 0;
    private bool UseOffset;
    private double Offset = 8;
    private double OffsetX;
    private double OffsetY;
    private bool OverrideBg;
    private string Bg = "#ef4444";
    private bool OverrideFg;
    private string Fg = "#ffffff";
    private bool OverrideBorder;
    private string BorderCol = "#ffffff";
    private double BorderWidth = 0;
    private string AriaLabel = "";
    private string HatchClass = "";
    private string HatchStyle = "";
    private string HatchTitle = "";

    // Feed a number when the text parses as one (so Max/ShowZero behave), else the raw string.
    private object? BadgeValue => long.TryParse(RawValue, out var n) ? n : (object?)RawValue;

    private static string? Blank(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    // Paste-ready markup reproducing the current preview. Value shown as a literal — bind it to
    // your own field/expression in real use.
    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<AtomBadge");
            sb.Append($" Value=\"{RawValue}\"");
            if (Max > 0) sb.Append($" Max=\"{Max}\"");
            if (ShowZero) sb.Append(" ShowZero=\"true\"");
            if (Dot) sb.Append(" Dot=\"true\"");
            if (Overlay && Placement != Placement.TopEnd) sb.Append($" Placement=\"Placement.{Placement}\"");
            if (Shape != Shape.Pill) sb.Append($" Shape=\"Shape.{Shape}\"");
            if (Variant != Variant.Default) sb.Append($" Variant=\"Variant.{Variant}\"");
            if (Animation != BadgeAnimation.None) sb.Append($" Animation=\"BadgeAnimation.{Animation}\"");
            if (Animation != BadgeAnimation.None && Trigger != AnimationTrigger.Appear) sb.Append($" Trigger=\"AnimationTrigger.{Trigger}\"");
            if (OverrideBg && Blank(Bg) is not null) sb.Append($" Background=\"{Bg}\"");
            if (OverrideFg && Blank(Fg) is not null) sb.Append($" TextColor=\"{Fg}\"");
            if (OverrideBorder && Blank(BorderCol) is not null) sb.Append($" BorderColor=\"{BorderCol}\"");
            if (BorderWidth > 0) sb.Append($" BorderWidth=\"{BorderWidth}\"");
            if (Size != 20) sb.Append($" Size=\"{Size}\"");
            if (!string.IsNullOrWhiteSpace(Width)) sb.Append($" Width=\"{Width}\"");
            if (!string.IsNullOrWhiteSpace(Height)) sb.Append($" Height=\"{Height}\"");
            if (Shape == Shape.Rounded) sb.Append($" Radius=\"{Radius}\"");
            if (!string.IsNullOrWhiteSpace(MaxWidth)) sb.Append($" MaxWidth=\"{MaxWidth}\"");
            if (Animation != BadgeAnimation.None && Duration != 0.5) sb.Append($" Duration=\"{Duration}\"");
            if (Animation != BadgeAnimation.None && Delay != 0) sb.Append($" Delay=\"{Delay}\"");
            if (Overlay && UseOffset) sb.Append($" Offset=\"{Offset}\"");
            if (Overlay && OffsetX != 0) sb.Append($" OffsetX=\"{OffsetX}\"");
            if (Overlay && OffsetY != 0) sb.Append($" OffsetY=\"{OffsetY}\"");
            if (!string.IsNullOrEmpty(AriaLabel)) sb.Append($" AriaLabel=\"{AriaLabel}\"");
            if (!string.IsNullOrEmpty(HatchClass)) sb.Append($" CssClass=\"{HatchClass}\"");
            if (!string.IsNullOrEmpty(HatchStyle)) sb.Append($" Style=\"{HatchStyle}\"");
            if (!string.IsNullOrEmpty(HatchTitle)) sb.Append($" title=\"{HatchTitle}\"");
            if (Overlay)
                sb.Append(">\n    <span>🔔</span>\n</AtomBadge>");
            else
                sb.Append(" />");
            return sb.ToString();
        }
    }
}
