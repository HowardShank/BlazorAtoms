@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using BlazorAtoms.DynamicFormWizard
@using BlazorAtoms.DynamicFormWizard.Attributes

<PageTitle>Dynamic Form Wizard Playground</PageTitle>

<h1>Dynamic Form Wizard playground</h1>
<p>Reflection/attribute-driven multi-step wizard. Decorate a POCO with <code>[FormStep]</code>/
   <code>[DependsOn]</code>/<code>[FormPathEnd]</code> and the engine generates the whole flow --
   branching, rejoining, dynamic step count/position, and per-step validation, with zero hand-written
   markup for the fields themselves. See
   <code>src/BlazorAtoms.DynamicFormWizard/DESIGN-DISCUSSION.md</code> for the full design log and
   <code>FLOW.md</code> for diagrams.</p>
<p>Try it: pick <strong>Manager</strong> on step 1 to see a third step (Manager Details) appear.
   Pick <strong>Personal</strong> and the wizard ends right after Contact Info -- the
   <code>[FormPathEnd]</code> marker on that step stops navigation there even though a Manager
   Details step exists later in the model.</p>
<p>Type <strong>Springfield</strong> into City (step 2) to reveal a "Regional Discount" checkbox on
   that same step -- <code>RegionalDiscount</code>'s <code>[DependsOn("Contact.City", "Springfield")]</code>
   is a dotted-path target reaching <em>into</em> the auto-expanded <code>Contact</code> group
   (DESIGN-DISCUSSION.md section M, #138), not just a flat top-level sibling.</p>
<p><code>ShowCancelButton</code>/<code>OnWizardCancel</code> (#137) add the Cancel button in the
   nav row below. <strong>Save draft</strong>/<strong>Resume saved draft</strong> (#134) show
   draft-save/resume: <code>Model</code> and <code>CurrentStep</code> are serialized to a plain
   JSON string (standing in for wherever you'd actually persist it -- localStorage, an API call,
   ...), then restored later into a fresh wizard via <code>Model</code> + <code>InitialStep</code>.
   This engine never touches storage itself.</p>

@if (_completed is not null)
{
    <p>
        <strong>Submitted!</strong> Kind=@_completed.Kind, Street=@_completed.Contact.Street,
        City=@_completed.Contact.City, RegionalDiscount=@_completed.RegionalDiscount
        @if (_completed.Kind == AccountKind.Manager)
        {
            <text>, Company=@_completed.Manager.CompanyName</text>
        }
    </p>
    <button type="button" @onclick="Reset">Start over</button>
}
else if (_cancelled)
{
    <p><strong>Cancelled.</strong> Nothing was submitted.</p>
    <button type="button" @onclick="Reset">Start over</button>
}
else
{
    <div class="dfw-draft-controls">
        <button type="button" @onclick="SaveDraft">Save draft</button>
        <button type="button" @onclick="LoadDraft" disabled="@(_savedDraftJson is null)">Resume saved draft</button>
    </div>
    @if (_draftStatus is not null)
    {
        <p><em>@_draftStatus</em></p>
    }
    @if (_savedDraftJson is not null)
    {
        <pre class="dfw-draft-json"><code>@_savedDraftJson</code></pre>
    }

    <DynamicWizard @ref="_wizardRef" @key="_wizardInstanceKey" TModel="AccountSetupModel" Model="_model"
                   OnWizardComplete="HandleComplete" OnWizardCancel="HandleCancel" ShowCancelButton="true"
                   InitialStep="_initialStep" />
}

@code {
    private AccountSetupModel _model = new();
    private AccountSetupModel? _completed;
    private bool _cancelled;

    private DynamicWizard<AccountSetupModel>? _wizardRef;
    private int? _initialStep;
    private int _wizardInstanceKey;
    private string? _savedDraftJson;
    private string? _draftStatus;

    private void HandleComplete(AccountSetupModel model) => _completed = model;

    private void HandleCancel(AccountSetupModel model) => _cancelled = true;

    private void Reset()
    {
        _model = new();
        _completed = null;
        _cancelled = false;
        _initialStep = null;
        _savedDraftJson = null;
        _draftStatus = null;
    }

    private record DraftSnapshot(AccountSetupModel Model, int Step);

    private void SaveDraft()
    {
        var step = _wizardRef?.CurrentStep ?? 1;
        _savedDraftJson = JsonSerializer.Serialize(new DraftSnapshot(_model, step));
        _draftStatus = $"Draft saved at step {step}.";
    }

    private void LoadDraft()
    {
        if (_savedDraftJson is null)
        {
            return;
        }

        var snapshot = JsonSerializer.Deserialize<DraftSnapshot>(_savedDraftJson)!;
        _model = snapshot.Model;
        _initialStep = snapshot.Step;
        _wizardInstanceKey++; // forces a fresh DynamicWizard instance so InitialStep is re-read in OnInitialized
        _draftStatus = $"Draft loaded -- resumed at step {snapshot.Step}.";
    }

    public enum AccountKind { Personal, Manager }

    public class ContactInfo
    {
        [Required(ErrorMessage = "Street is required.")]
        public string Street { get; set; } = string.Empty;

        public string City { get; set; } = string.Empty;
    }

    public class ManagerInfo
    {
        [Required(ErrorMessage = "Company name is required.")]
        public string CompanyName { get; set; } = string.Empty;

        public string TaxId { get; set; } = string.Empty;
    }

    public class AccountSetupModel
    {
        [FormStep(1, "Account Type")]
        public AccountKind Kind { get; set; } = AccountKind.Personal;

        [FormStep(2, "Contact Info")]
        [FormPathEnd(nameof(Kind), AccountKind.Personal)]
        public ContactInfo Contact { get; set; } = new();

        // Dotted-path [DependsOn] (DESIGN-DISCUSSION.md section M.1, #138) -- reaches INTO the
        // Contact nested group's own City field, not just a flat top-level sibling.
        [FormStep(2)]
        [DependsOn("Contact.City", "Springfield")]
        public bool RegionalDiscount { get; set; }

        [FormStep(3, "Manager Details")]
        [DependsOn(nameof(Kind), AccountKind.Manager)]
        public ManagerInfo Manager { get; set; } = new();
    }
}

<style>
    .dfw-draft-controls {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .dfw-draft-json {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.8rem;
        line-height: 1.5;
        max-height: 12rem;
        overflow-y: auto;
    }
</style>
