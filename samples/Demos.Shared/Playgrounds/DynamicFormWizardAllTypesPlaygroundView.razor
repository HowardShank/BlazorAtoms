            [FormStep(1)] [FormOrder(2)]  public bool IsActive { get; set; }
            [FormStep(1)] [FormOrder(3)]  public Priority Level { get; set; } = Priority.Medium;
            [FormStep(1)] [FormOrder(4)]  public char Initial { get; set; } = 'A';
            [FormStep(1)] [FormOrder(5)]  public sbyte SignedByte { get; set; }
