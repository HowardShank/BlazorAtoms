<style>
    .dfw-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
    }

    .dfw-source pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .dfw-summary {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.25rem 1rem;
    }

    .dfw-summary dt {
        font-weight: 600;
    }

    .dfw-summary dd {
        margin: 0;
    }

    .dfw-draft-controls {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .dfw-draft-json {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.8rem;
        line-height: 1.5;
        max-height: 12rem;
        overflow-y: auto;
    }

    .dfw-summary-heading {
        grid-column: 1 / -1;
        margin-top: 0.75rem;
        font-weight: 700;
        border-top: 1px solid currentColor;
        padding-top: 0.5rem;
    }

    @@media (max-width: 900px) {
        .dfw-columns {
            grid-template-columns: 1fr;
        }
    }
</style>
