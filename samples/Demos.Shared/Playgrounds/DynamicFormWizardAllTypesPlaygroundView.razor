            [FormStep(1)] [FormOrder(19)] public DateOnly EventDate { get; set; } = DateOnly.FromDateTime(DateTime.Today);
            [FormStep(1)] [FormOrder(20)] public TimeOnly ReminderTime { get; set; } = new TimeOnly(9, 0);
            [FormStep(1)] [FormOrder(21)] public TimeSpan Duration { get; set; } = TimeSpan.FromHours(1);
            [FormStep(1)] [FormOrder(22)] public Guid TrackingId { get; set; } = Guid.NewGuid();

            // Step 2: the same set again as Nullable<T>, all starting unset (null).
            [FormStep(2, "Nullable Variants")] [FormOrder(1)]  public bool? IsActiveN { get; set; }
            [FormStep(2)] [FormOrder(2)]  public Priority? LevelN { get; set; }
            [FormStep(2)] [FormOrder(3)]  public char? InitialN { get; set; }
            [FormStep(2)] [FormOrder(4)]  public sbyte? SignedByteN { get; set; }
