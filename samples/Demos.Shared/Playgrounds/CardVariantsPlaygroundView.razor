@page "/playground/cardvariants"
@using BlazorAtoms.Cards
@using BlazorAtoms.Transitions

<PageTitle>Card variants Playground</PageTitle>

<div class="cardvariants-page">
    <h1>Card variants playground</h1>
    <p>
        The hover-reveal card family beyond <a href="/playground/cardreveal">AtomCardReveal</a>.
        Each is its own component rather than an effect enum, because each needs a parameter the
        others can't use — a flip axis, an expand height, a curl size. All share the same 11 params
        via <code>AtomCardBase</code>. Pure CSS, zero JS.
    </p>
    <p><a href="/">&larr; Back to home</a></p>

    <div class="cardvariants-controls">
        <div class="ctrl">
            <label>Title</label>
            <input type="text" @bind="Title" @bind:event="oninput" />
        </div>
        <div class="ctrl">
            <label>Background image URL</label>
            <input type="text" @bind="BackgroundImageUrl" @bind:event="oninput" />
        </div>
        <div class="ctrl">
            <label>Accent color</label>
            <div class="cardvariants-color-row">
                <input type="color" @bind="AccentColor" @bind:event="oninput" />
                <input type="text" @bind="AccentColor" @bind:event="oninput" />
            </div>
        </div>
        <div class="ctrl">
            <label>Width</label>
            <input type="text" @bind="Width" @bind:event="oninput" placeholder="45vmin" />
        </div>
        <div class="ctrl">
            <label>Height</label>
            <input type="text" @bind="Height" @bind:event="oninput" placeholder="55vmin" />
        </div>
        <div class="ctrl">
            <label>Border width ("0" = no frame)</label>
            <input type="text" @bind="BorderWidth" @bind:event="oninput" placeholder="8px" />
        </div>
        <div class="ctrl">
            <label>Border color (blank = accent)</label>
            <input type="text" @bind="BorderColor" @bind:event="oninput" placeholder="e.g. #222" />
        </div>
        <div class="ctrl">
            <label>Dot count</label>
            <input type="number" min="0" max="8" @bind="DotCount" @bind:event="oninput" />
        </div>
    </div>

    <h2>AtomCardFlip</h2>
    <p class="cardvariants-note">Hover: the card rotates 180° around <code>FlipAxis</code>; the body is the back face.</p>
    <div class="cardvariants-controls">
        <div class="ctrl">
            <label>Flip axis</label>
            <select @bind="FlipAxis">
                <option value="@CardFlipAxis.Y">Y (turns like a page)</option>
                <option value="@CardFlipAxis.X">X (turns like a calendar)</option>
            </select>
        </div>
        <div class="ctrl">
            <label>Perspective</label>
            <input type="text" @bind="Perspective" @bind:event="oninput" placeholder="1200px" />
        </div>
    </div>
    <CodeSnippetBox Code="@FlipSnippet" FileName="AtomCardFlipExample.razor" />
    <div class="cardvariants-demo-wrap">
        <AtomCardFlip Title="@Title" BackgroundImageUrl="@BackgroundImageUrl" AccentColor="@AccentColor"
                      Width="@Nz(Width, "45vmin")" Height="@Nz(Height, "55vmin")" BorderWidth="@Nz(BorderWidth, "8px")" BorderColor="@NzNull(BorderColor)" DotCount="DotCount"
                      FlipAxis="FlipAxis" Perspective="@Nz(Perspective, "1200px")">
            <Subtitle>@((MarkupString)Subtitle)</Subtitle>
            <BodyContent>@BodyParagraphs</BodyContent>
        </AtomCardFlip>
    </div>

    <h2>AtomCardExpand</h2>
    <p class="cardvariants-note">Hover: the card grows to <code>ExpandedHeight</code> and the body slides up from the bottom.</p>
    <div class="cardvariants-controls">
        <div class="ctrl">
            <label>Expanded height</label>
            <input type="text" @bind="ExpandedHeight" @bind:event="oninput" placeholder="75vmin" />
        </div>
        <div class="ctrl">
            <label>Body height</label>
            <input type="text" @bind="BodyHeight" @bind:event="oninput" placeholder="75%" />
        </div>
    </div>
    <CodeSnippetBox Code="@ExpandSnippet" FileName="AtomCardExpandExample.razor" />
    <div class="cardvariants-demo-wrap cardvariants-demo-tall">
        <AtomCardExpand Title="@Title" BackgroundImageUrl="@BackgroundImageUrl" AccentColor="@AccentColor"
                        Width="@Nz(Width, "45vmin")" Height="@Nz(Height, "55vmin")" BorderWidth="@Nz(BorderWidth, "8px")" BorderColor="@NzNull(BorderColor)" DotCount="DotCount"
                        ExpandedHeight="@Nz(ExpandedHeight, "75vmin")" BodyHeight="@Nz(BodyHeight, "75%")">
            <Subtitle>@((MarkupString)Subtitle)</Subtitle>
            <BodyContent>@BodyParagraphs</BodyContent>
        </AtomCardExpand>
    </div>

    <h2>AtomCardCurl</h2>
    <p class="cardvariants-note">
        Hover: the chosen corner peels back to uncover the body. This is a CSS corner <em>fold</em>,
        not a photorealistic curl — CSS can't warp a plane, that needs an SVG filter or WebGL.
    </p>
    <div class="cardvariants-controls">
        <div class="ctrl">
            <label>Corner</label>
            <select @bind="Corner">
                <option value="@CardCurlCorner.BottomRight">Bottom right</option>
                <option value="@CardCurlCorner.BottomLeft">Bottom left</option>
                <option value="@CardCurlCorner.TopRight">Top right</option>
                <option value="@CardCurlCorner.TopLeft">Top left</option>
            </select>
        </div>
        <div class="ctrl">
            <label>Curl size (on hover)</label>
            <input type="text" @bind="CurlSize" @bind:event="oninput" placeholder="60%" />
        </div>
        <div class="ctrl">
            <label>Resting curl size (dog-ear hint)</label>
            <input type="text" @bind="RestingCurlSize" @bind:event="oninput" placeholder="2.5rem" />
        </div>
        <div class="ctrl">
            <label>Fold color</label>
            <div class="cardvariants-color-row">
                <input type="color" @bind="FoldColor" @bind:event="oninput" />
                <input type="text" @bind="FoldColor" @bind:event="oninput" />
            </div>
        </div>
    </div>
    <CodeSnippetBox Code="@CurlSnippet" FileName="AtomCardCurlExample.razor" />
    <div class="cardvariants-demo-wrap">
        <AtomCardCurl Title="@Title" BackgroundImageUrl="@BackgroundImageUrl" AccentColor="@AccentColor"
                      Width="@Nz(Width, "45vmin")" Height="@Nz(Height, "55vmin")" BorderWidth="@Nz(BorderWidth, "8px")" BorderColor="@NzNull(BorderColor)" DotCount="DotCount"
                      Corner="Corner" CurlSize="@Nz(CurlSize, "60%")"
                      RestingCurlSize="@Nz(RestingCurlSize, "2.5rem")" FoldColor="@FoldColor">
            <Subtitle>@((MarkupString)Subtitle)</Subtitle>
            <BodyContent>@BodyParagraphs</BodyContent>
        </AtomCardCurl>
    </div>

    <h2>AtomCardSplit</h2>
    <p class="cardvariants-note">
        Hover: the face splits along <code>SplitAxis</code> and both halves swing open, hinged on their
        outer edges, to expose the body panel. Each half carries the whole image pinned to its own
        outer edge, so the closed card reads as one unbroken picture. The halves have no back faces —
        they stop being drawn past 90°, which keeps the revealed text a single element instead of
        content split across two backs.
    </p>
    <div class="cardvariants-controls">
        <div class="ctrl">
            <label>Split axis</label>
            <select @bind="SplitAxis">
                <option value="@CardSplitAxis.Vertical">Vertical seam (shutters)</option>
                <option value="@CardSplitAxis.Horizontal">Horizontal seam (hatch)</option>
            </select>
        </div>
        <div class="ctrl">
            <label>Open duration</label>
            <input type="text" @bind="OpenDuration" @bind:event="oninput" placeholder=".6s" />
        </div>
        <div class="ctrl">
            <label>Seam circle</label>
            <select @bind="ShowSeamCircle">
                <option value="false">Off</option>
                <option value="true">On</option>
            </select>
        </div>
        <div class="ctrl">
            <label>Seam circle size</label>
            <input type="text" @bind="SeamCircleSize" @bind:event="oninput" placeholder="100px" />
        </div>
    </div>
    <CodeSnippetBox Code="@SplitSnippet" FileName="AtomCardSplitExample.razor" />
    <div class="cardvariants-demo-wrap">
        <AtomCardSplit Title="@Title" BackgroundImageUrl="@BackgroundImageUrl" AccentColor="@AccentColor"
                       Width="@Nz(Width, "45vmin")" Height="@Nz(Height, "55vmin")"
                       BorderWidth="@Nz(BorderWidth, "8px")" BorderColor="@NzNull(BorderColor)"
                       DotCount="DotCount" SplitAxis="SplitAxis"
                       OpenDuration="@Nz(OpenDuration, ".6s")" ShowSeamCircle="ShowSeamCircle"
                       SeamCircleSize="@Nz(SeamCircleSize, "100px")">
            <Subtitle>@((MarkupString)Subtitle)</Subtitle>
            <BodyContent>@BodyParagraphs</BodyContent>
        </AtomCardSplit>
    </div>

    <h2>Tilt — composed, not a card component</h2>
    <p class="cardvariants-note">
        Tilt reveals nothing, so it isn't a card at all: it's <code>HoverEffect.Tilt</code> on
        <code>AtomHoverEffect</code>, which works on any content. Wrap any card in it to compose.
    </p>
    <div class="cardvariants-controls">
        <div class="ctrl">
            <label>Tilt degrees</label>
            <input type="number" min="0" max="45" @bind="TiltDegrees" @bind:event="oninput" />
        </div>
    </div>
    <CodeSnippetBox Code="@TiltSnippet" FileName="AtomHoverEffectTiltExample.razor" />
    <div class="cardvariants-demo-wrap">
        <AtomHoverEffect Effect="HoverEffect.Tilt" TiltDegrees="TiltDegrees">
            <AtomCardCurl Title="@Title" BackgroundImageUrl="@BackgroundImageUrl" AccentColor="@AccentColor"
                          Width="@Nz(Width, "45vmin")" Height="@Nz(Height, "55vmin")" BorderWidth="@Nz(BorderWidth, "8px")" BorderColor="@NzNull(BorderColor)" DotCount="DotCount">
                <Subtitle>@((MarkupString)Subtitle)</Subtitle>
                <BodyContent>@BodyParagraphs</BodyContent>
            </AtomCardCurl>
        </AtomHoverEffect>
    </div>
</div>

<style>
    .cardvariants-page { max-width: 900px; margin: 0 auto; padding: 2rem 1.5rem 6rem; }
    .cardvariants-page h2 { margin-top: 3rem; }
    .cardvariants-note { color: #556; }
    .cardvariants-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 1.5rem;
        background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem;
        color:#cfd8e3; margin-bottom:1.5rem; }
    .cardvariants-controls .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .cardvariants-controls label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; }
    .cardvariants-controls input[type=text], .cardvariants-controls input[type=number],
    .cardvariants-controls select {
        padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330;
        background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .cardvariants-color-row { display:flex; gap:.5rem; align-items:center; }
    .cardvariants-color-row input[type=color] { padding:0; width:2.75rem; height:2.2rem; flex:0 0 auto; }
    .cardvariants-color-row input[type=text] { flex:1 1 auto; min-width:0; }
    .cardvariants-demo-wrap { display:flex; justify-content:center; padding:2rem; }
    /* Expand grows downward on hover, so reserve room or it shoves the next section. */
    .cardvariants-demo-tall { align-items: flex-start; min-height: 80vmin; }
</style>

@code {
    private string Title = "Beaches";
    private string Subtitle = "Vacation: <em>Relaxation</em>";
    private string BackgroundImageUrl = "_content/Demos.Shared/beach-tree.jpg";
    private string AccentColor = "#186218";
    private string Width = "45vmin";
    private string Height = "55vmin";
    private string BorderWidth = "8px";
    private string BorderColor = "";
    private int DotCount = 3;

    private CardFlipAxis FlipAxis = CardFlipAxis.Y;
    private string Perspective = "1200px";

    private string ExpandedHeight = "75vmin";
    private string BodyHeight = "75%";

    private CardCurlCorner Corner = CardCurlCorner.BottomRight;
    private string CurlSize = "60%";
    private string RestingCurlSize = "2.5rem";
    private string FoldColor = "#e8e8e8";

    private CardSplitAxis SplitAxis = CardSplitAxis.Vertical;
    private string OpenDuration = ".6s";
    private bool ShowSeamCircle = false;
    private string SeamCircleSize = "100px";

    private double TiltDegrees = 12;

    private static string Nz(string s, string fallback) => string.IsNullOrEmpty(s) ? fallback : s;
    private static string? NzNull(string s) => string.IsNullOrEmpty(s) ? null : s;

    private RenderFragment BodyParagraphs => @<text>
        <p>
            Beaches of the world bringing relaxation and rest to the world.
        </p>
        <p>Apart from fun in the sand and sun, the benefits of relaxation are awesome!.</p>
    </text>;

    // Every snippet emits the values actually in effect rather than diffing against duplicated
    // default literals, which is what let an earlier playground's snippet silently desync from
    // what was on screen when a default was edited.
    private string SharedAttrs =>
        $" Title=\"{Title}\"" +
        $" BackgroundImageUrl=\"{BackgroundImageUrl}\"" +
        $" AccentColor=\"{AccentColor}\"" +
        $" Width=\"{Nz(Width, "45vmin")}\"" +
        $" Height=\"{Nz(Height, "55vmin")}\"" +
        $" BorderWidth=\"{Nz(BorderWidth, "8px")}\"" +
        (string.IsNullOrEmpty(BorderColor) ? "" : $" BorderColor=\"{BorderColor}\"") +
$" DotCount=\"{DotCount}\"";

    private string Body => "\n    <Subtitle>" + Subtitle + "</Subtitle>\n    <BodyContent>\n        ...\n    </BodyContent>\n";

    private string FlipSnippet =>
        $"<AtomCardFlip{SharedAttrs} FlipAxis=\"CardFlipAxis.{FlipAxis}\" Perspective=\"{Nz(Perspective, "1200px")}\">"
        + Body + "</AtomCardFlip>";

    private string ExpandSnippet =>
        $"<AtomCardExpand{SharedAttrs} ExpandedHeight=\"{Nz(ExpandedHeight, "75vmin")}\" BodyHeight=\"{Nz(BodyHeight, "75%")}\">"
        + Body + "</AtomCardExpand>";

    private string CurlSnippet =>
        $"<AtomCardCurl{SharedAttrs} Corner=\"CardCurlCorner.{Corner}\" CurlSize=\"{Nz(CurlSize, "60%")}\""
        + $" RestingCurlSize=\"{Nz(RestingCurlSize, "2.5rem")}\" FoldColor=\"{FoldColor}\">"
        + Body + "</AtomCardCurl>";

    private string SplitSnippet =>
        $"<AtomCardSplit{SharedAttrs} SplitAxis=\"CardSplitAxis.{SplitAxis}\""
        + $" OpenDuration=\"{Nz(OpenDuration, ".6s")}\""
        + (ShowSeamCircle ? $" ShowSeamCircle=\"true\" SeamCircleSize=\"{Nz(SeamCircleSize, "100px")}\"" : "")
        + ">" + Body + "</AtomCardSplit>";

    private string TiltSnippet =>
        $"<AtomHoverEffect Effect=\"HoverEffect.Tilt\" TiltDegrees=\"{TiltDegrees}\">\n"
        + $"    <AtomCardCurl{SharedAttrs} />\n"
        + "</AtomHoverEffect>";
}
