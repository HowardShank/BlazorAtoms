@page "/playground/textscramble"
@using BlazorAtoms.Typography

<PageTitle>AtomTextScramble Playground</PageTitle>

<h1>AtomTextScramble playground</h1>
<p>
    A zero-JS one-shot entrance animation for a <em>single word</em> — not a word-list cycler like
    <code>AtomTextCycle</code>. Splits <code>Word</code> into individual characters that fly/drop/
    spin into place with a per-character stagger delay. Plays automatically on mount and whenever
    <code>Word</code> changes; the "Repeat Animation" button below calls the component's public
    <code>Replay()</code> method to force a replay of the same word on demand.
</p>
<p><a href="/">&larr; Back to home</a></p>

<div class="textscramble-preview" style="@PreviewStyle">
    <AtomTextScramble @ref="_scramble"
                        Word="@Word"
                        Effect="@Effect"
                        StaggerDelay="@StaggerDelay"
                        AnimationDuration="@AnimationDuration" />
</div>

<div class="textscramble-controls">
    <div class="ctrl">
        <label>Word</label>
        <input type="text" @bind="Word" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>Effect</label>
        <select @bind="Effect">
            <option value="@TextScrambleEffect.RevolveScale">Revolve + Scale</option>
            <option value="@TextScrambleEffect.BallDrop">Ball Drop</option>
            <option value="@TextScrambleEffect.SideSlide">Side Slide</option>
            <option value="@TextScrambleEffect.RevolveDrop">Revolve Drop</option>
            <option value="@TextScrambleEffect.DropVanish">Drop Vanish</option>
            <option value="@TextScrambleEffect.Twister">Twister</option>
            <option value="@TextScrambleEffect.LeftRight">Left/Right</option>
        </select>
    </div>
    <div class="ctrl">
        <label>Stagger delay (per character)</label>
        <input type="text" @bind="StaggerDelay" @bind:event="oninput" placeholder="0.05s" />
    </div>
    <div class="ctrl">
        <label>Animation duration (per character)</label>
        <input type="text" @bind="AnimationDuration" @bind:event="oninput" placeholder="0.5s" />
    </div>
    <div class="ctrl">
        <label>Font size</label>
        <input type="text" @bind="FontSize" @bind:event="oninput" placeholder="3rem" />
    </div>
    <div class="ctrl ctrl-wide">
        <button class="textscramble-repeat" @onclick="() => _scramble.Replay()">Repeat Animation</button>
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomTextScrambleExample.razor" />

<style>
    .textscramble-preview { display:flex; align-items:center; justify-content:center; min-height:8rem;
        background:#111; color:#fff; font-weight:bold; text-transform:uppercase; border-radius:12px;
        padding:2rem; margin-bottom:1.5rem; }
    .textscramble-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 1.5rem;
        background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem;
        color:#cfd8e3; margin-bottom:1.5rem; }
    .textscramble-controls .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .textscramble-controls .ctrl-wide { grid-column:1 / -1; }
    .textscramble-controls label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; }
    .textscramble-controls input[type=text], .textscramble-controls select {
        padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330;
        background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .textscramble-repeat { padding:.5rem 1rem; border-radius:6px; border:1px solid rgba(255,255,255,.15);
        background:transparent; color:orange; cursor:pointer; }
    .textscramble-repeat:hover { background:rgba(0,0,0,.7); color:#fff; }
</style>

@code {
    private AtomTextScramble _scramble = default!;
    private string Word = "supercalifragilisticexpialidocious";
    private TextScrambleEffect Effect = TextScrambleEffect.RevolveScale;
    private string StaggerDelay = "0.05s";
    private string AnimationDuration = "0.5s";
    private string FontSize = "3rem";

    private string PreviewStyle => $"font-size:{FontSize};";

    private string Snippet
    {
        get
        {
            var attrs = $"Word=\"{Word}\"";
            if (Effect != TextScrambleEffect.RevolveScale) attrs += $" Effect=\"TextScrambleEffect.{Effect}\"";
            if (StaggerDelay != "0.05s") attrs += $" StaggerDelay=\"{StaggerDelay}\"";
            if (AnimationDuration != "0.5s") attrs += $" AnimationDuration=\"{AnimationDuration}\"";
            return $"<AtomTextScramble @@ref=\"_scramble\" {attrs} />\n<button @@onclick=\"() => _scramble.Replay()\">Repeat Animation</button>\n\n@code {{\n    private AtomTextScramble _scramble = default!;\n}}";
        }
    }
}
