@using System.ComponentModel.DataAnnotations
@using System.Globalization
@using Microsoft.AspNetCore.Components.Forms
@using BlazorAtoms.Inputs

<PageTitle>Standard Inputs Playground</PageTitle>

<h1>Standard form fields playground</h1>
<p>The seven standard <code>BlazorAtoms.Inputs</code> fields, all built on the same
   <code>AtomInputBase&lt;TValue&gt;</code>: one <code>@@bind-Value</code> contract, one
   <code>EditContext</code>-aware error state, and three shared styling axes
   (<code>Variant</code> / <code>Size</code> / <code>Effect</code>) plus the <code>--field-*</code>
   custom properties every field's CSS reads. The panel below drives all seven at once — that shared
   surface is the point. Each field's own parameters sit beside it.</p>
<p>They are wrapped in a real <code>&lt;EditForm&gt;</code> with a <code>DataAnnotationsValidator</code>,
   so <em>Validate now</em> produces genuine error states (try it with <code>Effect="ShakeOnError"</code>).</p>
<p><a href="playground/rangeinput">&larr; Range Input playground</a></p>

<div class="ff-controls">
    <div class="ctrl">
        <label>Variant</label>
        <select @bind="VariantSel">
            @foreach (var v in Variants) { <option value="@v">@v</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Size</label>
        <select @bind="SizeSel">
            @foreach (var s in Sizes) { <option value="@s">@s</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Effect</label>
        <select @bind="EffectSel">
            @foreach (var e in Effects) { <option value="@e">@e</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>State</label>
        <div class="row"><input type="checkbox" id="ffDis" @bind="DisabledAll" /><label for="ffDis" class="inline">Disabled</label></div>
        <div class="row"><input type="checkbox" id="ffRo" @bind="ReadOnlyAll" /><label for="ffRo" class="inline">ReadOnly</label></div>
        <div class="row"><input type="checkbox" id="ffVis" @bind="VisibleAll" /><label for="ffVis" class="inline">Visible</label></div>
        <div class="row"><input type="checkbox" id="ffReq" @bind="RequiredAll" /><label for="ffReq" class="inline">Required</label></div>
    </div>
    <div class="ctrl">
        <label>Validation</label>
        <div class="row">
            <button type="button" class="clr-btn" @onclick="ValidateNow">Validate now</button>
            <button type="button" class="clr-btn" @onclick="ClearValidation">Clear</button>
        </div>
        <span class="note">@ValidationNote</span>
    </div>
    <div class="ctrl">
        <label>Help text (all)</label>
        <input type="text" @bind="HelpTextV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Aria label (all)</label>
        <input type="text" @bind="AriaLabelV" @bind:event="oninput" placeholder="(falls back to Label)" />
    </div>
    <div class="ctrl">
        <label>LabelCol</label>
        <input type="text" @bind="LabelColV" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>ControlCol</label>
        <input type="text" @bind="ControlColV" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>CssClass</label>
        <input type="text" @bind="CssClassV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Style</label>
        <input type="text" @bind="StyleV" @bind:event="oninput" placeholder="e.g. margin-bottom:0" />
    </div>
    <div class="ctrl">
        <label>Width (px, 0=auto) <span class="val">@WidthV.ToString(Inv)</span></label>
        <input type="range" min="0" max="600" step="10" @bind="WidthV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>FontSize (px, 0=inherit) <span class="val">@FontSizeV.ToString(Inv)</span></label>
        <input type="range" min="0" max="28" step="1" @bind="FontSizeV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Radius (px, -1=default) <span class="val">@RadiusV.ToString(Inv)</span></label>
        <input type="range" min="-1" max="24" step="1" @bind="RadiusV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>BorderWidth (px, -1=default) <span class="val">@BorderWidthV.ToString(Inv)</span></label>
        <input type="range" min="-1" max="6" step="1" @bind="BorderWidthV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>TextColor</label>
        <div class="row color">
            <input type="color" @bind="TextColorV" @bind:event="oninput" aria-label="Text color picker" />
            <input type="text" @bind="TextColorV" @bind:event="oninput" placeholder="(default)" />
            <button type="button" class="clr-btn" @onclick="() => TextColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>BackgroundColor</label>
        <div class="row color">
            <input type="color" @bind="BgColorV" @bind:event="oninput" aria-label="Background color picker" />
            <input type="text" @bind="BgColorV" @bind:event="oninput" placeholder="(default)" />
            <button type="button" class="clr-btn" @onclick="() => BgColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>BorderColor</label>
        <div class="row color">
            <input type="color" @bind="BorderColorV" @bind:event="oninput" aria-label="Border color picker" />
            <input type="text" @bind="BorderColorV" @bind:event="oninput" placeholder="(default)" />
            <button type="button" class="clr-btn" @onclick="() => BorderColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>AccentColor</label>
        <div class="row color">
            <input type="color" @bind="AccentColorV" @bind:event="oninput" aria-label="Accent color picker" />
            <input type="text" @bind="AccentColorV" @bind:event="oninput" placeholder="(default)" />
            <button type="button" class="clr-btn" @onclick="() => AccentColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>FocusColor</label>
        <div class="row color">
            <input type="color" @bind="FocusColorV" @bind:event="oninput" aria-label="Focus color picker" />
            <input type="text" @bind="FocusColorV" @bind:event="oninput" placeholder="(= AccentColor)" />
            <button type="button" class="clr-btn" @onclick="() => FocusColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>ErrorColor</label>
        <div class="row color">
            <input type="color" @bind="ErrorColorV" @bind:event="oninput" aria-label="Error color picker" />
            <input type="text" @bind="ErrorColorV" @bind:event="oninput" placeholder="(default)" />
            <button type="button" class="clr-btn" @onclick="() => ErrorColorV = string.Empty">Clear</button>
        </div>
    </div>
</div>

<EditForm EditContext="_editContext" class="ff-stage">
    <DataAnnotationsValidator />

    @* ---- AtomTextField ---------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomTextField</h2>
        <div class="ff-preview">
            <AtomTextField @bind-Value="_model.Name"
                           Label="Name"
                           Type="@TypeSel"
                           Placeholder="@Nz(TfPlaceholder)"
                           MaxLength="@Opt(TfMaxLength)"
                           Autocomplete="@Nz(TfAutocomplete)"
                           InputMode="@Nz(TfInputMode)"
                           Spellcheck="@TriState(TfSpellcheck)"
                           UpdateOn="@TfUpdateOn"
                           Clearable="@TfClearable"
                           PrefixContent="@(TfPrefix ? PersonIcon : null)"
                           SuffixContent="@(TfSuffix ? RenderText("chars") : null)"
                           HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                           LabelCol="@LabelColV" ControlCol="@ControlColV"
                           Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                           Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                           Width="@Opt(WidthV)" FontSize="@Opt(FontSizeV)" Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                           TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                           AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                           CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>Type</label>
                <select @bind="TypeSel">
                    @foreach (var t in FieldTypes) { <option value="@t">@t</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>UpdateOn</label>
                <select @bind="TfUpdateOn">
                    @foreach (var u in UpdateOns) { <option value="@u">@u</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Placeholder</label>
                <input type="text" @bind="TfPlaceholder" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>MaxLength (0=none) <span class="val">@TfMaxLength</span></label>
                <input type="range" min="0" max="60" step="1" @bind="TfMaxLength" @bind:event="oninput" />
            </div>
            <div class="ctrl">
                <label>Autocomplete</label>
                <input type="text" @bind="TfAutocomplete" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>InputMode</label>
                <input type="text" @bind="TfInputMode" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>Spellcheck</label>
                <select @bind="TfSpellcheck">
                    @foreach (var t in TriStates) { <option value="@t">@t</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Slots</label>
                <div class="row"><input type="checkbox" id="ffTfClr" @bind="TfClearable" /><label for="ffTfClr" class="inline">Clearable</label></div>
                <div class="row"><input type="checkbox" id="ffTfPre" @bind="TfPrefix" /><label for="ffTfPre" class="inline">PrefixContent</label></div>
                <div class="row"><input type="checkbox" id="ffTfSuf" @bind="TfSuffix" /><label for="ffTfSuf" class="inline">SuffixContent</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomTextArea ----------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomTextArea</h2>
        <div class="ff-preview">
            <AtomTextArea @bind-Value="_model.Notes"
                          Label="Notes"
                          Placeholder="@Nz(TaPlaceholder)"
                          Rows="@TaRows"
                          Height="@Opt(TaHeight)"
                          MaxLength="@Opt(TaMaxLength)"
                          Resize="@TaResize"
                          Spellcheck="@TriState(TaSpellcheck)"
                          UpdateOn="@TaUpdateOn"
                          ShowCounter="@TaShowCounter"
                          CounterWarnAt="@TaWarnAt"
                          HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                          LabelCol="@LabelColV" ControlCol="@ControlColV"
                          Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                          Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                          Width="@Opt(WidthV)" FontSize="@Opt(FontSizeV)" Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                          TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                          AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                          CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>Resize</label>
                <select @bind="TaResize">
                    @foreach (var r in Resizes) { <option value="@r">@r</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>UpdateOn</label>
                <select @bind="TaUpdateOn">
                    @foreach (var u in UpdateOns) { <option value="@u">@u</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Placeholder</label>
                <input type="text" @bind="TaPlaceholder" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>Rows <span class="val">@TaRows</span></label>
                <input type="range" min="1" max="12" step="1" @bind="TaRows" @bind:event="oninput" />
            </div>
            <div class="ctrl">
                <label>Height (px, 0=Rows) <span class="val">@TaHeight.ToString(Inv)</span></label>
                <input type="range" min="0" max="300" step="10" @bind="TaHeight" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>MaxLength (0=none) <span class="val">@TaMaxLength</span></label>
                <input type="range" min="0" max="400" step="10" @bind="TaMaxLength" @bind:event="oninput" />
            </div>
            <div class="ctrl">
                <label>Spellcheck</label>
                <select @bind="TaSpellcheck">
                    @foreach (var t in TriStates) { <option value="@t">@t</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Counter</label>
                <div class="row"><input type="checkbox" id="ffTaCnt" @bind="TaShowCounter" /><label for="ffTaCnt" class="inline">ShowCounter</label></div>
            </div>
            <div class="ctrl">
                <label>CounterWarnAt <span class="val">@TaWarnAt.ToString(Inv)</span></label>
                <input type="range" min="0.1" max="1" step="0.05" @bind="TaWarnAt" @bind:event="oninput" @bind:culture="Inv" />
            </div>
        </div>
    </section>

    @* ---- AtomNumberField -------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomNumberField&lt;int&gt;</h2>
        <div class="ff-preview">
            <AtomNumberField TValue="int" @bind-Value="_model.Quantity"
                             Label="Quantity"
                             Min="@(NfUseMin ? NfMin : null)"
                             Max="@(NfUseMax ? NfMax : null)"
                             Step="@(NfUseStep ? NfStep : null)"
                             Placeholder="@Nz(NfPlaceholder)"
                             ShowSpinners="@NfSpinners"
                             PrefixText="@Nz(NfPrefix)"
                             SuffixText="@Nz(NfSuffix)"
                             UpdateOn="@NfUpdateOn"
                             HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                             LabelCol="@LabelColV" ControlCol="@ControlColV"
                             Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                             Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                             Width="@Opt(WidthV)" FontSize="@Opt(FontSizeV)" Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                             TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                             AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                             CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>Min</label>
                <div class="row"><input type="checkbox" id="ffNfMin" @bind="NfUseMin" /><input type="number" @bind="NfMin" @bind:event="oninput" @bind:culture="Inv" disabled="@(!NfUseMin)" /></div>
            </div>
            <div class="ctrl">
                <label>Max</label>
                <div class="row"><input type="checkbox" id="ffNfMax" @bind="NfUseMax" /><input type="number" @bind="NfMax" @bind:event="oninput" @bind:culture="Inv" disabled="@(!NfUseMax)" /></div>
            </div>
            <div class="ctrl">
                <label>Step</label>
                <div class="row"><input type="checkbox" id="ffNfStep" @bind="NfUseStep" /><input type="number" @bind="NfStep" @bind:event="oninput" @bind:culture="Inv" disabled="@(!NfUseStep)" /></div>
            </div>
            <div class="ctrl">
                <label>UpdateOn</label>
                <select @bind="NfUpdateOn">
                    @foreach (var u in UpdateOns) { <option value="@u">@u</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Placeholder</label>
                <input type="text" @bind="NfPlaceholder" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>PrefixText</label>
                <input type="text" @bind="NfPrefix" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>SuffixText</label>
                <input type="text" @bind="NfSuffix" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>Spinners</label>
                <div class="row"><input type="checkbox" id="ffNfSpin" @bind="NfSpinners" /><label for="ffNfSpin" class="inline">ShowSpinners</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomCheckbox ----------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomCheckbox</h2>
        <div class="ff-preview">
            <AtomCheckbox @bind-Value="_model.Accepted"
                          Label="Terms"
                          Text="@Nz(CbText)"
                          Indeterminate="@CbIndeterminate"
                          BoxShape="@CbShape"
                          TextPlacement="@CbPlacement"
                          BoxSize="@Opt(CbBoxSize)"
                          HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                          LabelCol="@LabelColV" ControlCol="@ControlColV"
                          Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                          Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                          FontSize="@Opt(FontSizeV)" Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                          TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                          AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                          CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>BoxShape</label>
                <select @bind="CbShape">
                    @foreach (var s in CheckShapes) { <option value="@s">@s</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>TextPlacement</label>
                <select @bind="CbPlacement">
                    @foreach (var p in Placements) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Text</label>
                <input type="text" @bind="CbText" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>BoxSize (px, 0=Size) <span class="val">@CbBoxSize.ToString(Inv)</span></label>
                <input type="range" min="0" max="40" step="1" @bind="CbBoxSize" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>Mixed state</label>
                <div class="row"><input type="checkbox" id="ffCbInd" @bind="CbIndeterminate" /><label for="ffCbInd" class="inline">Indeterminate</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomSwitch ------------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomSwitch</h2>
        <div class="ff-preview">
            <AtomSwitch @bind-Value="_model.Notify"
                        Label="Notifications"
                        Text="@Nz(SwText)"
                        OnText="@Nz(SwOnText)"
                        OffText="@Nz(SwOffText)"
                        ThumbContent="@(SwThumb ? CheckIcon : null)"
                        TrackWidth="@Opt(SwTrackWidth)"
                        TrackHeight="@Opt(SwTrackHeight)"
                        TextPlacement="@SwPlacement"
                        HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                        LabelCol="@LabelColV" ControlCol="@ControlColV"
                        Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                        Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                        FontSize="@Opt(FontSizeV)" BorderWidth="@Signed(BorderWidthV)"
                        TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                        AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                        CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>TextPlacement</label>
                <select @bind="SwPlacement">
                    @foreach (var p in Placements) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Text</label>
                <input type="text" @bind="SwText" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>OnText</label>
                <input type="text" @bind="SwOnText" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>OffText</label>
                <input type="text" @bind="SwOffText" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>TrackWidth (px, 0=Size) <span class="val">@SwTrackWidth.ToString(Inv)</span></label>
                <input type="range" min="0" max="90" step="2" @bind="SwTrackWidth" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>TrackHeight (px, 0=Size) <span class="val">@SwTrackHeight.ToString(Inv)</span></label>
                <input type="range" min="0" max="48" step="2" @bind="SwTrackHeight" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>Thumb</label>
                <div class="row"><input type="checkbox" id="ffSwThumb" @bind="SwThumb" /><label for="ffSwThumb" class="inline">ThumbContent icon</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomRadioGroup --------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomRadioGroup&lt;string&gt;</h2>
        <div class="ff-preview">
            <AtomRadioGroup TValue="string" @bind-Value="_model.Color"
                            Label="Color"
                            Options="@RadioOptions"
                            OptionLabel="@(RgUseLabel ? ColorLabel : null)"
                            OptionTemplate="@(RgUseTemplate ? RadioTemplate : null)"
                            OptionDisabled="@(RgDisableSecond ? IsGreen : null)"
                            Name="@Nz(RgName)"
                            Orientation="@RgOrientation"
                            TextPlacement="@RgPlacement"
                            MarkSize="@Opt(RgMarkSize)"
                            HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                            LabelCol="@LabelColV" ControlCol="@ControlColV"
                            Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                            Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                            FontSize="@Opt(FontSizeV)" BorderWidth="@Signed(BorderWidthV)"
                            TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                            AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                            CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>Orientation</label>
                <select @bind="RgOrientation">
                    @foreach (var o in Orientations) { <option value="@o">@o</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>TextPlacement</label>
                <select @bind="RgPlacement">
                    @foreach (var p in Placements) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Options (comma separated)</label>
                <input type="text" @bind="RgOptionsRaw" @bind:event="oninput" />
            </div>
            <div class="ctrl">
                <label>Name (blank=generated)</label>
                <input type="text" @bind="RgName" @bind:event="oninput" placeholder="(generated)" />
            </div>
            <div class="ctrl">
                <label>MarkSize (px, 0=Size) <span class="val">@RgMarkSize.ToString(Inv)</span></label>
                <input type="range" min="0" max="40" step="1" @bind="RgMarkSize" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>Option rendering</label>
                <div class="row"><input type="checkbox" id="ffRgLbl" @bind="RgUseLabel" /><label for="ffRgLbl" class="inline">OptionLabel</label></div>
                <div class="row"><input type="checkbox" id="ffRgTpl" @bind="RgUseTemplate" /><label for="ffRgTpl" class="inline">OptionTemplate</label></div>
                <div class="row"><input type="checkbox" id="ffRgDis" @bind="RgDisableSecond" /><label for="ffRgDis" class="inline">OptionDisabled (2nd)</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomSelect ------------------------------------------------------------------------- *@
    <section class="ff-field">
        <h2>AtomSelect&lt;string&gt;</h2>
        <div class="ff-preview">
            <AtomSelect TValue="string" @bind-Value="_model.Tier"
                        Label="Tier"
                        Options="@Tiers"
                        OptionLabel="@(SelUseLabel ? TierLabel : null)"
                        OptionDisabled="@(SelDisableLast ? IsTeam : null)"
                        Placeholder="@Nz(SelPlaceholder)"
                        PlaceholderSelectable="@SelPlaceholderSelectable"
                        HelpText="@Nz(HelpTextV)" AriaLabel="@Nz(AriaLabelV)"
                        LabelCol="@LabelColV" ControlCol="@ControlColV"
                        Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                        Disabled="@DisabledAll" ReadOnly="@ReadOnlyAll" Visible="@VisibleAll" Required="@RequiredAll"
                        Width="@Opt(WidthV)" FontSize="@Opt(FontSizeV)" Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                        TextColor="@Nz(TextColorV)" BackgroundColor="@Nz(BgColorV)" BorderColor="@Nz(BorderColorV)"
                        AccentColor="@Nz(AccentColorV)" FocusColor="@Nz(FocusColorV)" ErrorColor="@Nz(ErrorColorV)"
                        CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)">
                @if (SelExtraOption)
                {
                    <option value="Enterprise">Enterprise (raw ChildContent option)</option>
                }
            </AtomSelect>
        </div>
        <div class="ff-opts">
            <div class="ctrl">
                <label>Placeholder</label>
                <input type="text" @bind="SelPlaceholder" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>Options</label>
                <div class="row"><input type="checkbox" id="ffSelSelectable" @bind="SelPlaceholderSelectable" /><label for="ffSelSelectable" class="inline">PlaceholderSelectable</label></div>
                <div class="row"><input type="checkbox" id="ffSelLbl" @bind="SelUseLabel" /><label for="ffSelLbl" class="inline">OptionLabel</label></div>
                <div class="row"><input type="checkbox" id="ffSelDis" @bind="SelDisableLast" /><label for="ffSelDis" class="inline">OptionDisabled (Team)</label></div>
                <div class="row"><input type="checkbox" id="ffSelExtra" @bind="SelExtraOption" /><label for="ffSelExtra" class="inline">ChildContent option</label></div>
            </div>
        </div>
    </section>
</EditForm>

