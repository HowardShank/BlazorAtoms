@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private static readonly InputVariant[] Variants = Enum.GetValues<InputVariant>();
    private static readonly InputSize[] Sizes = Enum.GetValues<InputSize>();
    private static readonly InputEffect[] Effects = Enum.GetValues<InputEffect>();
    private static readonly TextFieldType[] FieldTypes = Enum.GetValues<TextFieldType>();
    private static readonly TextAreaResize[] Resizes = Enum.GetValues<TextAreaResize>();
    private static readonly InputUpdateOn[] UpdateOns = Enum.GetValues<InputUpdateOn>();
    private static readonly CheckShape[] CheckShapes = Enum.GetValues<CheckShape>();
    private static readonly LabelPlacement[] Placements = Enum.GetValues<LabelPlacement>();
    private static readonly Orientation[] Orientations = Enum.GetValues<Orientation>();
    private static readonly string[] TriStates = ["(unset)", "true", "false"];
    private static readonly string[] Tiers = ["Free", "Pro", "Team"];

    // The bound model. Attributes are real DataAnnotations, so "Validate now" produces genuine
    // messages through each field's own EditContext wiring rather than a faked error state.
    private sealed class DemoModel
    {
        [Required(ErrorMessage = "Name is required")]
        [StringLength(20, MinimumLength = 3, ErrorMessage = "Name must be 3-20 characters")]
        public string? Name { get; set; } = "Ada Lovelace";

        [StringLength(120, ErrorMessage = "Notes cap out at 120 characters")]
        public string? Notes { get; set; } = "Zero JS: every field is a native control in a themed frame.";

        [Range(1, 99, ErrorMessage = "Quantity must be 1-99")]
        public int Quantity { get; set; } = 3;

        [Range(typeof(bool), "true", "true", ErrorMessage = "You must accept the terms")]
        public bool Accepted { get; set; }

        public bool Notify { get; set; } = true;

        [Required(ErrorMessage = "Pick a color")]
        public string? Color { get; set; } = "Green";

        [Required(ErrorMessage = "Pick a tier")]
        public string? Tier { get; set; }
    }

    private readonly DemoModel _model = new();
    private EditContext _editContext = default!;
    private string ValidationNote = "not validated yet";

    protected override void OnInitialized() => _editContext = new EditContext(_model);

    private void ValidateNow()
    {
        var ok = _editContext.Validate();
        ValidationNote = ok ? "all valid" : "showing real errors";
    }

    private void ClearValidation()
    {
        // Validate() leaves messages in the context's own store, which has no public clear; a fresh
        // EditContext is the documented way back to a pristine state.
        _editContext = new EditContext(_model);
        ValidationNote = "cleared";
    }

    // ---- shared axes -------------------------------------------------------------------------

    private InputVariant VariantSel = InputVariant.Outline;
    private InputSize SizeSel = InputSize.Medium;
    private InputEffect EffectSel = InputEffect.None;
    private bool DisabledAll;
    private bool ReadOnlyAll;
    private bool VisibleAll = true;
    private bool RequiredAll;
    private string HelpTextV = "";
    private string AriaLabelV = "";
    private string LabelColV = "clr-col-12 clr-col-md-3";
    private string ControlColV = "clr-col-12 clr-col-md-9";
    private string CssClassV = "";
    private string StyleV = "";
    private double WidthV;
    private double FontSizeV;
    private double RadiusV = -1;
    private double BorderWidthV = -1;
    private string TextColorV = "";
    private string BgColorV = "";
    private string BorderColorV = "";
    private string AccentColorV = "";
    private string FocusColorV = "";
    private string ErrorColorV = "";

    // ---- per-field state ---------------------------------------------------------------------

    private TextFieldType TypeSel = TextFieldType.Text;
    private string TfPlaceholder = "First and last name";
    private int TfMaxLength = 20;
    private string TfAutocomplete = "name";
    private string TfInputMode = "";
    private string TfSpellcheck = "(unset)";
    private InputUpdateOn TfUpdateOn = InputUpdateOn.Input;
    private bool TfClearable = true;
    private bool TfPrefix;
    private bool TfSuffix;

    private string TaPlaceholder = "Anything worth noting…";
    private int TaRows = 4;
    private double TaHeight;
    private int TaMaxLength = 120;
    private TextAreaResize TaResize = TextAreaResize.Vertical;
    private string TaSpellcheck = "(unset)";
    private InputUpdateOn TaUpdateOn = InputUpdateOn.Input;
    private bool TaShowCounter = true;
    private double TaWarnAt = 0.9;

    private bool NfUseMin = true;
    private double NfMin = 1;
    private bool NfUseMax = true;
    private double NfMax = 99;
    private bool NfUseStep = true;
    private double NfStep = 1;
    private string NfPlaceholder = "";
    private bool NfSpinners = true;
    private string NfPrefix = "";
    private string NfSuffix = "units";
    private InputUpdateOn NfUpdateOn = InputUpdateOn.Input;

    private string CbText = "I accept the terms";
    private bool CbIndeterminate;
    private CheckShape CbShape = CheckShape.Rounded;
    private LabelPlacement CbPlacement = LabelPlacement.End;
    private double CbBoxSize;

    private string SwText = "Email me about releases";
    private string SwOnText = "";
    private string SwOffText = "";
    private bool SwThumb;
    private double SwTrackWidth;
    private double SwTrackHeight;
    private LabelPlacement SwPlacement = LabelPlacement.End;

    private string RgOptionsRaw = "Red,Green,Blue";
    private bool RgUseLabel;
    private bool RgUseTemplate;
    private bool RgDisableSecond;
    private string RgName = "";
    private Orientation RgOrientation = Orientation.Vertical;
    private LabelPlacement RgPlacement = LabelPlacement.End;
    private double RgMarkSize;

    private string SelPlaceholder = "Choose a tier…";
    private bool SelPlaceholderSelectable;
    private bool SelUseLabel;
    private bool SelDisableLast;
    private bool SelExtraOption;

    // ---- derived -----------------------------------------------------------------------------

    private string[] RadioOptions =>
        RgOptionsRaw.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    // Declared as fields, not methods: a `cond ? MethodGroup : null` ternary has no natural type,
    // so the delegate has to already exist to be passed conditionally.
    private static readonly Func<string, string> ColorLabel = option => $"Color: {option}";

    private static readonly Func<string, bool> IsGreen = option => option == "Green";

    private static readonly Func<string, string> TierLabel = tier => tier switch
    {
        "Free" => "Free — $0",
        "Pro" => "Pro — $12/mo",
        _ => $"{tier} — talk to us",
    };

    private static readonly Func<string, bool> IsTeam = tier => tier == "Team";

    private RenderFragment<string> RadioTemplate => option => builder =>
        builder.AddMarkupContent(0,
            $"<span style=\"display:inline-flex;align-items:center;gap:.4rem\">" +
            $"<span style=\"width:.8em;height:.8em;border-radius:50%;background:{option.ToLowerInvariant()}\"></span>" +
            $"<b>{option}</b></span>");

    private static readonly RenderFragment PersonIcon = b => b.AddMarkupContent(0,
        "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\" aria-hidden=\"true\">" +
        "<path d=\"M12 12a5 5 0 1 0 0-10 5 5 0 0 0 0 10zm0 2c-4 0-8 2-8 5v1h16v-1c0-3-4-5-8-5z\"/></svg>");

    private static readonly RenderFragment CheckIcon = b => b.AddMarkupContent(0,
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"3\" " +
        "stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12.5l4.5 4.5L19 7.5\"/></svg>");

    private static RenderFragment RenderText(string text) => b => b.AddContent(0, text);

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    /// <summary>0 means "leave the parameter unset" for sliders whose zero has no useful meaning.</summary>
    private static double? Opt(double v) => v > 0 ? v : null;

    private static int? Opt(int v) => v > 0 ? v : null;

    /// <summary>For sliders where 0 IS meaningful (Radius, BorderWidth), -1 is the unset sentinel.</summary>
    private static double? Signed(double v) => v >= 0 ? v : null;

    private static bool? TriState(string s) => s switch { "true" => true, "false" => false, _ => null };

    private static string Quoted(string? s) => s is null ? "null" : $"\"{s}\"";

    // ---- generated snippet -------------------------------------------------------------------

    /// <summary>Shared attributes, emitted once per field so the snippet mirrors what the previews
    /// above are actually rendering. Only non-default values are written, so the snippet stays as
    /// short as the current configuration allows.</summary>
    private string SharedAttrs(string indent, bool sizing = true)
    {
        var sb = new System.Text.StringBuilder();
        void Add(string a) => sb.Append('\n').Append(indent).Append(a);

        if (!string.IsNullOrEmpty(HelpTextV)) Add($"HelpText=\"{HelpTextV}\"");
        if (!string.IsNullOrEmpty(AriaLabelV)) Add($"AriaLabel=\"{AriaLabelV}\"");
        if (LabelColV != "clr-col-12 clr-col-md-2") Add($"LabelCol=\"{LabelColV}\"");
        if (ControlColV != "clr-col-12 clr-col-md-10") Add($"ControlCol=\"{ControlColV}\"");
        if (VariantSel != InputVariant.Outline) Add($"Variant=\"InputVariant.{VariantSel}\"");
        if (SizeSel != InputSize.Medium) Add($"Size=\"InputSize.{SizeSel}\"");
        if (EffectSel != InputEffect.None) Add($"Effect=\"InputEffect.{EffectSel}\"");
        if (DisabledAll) Add("Disabled=\"true\"");
        if (ReadOnlyAll) Add("ReadOnly=\"true\"");
        if (!VisibleAll) Add("Visible=\"false\"");
        if (RequiredAll) Add("Required=\"true\"");
        if (sizing && WidthV > 0) Add($"Width=\"{WidthV.ToString(Inv)}\"");
        if (FontSizeV > 0) Add($"FontSize=\"{FontSizeV.ToString(Inv)}\"");
        if (sizing && RadiusV >= 0) Add($"Radius=\"{RadiusV.ToString(Inv)}\"");
        if (BorderWidthV >= 0) Add($"BorderWidth=\"{BorderWidthV.ToString(Inv)}\"");
        if (!string.IsNullOrEmpty(TextColorV)) Add($"TextColor=\"{TextColorV}\"");
        if (!string.IsNullOrEmpty(BgColorV)) Add($"BackgroundColor=\"{BgColorV}\"");
        if (!string.IsNullOrEmpty(BorderColorV)) Add($"BorderColor=\"{BorderColorV}\"");
        if (!string.IsNullOrEmpty(AccentColorV)) Add($"AccentColor=\"{AccentColorV}\"");
        if (!string.IsNullOrEmpty(FocusColorV)) Add($"FocusColor=\"{FocusColorV}\"");
        if (!string.IsNullOrEmpty(ErrorColorV)) Add($"ErrorColor=\"{ErrorColorV}\"");
        if (!string.IsNullOrEmpty(CssClassV)) Add($"CssClass=\"{CssClassV}\"");
        if (!string.IsNullOrEmpty(StyleV)) Add($"Style=\"{StyleV}\"");
        return sb.ToString();
    }

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            sb.Append("<EditForm Model=\"_model\" OnValidSubmit=\"SaveAsync\">\n");
            sb.Append("    <DataAnnotationsValidator />\n\n");

            // AtomTextField
            sb.Append("    <AtomTextField @bind-Value=\"_model.Name\" Label=\"Name\"");
            var i = "                   ";
            if (TypeSel != TextFieldType.Text) sb.Append($"\n{i}Type=\"TextFieldType.{TypeSel}\"");
            if (!string.IsNullOrEmpty(TfPlaceholder)) sb.Append($"\n{i}Placeholder=\"{TfPlaceholder}\"");
            if (TfMaxLength > 0) sb.Append($"\n{i}MaxLength=\"{TfMaxLength}\"");
            if (!string.IsNullOrEmpty(TfAutocomplete)) sb.Append($"\n{i}Autocomplete=\"{TfAutocomplete}\"");
            if (!string.IsNullOrEmpty(TfInputMode)) sb.Append($"\n{i}InputMode=\"{TfInputMode}\"");
            if (TriState(TfSpellcheck) is bool sc) sb.Append($"\n{i}Spellcheck=\"{sc.ToString().ToLowerInvariant()}\"");
            if (TfUpdateOn != InputUpdateOn.Input) sb.Append($"\n{i}UpdateOn=\"InputUpdateOn.{TfUpdateOn}\"");
            if (TfClearable) sb.Append($"\n{i}Clearable=\"true\"");
            sb.Append(SharedAttrs(i));
            if (TfPrefix || TfSuffix)
            {
                sb.Append(">\n");
                if (TfPrefix) sb.Append("        <PrefixContent><svg class=\"icon\" …/></PrefixContent>\n");
                if (TfSuffix) sb.Append("        <SuffixContent>chars</SuffixContent>\n");
                sb.Append("    </AtomTextField>\n\n");
            }
            else
            {
                sb.Append(" />\n\n");
            }

            // AtomTextArea
            sb.Append("    <AtomTextArea @bind-Value=\"_model.Notes\" Label=\"Notes\"");
            i = "                  ";
            if (!string.IsNullOrEmpty(TaPlaceholder)) sb.Append($"\n{i}Placeholder=\"{TaPlaceholder}\"");
            if (TaRows != 4) sb.Append($"\n{i}Rows=\"{TaRows}\"");
            if (TaHeight > 0) sb.Append($"\n{i}Height=\"{TaHeight.ToString(Inv)}\"");
            if (TaMaxLength > 0) sb.Append($"\n{i}MaxLength=\"{TaMaxLength}\"");
            if (TaResize != TextAreaResize.Vertical) sb.Append($"\n{i}Resize=\"TextAreaResize.{TaResize}\"");
            if (TriState(TaSpellcheck) is bool tsc) sb.Append($"\n{i}Spellcheck=\"{tsc.ToString().ToLowerInvariant()}\"");
            if (TaUpdateOn != InputUpdateOn.Input) sb.Append($"\n{i}UpdateOn=\"InputUpdateOn.{TaUpdateOn}\"");
            if (TaShowCounter) sb.Append($"\n{i}ShowCounter=\"true\"");
            if (Math.Abs(TaWarnAt - 0.9) > 0.001) sb.Append($"\n{i}CounterWarnAt=\"{TaWarnAt.ToString(Inv)}\"");
            sb.Append(SharedAttrs(i));
            sb.Append(" />\n\n");

            // AtomNumberField
            sb.Append("    <AtomNumberField TValue=\"int\" @bind-Value=\"_model.Quantity\" Label=\"Quantity\"");
            i = "                     ";
            if (NfUseMin) sb.Append($"\n{i}Min=\"{NfMin.ToString(Inv)}\"");
            if (NfUseMax) sb.Append($"\n{i}Max=\"{NfMax.ToString(Inv)}\"");
            if (NfUseStep) sb.Append($"\n{i}Step=\"{NfStep.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(NfPlaceholder)) sb.Append($"\n{i}Placeholder=\"{NfPlaceholder}\"");
            if (!NfSpinners) sb.Append($"\n{i}ShowSpinners=\"false\"");
            if (!string.IsNullOrEmpty(NfPrefix)) sb.Append($"\n{i}PrefixText=\"{NfPrefix}\"");
            if (!string.IsNullOrEmpty(NfSuffix)) sb.Append($"\n{i}SuffixText=\"{NfSuffix}\"");
            if (NfUpdateOn != InputUpdateOn.Input) sb.Append($"\n{i}UpdateOn=\"InputUpdateOn.{NfUpdateOn}\"");
            sb.Append(SharedAttrs(i));
            sb.Append(" />\n\n");

            // AtomCheckbox
            sb.Append("    <AtomCheckbox @bind-Value=\"_model.Accepted\" Label=\"Terms\"");
            i = "                  ";
            if (!string.IsNullOrEmpty(CbText)) sb.Append($"\n{i}Text=\"{CbText}\"");
            if (CbIndeterminate) sb.Append($"\n{i}Indeterminate=\"true\"");
            if (CbShape != CheckShape.Rounded) sb.Append($"\n{i}BoxShape=\"CheckShape.{CbShape}\"");
            if (CbPlacement != LabelPlacement.End) sb.Append($"\n{i}TextPlacement=\"LabelPlacement.{CbPlacement}\"");
            if (CbBoxSize > 0) sb.Append($"\n{i}BoxSize=\"{CbBoxSize.ToString(Inv)}\"");
            sb.Append(SharedAttrs(i, sizing: false));
            sb.Append(" />\n\n");

            // AtomSwitch
            sb.Append("    <AtomSwitch @bind-Value=\"_model.Notify\" Label=\"Notifications\"");
            i = "                ";
            if (!string.IsNullOrEmpty(SwText)) sb.Append($"\n{i}Text=\"{SwText}\"");
            if (!string.IsNullOrEmpty(SwOnText)) sb.Append($"\n{i}OnText=\"{SwOnText}\"");
            if (!string.IsNullOrEmpty(SwOffText)) sb.Append($"\n{i}OffText=\"{SwOffText}\"");
            if (SwTrackWidth > 0) sb.Append($"\n{i}TrackWidth=\"{SwTrackWidth.ToString(Inv)}\"");
            if (SwTrackHeight > 0) sb.Append($"\n{i}TrackHeight=\"{SwTrackHeight.ToString(Inv)}\"");
            if (SwPlacement != LabelPlacement.End) sb.Append($"\n{i}TextPlacement=\"LabelPlacement.{SwPlacement}\"");
            sb.Append(SharedAttrs(i, sizing: false));
            if (SwThumb)
            {
                sb.Append(">\n        <ThumbContent><svg class=\"icon\" …/></ThumbContent>\n    </AtomSwitch>\n\n");
            }
            else
            {
                sb.Append(" />\n\n");
            }

            // AtomRadioGroup
            sb.Append("    <AtomRadioGroup TValue=\"string\" @bind-Value=\"_model.Color\" Label=\"Color\"");
            i = "                    ";
            sb.Append($"\n{i}Options=\"_colors\"");
            // Named methods rather than inline lambdas: a lambda containing quotes cannot be written
            // inside a Razor attribute without escaping gymnastics, so the snippet stays copy-pastable.
            if (RgUseLabel) sb.Append($"\n{i}OptionLabel=\"ColorLabel\"");
            if (RgDisableSecond) sb.Append($"\n{i}OptionDisabled=\"IsGreen\"");
            if (!string.IsNullOrEmpty(RgName)) sb.Append($"\n{i}Name=\"{RgName}\"");
            if (RgOrientation != Orientation.Vertical) sb.Append($"\n{i}Orientation=\"Orientation.{RgOrientation}\"");
            if (RgPlacement != LabelPlacement.End) sb.Append($"\n{i}TextPlacement=\"LabelPlacement.{RgPlacement}\"");
            if (RgMarkSize > 0) sb.Append($"\n{i}MarkSize=\"{RgMarkSize.ToString(Inv)}\"");
            sb.Append(SharedAttrs(i, sizing: false));
            if (RgUseTemplate)
            {
                sb.Append(">\n        <OptionTemplate Context=\"color\">\n");
                sb.Append("            <b>@color</b>\n");
                sb.Append("        </OptionTemplate>\n    </AtomRadioGroup>\n\n");
            }
            else
            {
                sb.Append(" />\n\n");
            }

            // AtomSelect
            sb.Append("    <AtomSelect TValue=\"string\" @bind-Value=\"_model.Tier\" Label=\"Tier\"");
            i = "                ";
            sb.Append($"\n{i}Options=\"_tiers\"");
            if (SelUseLabel) sb.Append($"\n{i}OptionLabel=\"TierLabel\"");
            if (SelDisableLast) sb.Append($"\n{i}OptionDisabled=\"IsTeam\"");
            if (!string.IsNullOrEmpty(SelPlaceholder)) sb.Append($"\n{i}Placeholder=\"{SelPlaceholder}\"");
            if (SelPlaceholderSelectable) sb.Append($"\n{i}PlaceholderSelectable=\"true\"");
            sb.Append(SharedAttrs(i));
            if (SelExtraOption)
            {
                sb.Append(">\n        <option value=\"Enterprise\">Enterprise</option>\n    </AtomSelect>\n");
            }
            else
            {
                sb.Append(" />\n");
            }

            sb.Append("</EditForm>");
            return sb.ToString();
        }
    }
