@using BlazorAtoms.Charts

<PageTitle>Gauges Playground</PageTitle>

<h1>Gauges playground</h1>
<p>
    A single value on a dial (<code>AtomGauge</code>), a straight track (<code>AtomBarGauge</code>) or a
    row of dots (<code>AtomDotGauge</code>) &mdash; three shapes sharing one <code>AtomGaugeBase</code>:
    <code>Value</code>/<code>Min</code>/<code>Max</code>, a <code>SegmentCount</code> that auto-generates
    red&rarr;green bands, and an <code>Elevation</code> that ships a floating drop-shadow look by default.
</p>
<p class="note">
    <code>SegmentCount</code> sweeps hue in HSL space rather than lerping RGB, so the middle of the scale
    lands on orange/yellow instead of a muddy olive &mdash; set <em>Start / end color</em> to anything and
    the sweep still runs between them.
</p>
<p><a href="playground/charts">&larr; Charts playground</a></p>

<div class="ch-stage">
    <div class="ch-pane">
        <h2>Value</h2>
        <div class="ch-ctrl">
            <label>Value <span class="val">@GaugeValue</span></label>
            <input type="range" min="-20" max="120" step="1" @bind="GaugeValue" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label>Min / Max</label>
            <input type="number" class="ch-narrow" @bind="GaugeMin" @bind:event="oninput" />
            <input type="number" class="ch-narrow" @bind="GaugeMax" @bind:event="oninput" />
        </div>

        <h2>Segments &amp; elevation <span class="val">(all three shapes)</span></h2>
        <div class="ch-ctrl">
            <label>Segment count <span class="val">@(SegmentCount?.ToString() ?? "auto")</span></label>
            <input type="range" min="2" max="10" step="1" value="@(SegmentCount ?? 5)"
                   @oninput="@(e => SegmentCount = int.Parse(e.Value?.ToString() ?? "5"))" />
            <button class="clr-btn" type="button" @onclick="@(() => SegmentCount = null)">off</button>
        </div>
        <div class="ch-ctrl">
            <label>Start / end color</label>
            <input type="text" placeholder="(red)" class="ch-narrow" @bind="StartColor" @bind:event="oninput" />
            <input type="text" placeholder="(green)" class="ch-narrow" @bind="EndColor" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="ReverseColors" /> Reverse colors</label>
        </div>
        <p class="note">
            <code>ReverseColors</code> swaps which end <code>StartColor</code>/<code>EndColor</code>
            apply to &mdash; green&rarr;red instead of red&rarr;green. No effect on an explicit
            <code>Bands</code> list, which is already in whatever order you wrote it in.
        </p>
        <div class="ch-ctrl">
            <label>Elevation</label>
            <select @bind="Elevation">
                @foreach (var e in Enum.GetValues<GaugeElevation>())
                {
                    <option value="@e">@e</option>
                }
            </select>
        </div>
        <div class="ch-ctrl">
            <label>Segment labels <span class="val">comma separated</span></label>
            <input type="text" class="ch-wide" placeholder="(none — Min/Max only)"
                   @bind="RawSegmentLabels" @bind:event="oninput" />
        </div>
        <p class="note">
            <code>SegmentCount</code> only applies when the gauge's own <code>Bands</code> isn't set
            explicitly &mdash; an explicit list always wins. <code>Elevation</code> defaults to
            <code>Floating</code>: a two-tier drop-shadow plus a blurred sheen, filter-based only, never a
            3D/perspective transform. <code>Segment labels</code> replace the default two-endpoint
            Min/Max range labels with one label per entry, evenly spaced &mdash; try
            <em>Poor, Fair, Good, Excellent</em>.
        </p>

        <h2>Page furniture <span class="val">(all three shapes)</span></h2>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="UseHeading" /> Heading</label>
            <input type="text" class="ch-narrow" placeholder="title" @bind="HeadingText" @bind:event="oninput" />
            <input type="text" class="ch-narrow" placeholder="subtitle" @bind="HeadingSubtitle" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="UseCaption" /> Caption</label>
            <input type="text" class="ch-wide" @bind="CaptionText" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="UseEmptyState" /> Empty state</label>
            <input type="text" class="ch-wide" @bind="EmptyStateText" @bind:event="oninput" />
        </div>
        <p class="note">
            Set Min and Max equal above to see the empty state &mdash; that is the degenerate range an
            empty-state element should cover.
        </p>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="UseReadout" /> Readout</label>
            <label><input type="checkbox" @bind="UseRangeLabels" /> Range labels</label>
            <label><input type="checkbox" @bind="UseBanner" /> Banner</label>
        </div>
        <div class="ch-ctrl">
            <label>Banner text</label>
            <input type="text" class="ch-wide" @bind="BannerText" @bind:event="oninput" />
        </div>
        <p class="note">
            <code>Banner</code> straddles the shape's own bottom edge (half on, half off) &mdash; the
            "SCORE" style pill several reference gauges overlap directly on the ring. Different
            from <code>Caption</code>, which the frame places below everything instead.
        </p>
        <div class="ch-ctrl">
            <label>Readout offset <span class="val">@(ReadoutOffset is null ? "auto" : Inv(ReadoutOffset.Value))</span></label>
            <input type="range" min="-0.2" max="0.4" step="0.02" value="@Inv(ReadoutOffset ?? 0.16)"
                   @oninput="@(e => ReadoutOffset = double.Parse(e.Value?.ToString() ?? "0", System.Globalization.CultureInfo.InvariantCulture))" />
            <button class="clr-btn" type="button" @onclick="@(() => ReadoutOffset = null)">auto</button>
        </div>
        <div class="ch-ctrl">
            <label>Readout font size <span class="val">@(ReadoutFontSize is null ? "auto" : Inv(ReadoutFontSize.Value) + "em")</span></label>
            <input type="range" min="0.6" max="2" step="0.1" value="@Inv(ReadoutFontSize ?? 1.5)"
                   @oninput="@(e => ReadoutFontSize = double.Parse(e.Value?.ToString() ?? "0", System.Globalization.CultureInfo.InvariantCulture))" />
            <button class="clr-btn" type="button" @onclick="@(() => ReadoutFontSize = null)">auto</button>
        </div>
        <p class="note">
            <code>FontSize</code>/<code>Padding</code> on <code>AtomChartReadout</code> size the pill itself
            &mdash; a size tuned for AtomGauge's own round face reads oversized on AtomBarGauge/AtomDotGauge's
            narrower track, which is why those two shapes already default this smaller on their own.
        </p>
        <div class="ch-ctrl">
            <label>Width / Height</label>
            <input type="text" class="ch-narrow" placeholder="100%" @bind="Width" @bind:event="oninput" />
            <input type="text" class="ch-narrow" placeholder="(per shape)" @bind="Height" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="Animate" /> Animate</label>
            <label><input type="checkbox" @bind="Visible" /> Visible</label>
        </div>
    </div>

    <div class="ch-pane">
        <h2>AtomGauge</h2>
        <div class="ch-ctrl">
            <label>Sweep angle <span class="val">@GaugeSweep</span></label>
            <input type="range" min="30" max="360" step="10" @bind="GaugeSweep" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label>Thickness <span class="val">@GaugeThickness</span></label>
            <input type="range" min="2" max="40" step="1" @bind="GaugeThickness" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="ShowNeedle" /> Needle</label>
            <label><input type="checkbox" @bind="ShowValueArc" /> Value arc</label>
            <label><input type="checkbox" @bind="UseBands" /> Explicit bands</label>
        </div>
        <div class="ch-ctrl">
            <label>Needle style</label>
            <select @bind="NeedleStyle">
                @foreach (var s in Enum.GetValues<GaugeNeedleStyle>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="ch-ctrl">
            <label>Needle / pointer color</label>
            <input type="text" placeholder="(series)" @bind="NeedleColor" @bind:event="oninput" />
        </div>
        <p class="note">
            <code>Tapered</code> draws a dart-shaped path with a tail counterweight and a two-layer hub.
            <code>Triangle</code> is a short bold arrowhead off the face plate, no tail. <code>RimTab</code>
            isn't a centre-pivot needle at all &mdash; a small tab riding the band's own rim at the value
            position. None of these is a CSS override on a plain <code>&lt;line&gt;</code> could fake.
        </p>
        <div class="ch-ctrl">
            <label>Arc style</label>
            <select @bind="ArcStyle">
                @foreach (var s in Enum.GetValues<GaugeArcStyle>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <p class="note">
            <code>Gradient</code> draws ~60 thin arc slices swept by the same hue scale
            <code>SegmentCount</code> uses for bands &mdash; SVG has no native curved gradient, so this is
            the smooth-looking approximation. <code>Ticks</code> draws radial marks around the arc instead
            of bands, colored the same way, independent of <code>SegmentCount</code>.
        </p>
        <p class="note">
            Explicit bands (green/amber/red, uneven widths) take precedence over <code>SegmentCount</code>
            &mdash; turn this on to compare a hand-built scale against the auto-generated one.
        </p>
        <div class="ch-ctrl">
            <label>Bezel color / width <span class="val">@BezelWidth</span></label>
            <input type="text" class="ch-narrow" placeholder="(default)" @bind="BezelColor" @bind:event="oninput" />
            <input type="range" min="1" max="6" step="0.5" @bind="BezelWidth" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="ShowPedestal" /> Pedestal</label>
        </div>
        <p class="note">
            <code>ShowPedestal</code> draws a literal flat platform under the dial, distinct from
            <code>Elevation</code>'s drop-shadow &mdash; for the reference dials that sit on a drawn base
            rather than merely floating above one.
        </p>
        <div class="ch-ctrl">
            <label>Redline from <span class="val">@(RedlineFrom is null ? "off" : Inv(RedlineFrom.Value))</span></label>
            <input type="range" min="0" max="100" step="1" value="@Inv(RedlineFrom ?? 85)"
                   @oninput="@(e => RedlineFrom = double.Parse(e.Value?.ToString() ?? "0", System.Globalization.CultureInfo.InvariantCulture))" />
            <button class="clr-btn" type="button" @onclick="@(() => RedlineFrom = null)">off</button>
            <input type="text" class="ch-narrow" placeholder="(danger red)" @bind="RedlineColor" @bind:event="oninput" />
        </div>
        <p class="note">
            A tachometer-style danger zone drawn on top of whatever <code>ArcStyle</code> already draws,
            from <code>RedlineFrom</code> to <code>Max</code>.
        </p>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="ShowTickRuler" /> Tick ruler</label>
            <input type="number" class="ch-narrow" min="2" max="12" @bind="MajorTickCount" @bind:event="oninput" />
            <input type="number" class="ch-narrow" min="0" max="10" @bind="MinorTicksPerMajor" @bind:event="oninput" />
        </div>
        <p class="note">
            A car-speedometer-style major/minor graduation ruler, independent of <code>ArcStyle</code> and
            <code>SegmentLabels</code> &mdash; needs a filled <code>RangeLabels</code> slot to show its
            numbers, same as <code>SegmentLabels</code> does.
        </p>

        <h2>AtomBarGauge</h2>
        <div class="ch-ctrl">
            <label>Orientation</label>
            <select @bind="BarGaugeOrientation">
                @foreach (var o in Enum.GetValues<ChartOrientation>())
                {
                    <option value="@o">@o</option>
                }
            </select>
        </div>
        <div class="ch-ctrl">
            <label>Bar style</label>
            <select @bind="BarStyle">
                @foreach (var s in Enum.GetValues<BarGaugeStyle>())
                {
                    <option value="@s">@s</option>
                }
            </select>
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="ShowBarPointer" /> Pointer</label>
        </div>
        <p class="note">
            The track always shows the whole range end to end &mdash; only the pointer moves with
            <code>Value</code>. <code>Gradient</code> is the one shape in this family that needs a real SVG
            <code>&lt;linearGradient&gt;</code>, with a per-instance id so two on one page don't collide.
        </p>

        <h2>AtomDotGauge</h2>
        <div class="ch-ctrl">
            <label>Orientation</label>
            <select @bind="DotGaugeOrientation">
                @foreach (var o in Enum.GetValues<ChartOrientation>())
                {
                    <option value="@o">@o</option>
                }
            </select>
        </div>
        <div class="ch-ctrl">
            <label>Dot count <span class="val">@(DotCount?.ToString() ?? "auto")</span></label>
            <input type="range" min="2" max="10" step="1" value="@(DotCount ?? 5)"
                   @oninput="@(e => DotCount = int.Parse(e.Value?.ToString() ?? "5"))" />
            <button class="clr-btn" type="button" @onclick="@(() => DotCount = null)">off</button>
        </div>
        <div class="ch-ctrl">
            <label>Dot size <span class="val">@DotSize</span></label>
            <input type="range" min="10" max="36" step="2" @bind="DotSize" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label><input type="checkbox" @bind="ShowDotPointer" /> Pointer</label>
        </div>

        <h2>Element styling</h2>
        <div class="ch-ctrl">
            <label>Element</label>
            <select @bind="StyleTarget">
                @foreach (var name in ElementNames)
                {
                    <option value="@name">@name</option>
                }
            </select>
        </div>
        <div class="ch-ctrl">
            <label>CssClass</label>
            <input type="text" class="ch-wide" @bind="TargetCss" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <label>Style</label>
            <input type="text" class="ch-wide" placeholder="e.g. fill:#d62728; font-weight:700"
                   @bind="TargetStyle" @bind:event="oninput" />
        </div>
        <div class="ch-ctrl">
            <button type="button" @onclick="ClearElementStyling">clear all</button>
        </div>
    </div>
</div>

<div class="ch-round">
    <div>
        <h2>AtomGauge</h2>
        <div class="ch-preview" style="width:400px;">
            <AtomGauge Value="@GaugeValue" Min="@GaugeMin" Max="@GaugeMax"
                       Width="@Nz(Width)" Height="@Nz(Height)" Animate="@Animate" Visible="@Visible"
                       Heading="@Slot(UseHeading, HeadingEl)"
                       Caption="@Slot(UseCaption, CaptionEl)"
                       EmptyState="@Slot(UseEmptyState, EmptyStateEl)"
                       SweepAngle="@GaugeSweep" Thickness="@GaugeThickness"
                       Bands="@(UseBands ? Bands : null)"
                       ShowNeedle="@ShowNeedle" NeedleStyle="@NeedleStyle" ArcStyle="@ArcStyle" ShowValueArc="@ShowValueArc"
                       Readout="@Slot(UseReadout, ReadoutEl)"
                       RangeLabels="@Slot(UseRangeLabels, RangeLabelsEl)"
                       Banner="@Slot(UseBanner, BannerEl)"
                       NeedleColor="@Nz(NeedleColor)"
                       BezelColor="@Nz(BezelColor)" BezelWidth="@BezelWidth" ShowPedestal="@ShowPedestal"
                       RedlineFrom="@RedlineFrom" RedlineColor="@Nz(RedlineColor)"
                       ShowTickRuler="@ShowTickRuler" MajorTickCount="@MajorTickCount" MinorTicksPerMajor="@MinorTicksPerMajor"
                       SegmentCount="@SegmentCount" StartColor="@Nz(StartColor)" EndColor="@Nz(EndColor)" ReverseColors="@ReverseColors"
                       Elevation="@Elevation" SegmentLabels="@SegmentLabels" />
        </div>
    </div>

    <div>
        <h2>AtomBarGauge</h2>
        <div class="ch-preview" style="width:400px;">
            <AtomBarGauge Value="@GaugeValue" Min="@GaugeMin" Max="@GaugeMax"
                          Width="@Nz(Width)" Height="@Nz(Height)" Animate="@Animate" Visible="@Visible"
                          Heading="@Slot(UseHeading, HeadingEl)"
                          Caption="@Slot(UseCaption, CaptionEl)"
                          EmptyState="@Slot(UseEmptyState, EmptyStateEl)"
                          Readout="@Slot(UseReadout, ReadoutEl)"
                          RangeLabels="@Slot(UseRangeLabels, RangeLabelsEl)"
                          Banner="@Slot(UseBanner, BannerEl)"
                          NeedleColor="@Nz(NeedleColor)"
                          SegmentCount="@SegmentCount" StartColor="@Nz(StartColor)" EndColor="@Nz(EndColor)" ReverseColors="@ReverseColors"
                          Elevation="@Elevation" SegmentLabels="@SegmentLabels"
                          Orientation="@BarGaugeOrientation" BarStyle="@BarStyle" ShowPointer="@ShowBarPointer" />
        </div>
    </div>

    <div>
        <h2>AtomDotGauge</h2>
        <div class="ch-preview" style="width:400px;">
            <AtomDotGauge Value="@GaugeValue" Min="@GaugeMin" Max="@GaugeMax"
                          Width="@Nz(Width)" Height="@Nz(Height)" Animate="@Animate" Visible="@Visible"
                          Heading="@Slot(UseHeading, HeadingEl)"
                          Caption="@Slot(UseCaption, CaptionEl)"
                          EmptyState="@Slot(UseEmptyState, EmptyStateEl)"
                          Readout="@Slot(UseReadout, ReadoutEl)"
                          RangeLabels="@Slot(UseRangeLabels, RangeLabelsEl)"
                          Banner="@Slot(UseBanner, BannerEl)"
                          NeedleColor="@Nz(NeedleColor)"
                          SegmentCount="@SegmentCount" StartColor="@Nz(StartColor)" EndColor="@Nz(EndColor)" ReverseColors="@ReverseColors"
                          Elevation="@Elevation" SegmentLabels="@SegmentLabels"
                          Orientation="@DotGaugeOrientation" DotCount="@DotCount" DotSize="@DotSize"
                          ShowPointer="@ShowDotPointer" />
        </div>
    </div>
</div>

<h2>Composite: dot scale + mini dial</h2>
<p>
    Some references pair a dot scale with its own small needle-in-disc readout rather than a single
    component drawing both. There's no combined component for that &mdash; this is the documented
    pattern: two gauge-family members placed side by side, sharing the same <code>Value</code>.
</p>
<div class="ch-preview" style="display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap;">
    <div style="flex:1 1 260px; min-width:200px;">
        <AtomDotGauge Value="@GaugeValue" Min="@GaugeMin" Max="@GaugeMax"
                      SegmentCount="@SegmentCount" StartColor="@Nz(StartColor)" EndColor="@Nz(EndColor)" ReverseColors="@ReverseColors"
                      Elevation="@Elevation" ShowPointer="false" />
    </div>
    <div style="flex:0 0 120px;">
        <AtomGauge Value="@GaugeValue" Min="@GaugeMin" Max="@GaugeMax" Width="120"
                   SweepAngle="300" ShowValueArc="false"
                   SegmentCount="@SegmentCount" StartColor="@Nz(StartColor)" EndColor="@Nz(EndColor)" ReverseColors="@ReverseColors"
                   Elevation="@Elevation"
                   Readout="@Slot(true, ReadoutEl)" />
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="GaugesExample.razor" />

@code {
    // ---- value ----------------------------------------------------------------------------------

    private double GaugeValue { get; set; } = 72;
    private double GaugeMin { get; set; }
    private double GaugeMax { get; set; } = 100;

    // ---- shared AtomGaugeBase surface -------------------------------------------------------------

    private int? SegmentCount { get; set; }
    private string StartColor { get; set; } = "";
    private string EndColor { get; set; } = "";
    private bool ReverseColors { get; set; }
    private GaugeElevation Elevation { get; set; } = GaugeElevation.Floating;
    private string RawSegmentLabels { get; set; } = "";

    private string[]? SegmentLabels
    {
        get
        {
            var labels = RawSegmentLabels.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            return labels.Length > 0 ? labels : null;
        }
    }

    // ---- page furniture / slots -------------------------------------------------------------------

    private bool UseHeading { get; set; } = true;
    private bool UseCaption { get; set; }
    private bool UseEmptyState { get; set; } = true;
    private bool UseReadout { get; set; } = true;
    private bool UseRangeLabels { get; set; } = true;
    private bool UseBanner { get; set; }
    private string BannerText { get; set; } = "Score";

    private string HeadingText { get; set; } = "Score";
    private string HeadingSubtitle { get; set; } = "";
    private string CaptionText { get; set; } = "";
    private string EmptyStateText { get; set; } = "No data";
    private double? ReadoutOffset { get; set; }
    private double? ReadoutFontSize { get; set; }

    private string Width { get; set; } = "";
    private string Height { get; set; } = "";
    private bool Animate { get; set; } = true;
    private bool Visible { get; set; } = true;

    // ---- AtomGauge --------------------------------------------------------------------------------

    private double GaugeSweep { get; set; } = 240;
    private double GaugeThickness { get; set; } = 12;
    private bool ShowNeedle { get; set; } = true;
    private GaugeNeedleStyle NeedleStyle { get; set; } = GaugeNeedleStyle.Line;
    private GaugeArcStyle ArcStyle { get; set; } = GaugeArcStyle.Segmented;
    private double? RedlineFrom { get; set; }
    private string? RedlineColor { get; set; }
    private bool ShowTickRuler { get; set; }
    private int MajorTickCount { get; set; } = 6;
    private int MinorTicksPerMajor { get; set; } = 4;
    private bool ShowValueArc { get; set; }
    private bool UseBands { get; set; }
    private string NeedleColor { get; set; } = "";
    private string BezelColor { get; set; } = "";
    private double BezelWidth { get; set; } = 1;
    private bool ShowPedestal { get; set; }

    private static readonly GaugeBand[] Bands =
    [
        new(60, "#59a14f"),
        new(85, "#edc948"),
        new(100, "#e15759"),
    ];

    // ---- AtomBarGauge -----------------------------------------------------------------------------

    private ChartOrientation BarGaugeOrientation { get; set; } = ChartOrientation.Horizontal;
    private BarGaugeStyle BarStyle { get; set; } = BarGaugeStyle.Segmented;
    private bool ShowBarPointer { get; set; } = true;

    // ---- AtomDotGauge -----------------------------------------------------------------------------

    private ChartOrientation DotGaugeOrientation { get; set; } = ChartOrientation.Horizontal;
    private int? DotCount { get; set; }
    private double DotSize { get; set; } = 20;
    private bool ShowDotPointer { get; set; } = true;

    // ---- per-element CssClass / Style ---------------------------------------------------------

    private static readonly string[] ElementNames = ["Heading", "Caption", "EmptyState", "Readout", "RangeLabels", "Banner"];

    private readonly Dictionary<string, string> ElementCss = [];
    private readonly Dictionary<string, string> ElementStyle = [];

    private string StyleTarget { get; set; } = "Readout";

    private string TargetCss
    {
        get => ElementCss.GetValueOrDefault(StyleTarget, "");
        set => ElementCss[StyleTarget] = value;
    }

    private string TargetStyle
    {
        get => ElementStyle.GetValueOrDefault(StyleTarget, "");
        set => ElementStyle[StyleTarget] = value;
    }

    private string? Css(string element) => Nz(ElementCss.GetValueOrDefault(element, ""));
    private string? Sty(string element) => Nz(ElementStyle.GetValueOrDefault(element, ""));

    private void ClearElementStyling()
    {
        ElementCss.Clear();
        ElementStyle.Clear();
    }

    // ---- the element fragments ----------------------------------------------------------------

    private static RenderFragment? Slot(bool on, RenderFragment element) => on ? element : null;

    private RenderFragment HeadingEl => @<AtomChartHeading CssClass="@Css("Heading")" Style="@Sty("Heading")"
                                                          Subtitle="@Nz(HeadingSubtitle)">@HeadingText</AtomChartHeading>;

    private RenderFragment CaptionEl => @<AtomChartCaption CssClass="@Css("Caption")" Style="@Sty("Caption")">@CaptionText</AtomChartCaption>;

    private RenderFragment EmptyStateEl => @<AtomChartEmptyState CssClass="@Css("EmptyState")" Style="@Sty("EmptyState")"
                                                                Text="@EmptyStateText" />;

    private RenderFragment ReadoutEl => @<AtomChartReadout CssClass="@Css("Readout")" Style="@Sty("Readout")"
                                                          Offset="@ReadoutOffset" FontSize="@ReadoutFontSize" />;

    private RenderFragment RangeLabelsEl => @<AtomChartRangeLabels CssClass="@Css("RangeLabels")" Style="@Sty("RangeLabels")" />;

    private RenderFragment BannerEl => @<AtomChartBanner CssClass="@Css("Banner")" Style="@Sty("Banner")">@BannerText</AtomChartBanner>;

    private static string? Nz(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private static string Inv(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);

    // ---- snippet ------------------------------------------------------------------------------

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder();

            // --- gauge ---
            sb.Append($"<AtomGauge Value=\"{Inv(GaugeValue)}\"");
            if (GaugeMin != 0) sb.Append($" Min=\"{Inv(GaugeMin)}\"");
            if (GaugeMax != 100) sb.Append($" Max=\"{Inv(GaugeMax)}\"");
            if (GaugeSweep != 240) sb.Append($" SweepAngle=\"{Inv(GaugeSweep)}\"");
            if (GaugeThickness != 12) sb.Append($" Thickness=\"{Inv(GaugeThickness)}\"");
            if (!ShowNeedle) sb.Append(" ShowNeedle=\"false\"");
            if (NeedleStyle != GaugeNeedleStyle.Line) sb.Append($" NeedleStyle=\"GaugeNeedleStyle.{NeedleStyle}\"");
            if (ArcStyle != GaugeArcStyle.Segmented) sb.Append($" ArcStyle=\"GaugeArcStyle.{ArcStyle}\"");
            if (ShowValueArc) sb.Append(" ShowValueArc=\"true\"");
            if (UseBands) sb.Append(" Bands=\"@bands\"");
            if (!string.IsNullOrEmpty(BezelColor)) sb.Append($" BezelColor=\"{BezelColor}\"");
            if (BezelWidth != 1) sb.Append($" BezelWidth=\"{Inv(BezelWidth)}\"");
            if (ShowPedestal) sb.Append(" ShowPedestal=\"true\"");
            if (RedlineFrom is { } redlineFrom) sb.Append($" RedlineFrom=\"{Inv(redlineFrom)}\"");
            if (!string.IsNullOrEmpty(RedlineColor)) sb.Append($" RedlineColor=\"{RedlineColor}\"");
            if (ShowTickRuler) sb.Append(" ShowTickRuler=\"true\"");
            if (ShowTickRuler && MajorTickCount != 6) sb.Append($" MajorTickCount=\"{MajorTickCount}\"");
            if (ShowTickRuler && MinorTicksPerMajor != 4) sb.Append($" MinorTicksPerMajor=\"{MinorTicksPerMajor}\"");
            GaugeFamily(sb);
            Common(sb);
            Close(sb, "AtomGauge", Furniture().Concat(GaugeSlots()));

            if (UseBands)
            {
                sb.AppendLine();
                sb.Append("@code { GaugeBand[] bands = [new(60, \"#59a14f\"), new(85, \"#edc948\"), new(100, \"#e15759\")]; }");
                sb.AppendLine();
                sb.AppendLine();
            }

            // --- bar gauge ---
            sb.Append($"<AtomBarGauge Value=\"{Inv(GaugeValue)}\"");
            if (GaugeMin != 0) sb.Append($" Min=\"{Inv(GaugeMin)}\"");
            if (GaugeMax != 100) sb.Append($" Max=\"{Inv(GaugeMax)}\"");
            if (BarGaugeOrientation != ChartOrientation.Horizontal) sb.Append($" Orientation=\"ChartOrientation.{BarGaugeOrientation}\"");
            if (BarStyle != BarGaugeStyle.Segmented) sb.Append($" BarStyle=\"BarGaugeStyle.{BarStyle}\"");
            if (!ShowBarPointer) sb.Append(" ShowPointer=\"false\"");
            GaugeFamily(sb);
            Common(sb);
            Close(sb, "AtomBarGauge", Furniture().Concat(GaugeSlots()));

            // --- dot gauge ---
            sb.Append($"<AtomDotGauge Value=\"{Inv(GaugeValue)}\"");
            if (GaugeMin != 0) sb.Append($" Min=\"{Inv(GaugeMin)}\"");
            if (GaugeMax != 100) sb.Append($" Max=\"{Inv(GaugeMax)}\"");
            if (DotGaugeOrientation != ChartOrientation.Horizontal) sb.Append($" Orientation=\"ChartOrientation.{DotGaugeOrientation}\"");
            if (DotCount is int dc) sb.Append($" DotCount=\"{dc}\"");
            if (DotSize != 20) sb.Append($" DotSize=\"{Inv(DotSize)}\"");
            if (!ShowDotPointer) sb.Append(" ShowPointer=\"false\"");
            GaugeFamily(sb);
            Common(sb);
            Close(sb, "AtomDotGauge", Furniture().Concat(GaugeSlots()));

            return sb.ToString().TrimEnd();
        }
    }

    /// <summary>Closes the opening tag: self-closing with no slots, or a block with the slots nested.</summary>
    private static void Close(System.Text.StringBuilder sb, string tag, IEnumerable<string> slots)
    {
        var lines = slots.ToArray();

        if (lines.Length == 0)
        {
            sb.AppendLine(" />");
            sb.AppendLine();
            return;
        }

        sb.AppendLine(">");
        foreach (var line in lines) sb.AppendLine($"    {line}");
        sb.AppendLine($"</{tag}>");
        sb.AppendLine();
    }

    private IEnumerable<string> Furniture()
    {
        if (UseHeading)
        {
            yield return SlotLine("Heading", "AtomChartHeading", Attr("Subtitle", Nz(HeadingSubtitle)), HeadingText);
        }

        if (UseEmptyState)
        {
            yield return SlotLine("EmptyState", "AtomChartEmptyState", Attr("Text", EmptyStateText));
        }

        if (UseCaption)
        {
            yield return SlotLine("Caption", "AtomChartCaption", "", CaptionText);
        }
    }

    private IEnumerable<string> GaugeSlots()
    {
        if (UseReadout)
        {
            yield return SlotLine("Readout", "AtomChartReadout",
                (ReadoutOffset is null ? "" : Attr("Offset", Inv(ReadoutOffset.Value))) +
                (ReadoutFontSize is null ? "" : Attr("FontSize", Inv(ReadoutFontSize.Value))));
        }

        if (UseRangeLabels) yield return SlotLine("RangeLabels", "AtomChartRangeLabels");
        if (UseBanner) yield return SlotLine("Banner", "AtomChartBanner", "", BannerText);
    }

    /// <summary>The <c>AtomGaugeBase</c> params shared by <c>AtomGauge</c>/<c>AtomBarGauge</c>/
    /// <c>AtomDotGauge</c>.</summary>
    private void GaugeFamily(System.Text.StringBuilder sb)
    {
        if (SegmentCount is int n) sb.Append($" SegmentCount=\"{n}\"");
        if (!string.IsNullOrEmpty(StartColor)) sb.Append($" StartColor=\"{StartColor}\"");
        if (!string.IsNullOrEmpty(EndColor)) sb.Append($" EndColor=\"{EndColor}\"");
        if (ReverseColors) sb.Append(" ReverseColors=\"true\"");
        if (Elevation != GaugeElevation.Floating) sb.Append($" Elevation=\"GaugeElevation.{Elevation}\"");
        if (SegmentLabels is { } labels)
        {
            sb.Append($" SegmentLabels=\"@(new[] {{ {string.Join(", ", labels.Select(l => $"\"{l}\""))} }})\"");
        }
    }

    /// <summary>One nested slot, with the element's own styling hooks appended if they are set.</summary>
    private string SlotLine(string slot, string element, string attrs = "", string? content = null)
    {
        var all = attrs + Attr("CssClass", Css(slot)) + Attr("Style", Sty(slot));

        return content is null
            ? $"<{slot}><{element}{all} /></{slot}>"
            : $"<{slot}><{element}{all}>{content}</{element}></{slot}>";
    }

    private static string Attr(string name, string? value) => value is null ? "" : $" {name}=\"{value}\"";

    private void Common(System.Text.StringBuilder sb)
    {
        if (Nz(Width) is not null) sb.Append($" Width=\"{Width}\"");
        if (Nz(Height) is not null) sb.Append($" Height=\"{Height}\"");
        if (!Animate) sb.Append(" Animate=\"false\"");
        if (!Visible) sb.Append(" Visible=\"false\"");
    }
