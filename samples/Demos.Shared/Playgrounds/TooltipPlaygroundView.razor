@using BlazorAtoms.Tooltips

<PageTitle>AtomTooltip Playground</PageTitle>

<style>
    .tt-stage-outer {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 220px;
        background: radial-gradient(ellipse at center, #0b1019 0%, #07090d 100%);
        border: 1px solid #1b2330;
        border-radius: 12px;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
    }

    .tt-trigger-btn {
        padding: .6rem 1.1rem;
        border-radius: 6px;
        border: 1px solid #2a3242;
        background: #161b26;
        color: #e5e9f0;
        font-size: .95rem;
        cursor: pointer;
    }

    .tt-controls {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
        gap: 1rem 1.5rem;
        background: #0d1118;
        border: 1px solid #1b2330;
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        color: #cfd8e3;
    }

    .tt-ctrl {
        display: flex;
        flex-direction: column;
        gap: .35rem;
    }

    .tt-ctrl label {
        font-size: .8rem;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #8794a3;
        display: flex;
        justify-content: space-between;
        gap: .5rem;
    }

    .tt-ctrl label .val {
        color: #5fb7c9;
        font-family: ui-monospace, Consolas, monospace;
        text-transform: none;
    }

    .tt-controls input[type=range],
    .tt-controls input[type=text],
    .tt-controls select {
        width: 100%;
        accent-color: #00b3c4;
    }

    .tt-controls input[type=color] {
        width: 100%;
        height: 32px;
        background: none;
        border: 1px solid #1b2330;
        border-radius: 6px;
        padding: 2px;
    }

    .tt-ctrl .row {
        display: flex;
        align-items: center;
        gap: .5rem;
    }

    .tt-ctrl .row input[type=checkbox] {
        accent-color: #00b3c4;
        width: 16px;
        height: 16px;
    }

    .tt-ctrl .row label {
        text-transform: none;
        letter-spacing: 0;
        color: #cfd8e3;
        font-size: .85rem;
        justify-content: flex-start;
    }
</style>

<h1>AtomTooltip playground</h1>
<p>Tune <code>&lt;AtomTooltip&gt;</code> live. Hover or Tab to the button in the stage below.
   Positioning and show/hide stay pure CSS — no JavaScript involved.</p>
<p><a href="playground/activityindicators">&larr; Back to demo</a></p>

<div class="tt-stage-outer">
    <AtomTooltip Text="@Text" Placement="@Placement" Shape="@Shape" ShowArrow="@ShowArrow" Disabled="@Disabled"
                 Background="@(OverrideBackground ? Background : null)"
                 TextColor="@(OverrideTextColor ? TextColor : null)"
                 BorderColor="@(OverrideBorderColor ? BorderColor : null)"
                 BorderWidth="@BorderWidth" Radius="@Radius" ArrowSize="@ArrowSize"
                 Offset="@Offset" MaxWidth="@MaxWidth"
                 CssClass="@Nz(HatchClass)" Style="@Nz(HatchStyle)" title="@Nz(HatchTitle)">
        <button class="tt-trigger-btn">Hover or Tab to me</button>
    </AtomTooltip>
</div>

<div class="tt-controls">
    <div class="tt-ctrl">
        <label>Text</label>
        <input type="text" @bind="Text" @bind:event="oninput" />
    </div>
    <div class="tt-ctrl">
        <label>Placement</label>
        <select @bind="Placement">
            @foreach (var p in Enum.GetValues<TooltipPlacement>())
            {
                <option value="@p">@p</option>
            }
        </select>
    </div>
    <div class="tt-ctrl">
        <label>Shape</label>
        <select @bind="Shape">
            @foreach (var s in Enum.GetValues<TooltipShape>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="tt-ctrl">
        <label>Background</label>
        <div class="row">
            <input type="checkbox" @bind="OverrideBackground" title="Override Background" />
            <input type="color" @bind="Background" @bind:event="oninput" disabled="@(!OverrideBackground)" />
        </div>
    </div>
    <div class="tt-ctrl">
        <label>Text color</label>
        <div class="row">
            <input type="checkbox" @bind="OverrideTextColor" title="Override text color" />
            <input type="color" @bind="TextColor" @bind:event="oninput" disabled="@(!OverrideTextColor)" />
        </div>
    </div>
    <div class="tt-ctrl">
        <label>Border color</label>
        <div class="row">
            <input type="checkbox" @bind="OverrideBorderColor" title="Override border color" />
            <input type="color" @bind="BorderColor" @bind:event="oninput" disabled="@(!OverrideBorderColor)" />
        </div>
    </div>
    <div class="tt-ctrl">
        <label>Border width <span class="val">@(BorderWidth)px</span></label>
        <input type="range" min="0" max="6" step="1" @bind="BorderWidth" @bind:event="oninput" />
    </div>
    <div class="tt-ctrl">
        <label>Radius <span class="val">@(Radius)px</span></label>
        <input type="range" min="0" max="24" step="1" @bind="Radius" @bind:event="oninput" />
    </div>
    <div class="tt-ctrl">
        <label>Arrow size <span class="val">@(ArrowSize)px</span></label>
        <input type="range" min="0" max="20" step="1" @bind="ArrowSize" @bind:event="oninput" />
    </div>
    <div class="tt-ctrl">
        <label>Offset <span class="val">@(Offset)px</span></label>
        <input type="range" min="0" max="32" step="1" @bind="Offset" @bind:event="oninput" />
    </div>
    <div class="tt-ctrl">
        <label>Max width</label>
        <input type="text" @bind="MaxWidth" @bind:event="oninput" />
    </div>
    <div class="tt-ctrl">
        <label>Options</label>
        <div class="row">
            <input type="checkbox" id="showArrow" @bind="ShowArrow" />
            <label for="showArrow">Show arrow</label>
        </div>
        <div class="row">
            <input type="checkbox" id="disabled" @bind="Disabled" />
            <label for="disabled">Disabled</label>
        </div>
    </div>
    <div class="tt-ctrl">
        <label>Extra class (CssClass)</label>
        <input type="text" @bind="HatchClass" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="tt-ctrl">
        <label>Extra style (Style)</label>
        <input type="text" @bind="HatchStyle" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="tt-ctrl">
        <label>title attr (splat)</label>
        <input type="text" @bind="HatchTitle" @bind:event="oninput" placeholder="(none)" />
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomTooltipExample.razor" />

@code {
    // AtomTooltip playground state — defaults match AtomTooltip.razor.cs / AtomTooltip.razor.css.
    private string Text = "I'm a tooltip";
    private TooltipPlacement Placement = TooltipPlacement.Top;
    private TooltipShape Shape = TooltipShape.Rectangle;
    private bool ShowArrow = true;
    private bool Disabled;

    private bool OverrideBackground, OverrideTextColor, OverrideBorderColor;
    private string Background = "#1f2430";
    private string TextColor = "#f2f4f8";
    private string BorderColor = "#3a4152";

    private double BorderWidth = 1;
    private double Radius = 6;
    private double ArrowSize = 8;
    private double Offset = 8;
    private string MaxWidth = "16rem";

    private string HatchClass = "";
    private string HatchStyle = "";
    private string HatchTitle = "";

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    // Build a paste-ready <AtomTooltip> from current state; emit only params that differ from defaults.
    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<AtomTooltip");
            sb.Append($" Text=\"{Text}\"");
            if (Placement != TooltipPlacement.Top) sb.Append($" Placement=\"TooltipPlacement.{Placement}\"");
            if (Shape != TooltipShape.Rectangle) sb.Append($" Shape=\"TooltipShape.{Shape}\"");
            if (!ShowArrow) sb.Append(" ShowArrow=\"false\"");
            if (Disabled) sb.Append(" Disabled=\"true\"");
            if (OverrideBackground) sb.Append($" Background=\"{Background}\"");
            if (OverrideTextColor) sb.Append($" TextColor=\"{TextColor}\"");
            if (OverrideBorderColor) sb.Append($" BorderColor=\"{BorderColor}\"");
            if (BorderWidth != 1) sb.Append($" BorderWidth=\"{BorderWidth}\"");
            if (Radius != 6) sb.Append($" Radius=\"{Radius}\"");
            if (ArrowSize != 8) sb.Append($" ArrowSize=\"{ArrowSize}\"");
            if (Offset != 8) sb.Append($" Offset=\"{Offset}\"");
            if (MaxWidth != "16rem") sb.Append($" MaxWidth=\"{MaxWidth}\"");
            if (!string.IsNullOrEmpty(HatchClass)) sb.Append($" CssClass=\"{HatchClass}\"");
            if (!string.IsNullOrEmpty(HatchStyle)) sb.Append($" Style=\"{HatchStyle}\"");
            if (!string.IsNullOrEmpty(HatchTitle)) sb.Append($" title=\"{HatchTitle}\"");
            sb.Append(">\n    <button>Hover or Tab to me</button>\n</AtomTooltip>");
            return sb.ToString();
        }
    }
}
