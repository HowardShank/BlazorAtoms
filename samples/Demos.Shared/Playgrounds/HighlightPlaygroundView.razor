@using System.Globalization
@using BlazorAtoms.Highlights

<PageTitle>AtomHighlight Playground</PageTitle>

<h1>AtomHighlight & AtomHighlightDeep playground</h1>
<p>
    Two highlighters for different jobs. <code>&lt;AtomHighlight&gt;</code> is the <b>light</b> option:
    zero JavaScript, server-safe, and renders <code>&lt;mark&gt;</code> elements during Blazor render —
    best when the child content is plain text.
    <code>&lt;AtomHighlightDeep&gt;</code> is the <b>deep</b> option: give it an HTML string and it
    highlights matches inside the markup's text content (headings, lists, tables, links) during
    Blazor's own render pass. It renders the result as owned markup, so it's zero-JavaScript,
    server-safe, and re-highlights correctly whenever the terms change.
</p>
<p><a href="demo">&larr; Back to demo</a></p>

<div class="hl-stage-outer">
    <div class="hl-preview">
        <div class="hl-preview-box">
            <h2>AtomHighlight (light)</h2>
            <AtomHighlight Terms="@TermsList"
                           CaseSensitive="@CaseSensitive"
                           WholeWord="@WholeWord"
                           HighlightStyle="@Style"
                           Background="@Nz(Background)"
                           Color="@Nz(Color)"
                           Radius="@Radius"
                           Padding="@Nz(Padding)">
                @LightSampleText
            </AtomHighlight>
        </div>
        <div class="hl-preview-box">
            <h2>AtomHighlightDeep (deep)</h2>
            <AtomHighlightDeep Terms="@TermsList"
                               Html="@DeepSampleHtml"
                               CaseSensitive="@CaseSensitive"
                               WholeWord="@WholeWord"
                               HighlightStyle="@Style"
                               Background="@Nz(Background)"
                               Color="@Nz(Color)"
                               Radius="@Radius"
                               Padding="@Nz(Padding)" />
        </div>
    </div>
</div>

<div class="hl-controls">
    <div class="hl-ctrl">
        <label>Terms (comma separated)</label>
        <input type="text" @bind="RawTerms" @bind:event="oninput" placeholder="e.g. Blazor, CSS" />
    </div>
    <div class="hl-ctrl">
        <label>Light sample text</label>
        <textarea @bind="LightSampleText" @bind:event="oninput" rows="3"></textarea>
    </div>
    <div class="hl-ctrl">
        <label>Style</label>
        <select @bind="Style">
            @foreach (var s in Enum.GetValues<HighlightStyle>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="hl-ctrl">
        <label>Suggestion strategy</label>
        <select @bind="SuggestionStrategy">
            @foreach (var s in Enum.GetValues<HighlightColorStrategy>())
            {
                <option value="@s">@s</option>
            }
        </select>
    </div>
    <div class="hl-ctrl">
        <label>Background <span class="val">@Background</span></label>
        <div class="row color">
            <input type="color" @bind="Background" @bind:event="oninput" aria-label="Background color picker" />
            <input type="text" @bind="Background" @bind:event="oninput" />
        </div>
    </div>
    <div class="hl-ctrl">
        <label>Text color <span class="val">@Color</span></label>
        <div class="row color">
            <input type="color" @bind="Color" @bind:event="oninput" aria-label="Text color picker" />
            <input type="text" @bind="Color" @bind:event="oninput" placeholder="(inherit)" />
        </div>
    </div>
    <div class="hl-ctrl">
        <label>Suggestions</label>
        <div class="row suggestion">
            <button type="button" class="chip" style="background:@BackgroundSuggestionBackground; color:@BackgroundSuggestionForeground;" title="Suggested foreground for selected background" @onclick="UseBackgroundSuggestion">
                @BackgroundSuggestionText
            </button>
            <button type="button" class="chip" style="background:@TextSuggestionBackground; color:@TextSuggestionForeground;" title="Suggested background for selected text color" @onclick="UseTextSuggestion">
                @TextSuggestionText
            </button>
        </div>
    </div>
    <div class="hl-ctrl">
        <label>Radius px <span class="val">@Radius</span></label>
        <input type="range" min="0" max="20" step="1" @bind="Radius" @bind:event="oninput" />
    </div>
    <div class="hl-ctrl">
        <label>Padding</label>
        <input type="text" @bind="Padding" @bind:event="oninput" placeholder="e.g. 0 2px" />
    </div>
    <div class="hl-ctrl">
        <label>Options</label>
        <div class="row"><input type="checkbox" id="cs" @bind="CaseSensitive" /><label for="cs">Case sensitive</label></div>
        <div class="row"><input type="checkbox" id="ww" @bind="WholeWord" /><label for="ww">Whole word</label></div>
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomHighlightExample.razor" />

<style>
    .hl-stage-outer { background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.5rem; margin-bottom:1.5rem; }
    .hl-preview { display:grid; grid-template-columns:repeat(auto-fit, minmax(280px, 1fr)); gap:1.5rem; }
    .hl-preview-box { background:#161b26; border:1px solid #2a3242; border-radius:10px; padding:1.25rem; color:#e6edf3; line-height:1.6; }
    .hl-preview-box h2 { margin:0 0 .75rem; font-size:1rem; color:#8794a3; }
    .hl-controls { display:grid; grid-template-columns:repeat(auto-fit, minmax(230px, 1fr)); gap:1rem 1.5rem; background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; }
    .hl-ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .hl-ctrl label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .hl-ctrl label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .hl-ctrl input[type=text], .hl-ctrl textarea, .hl-ctrl select { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .hl-ctrl textarea { resize:vertical; }
    .hl-ctrl input[type=range] { width:100%; accent-color:#2563eb; }
    .hl-ctrl .row { display:flex; align-items:center; gap:.5rem; }
    .hl-ctrl .row.color { gap:.4rem; }
    .hl-ctrl .row.color input[type=color] { flex:none; width:38px; height:32px; padding:2px; background:#070b10; border:1px solid #1b2330; border-radius:6px; cursor:pointer; }
    .hl-ctrl .row.color input[type=text] { flex:1 1 auto; min-width:0; }
    .hl-ctrl .row input[type=checkbox] { accent-color:#2563eb; width:16px; height:16px; }
    .hl-ctrl .row label { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
    .hl-ctrl .row.suggestion { flex-wrap:wrap; gap:.5rem; }
    .hl-ctrl .row.suggestion .chip { padding:.25rem .5rem; border-radius:6px; border:1px solid #2a3242; font-family:ui-monospace,Consolas,monospace; font-size:.8rem; }
    .hl-ctrl .row.suggestion .use-btn { padding:.35rem .7rem; border:1px solid #2563eb; border-radius:6px; background:#1d4ed8; color:#fff; cursor:pointer; font-size:.8rem; }
    .hl-ctrl .row.suggestion .use-btn:hover { background:#2563eb; }
    .deep-sample { font-size:.9rem; line-height:1.5; color:#e6edf3; }
    .deep-sample header { display:flex; align-items:center; justify-content:space-between; gap:.5rem; margin-bottom:.75rem; }
    .deep-sample h3 { margin:0; font-size:1.1rem; color:#cfd8e3; }
    .deep-sample .badge { background:#2563eb; color:#fff; padding:.15rem .4rem; border-radius:4px; font-size:.7rem; }
    .deep-sample section { margin-bottom:1rem; padding:.75rem; background:#111821; border:1px solid #1b2330; border-radius:8px; }
    .deep-sample h4 { margin:0 0 .5rem; font-size:.85rem; color:#8794a3; }
    .deep-sample p { margin:0 0 .5rem; }
    .deep-sample p:last-child { margin-bottom:0; }
    .deep-sample a { color:#5fb7c9; }
    .deep-sample pre { background:#05080e; border:1px solid #1b2330; border-radius:6px; padding:.5rem; overflow:auto; }
    .deep-sample code { font-family:ui-monospace,Consolas,monospace; font-size:.8rem; color:#9fe6c3; }
    .deep-sample ul { margin:.25rem 0 0; padding-left:1.25rem; }
    .deep-sample .pill { display:inline-block; background:#2a3242; color:#e6edf3; padding:.1rem .35rem; border-radius:4px; font-size:.75rem; }
    .deep-sample table { width:100%; border-collapse:collapse; font-size:.8rem; }
    .deep-sample th, .deep-sample td { text-align:left; padding:.35rem .5rem; border-bottom:1px solid #2a3242; }
    .deep-sample th { color:#8794a3; }
    .deep-sample footer { display:flex; align-items:center; justify-content:space-between; gap:1rem; flex-wrap:wrap; }
    .deep-sample .btn { padding:.35rem .75rem; border:1px solid #2563eb; border-radius:6px; background:#1d4ed8; color:#fff; cursor:pointer; }
</style>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private string RawTerms { get; set; } = "Blazor, CSS";
    private string LightSampleText { get; set; } = "Build interactive web UIs with Blazor and CSS.";
    private HighlightStyle Style { get; set; } = HighlightStyle.Mark;
    private HighlightColorStrategy SuggestionStrategy { get; set; } = HighlightColorStrategy.BestContrast;
    private string _background = "#FDE047";
    private string Background
    {
        get => _background;
        set => _background = string.IsNullOrEmpty(value) ? value : value.ToUpperInvariant();
    }
    private string _color = "#1F2937";
    private string Color
    {
        get => _color;
        set => _color = string.IsNullOrEmpty(value) ? value : value.ToUpperInvariant();
    }
    private int Radius { get; set; } = 2;
    private string Padding { get; set; } = "0 2px";
    private bool CaseSensitive;
    private bool WholeWord;

    private IReadOnlyList<string> TermsList => RawTerms
        .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
        .Where(t => !string.IsNullOrWhiteSpace(t))
        .ToList();

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private static string Upper(string? s) => string.IsNullOrEmpty(s) ? s ?? "" : s.ToUpperInvariant();

    // Derived only from the selected background color.
    private string BackgroundSuggestionForeground => Upper(HighlightColor.SuggestForeground(Background, SuggestionStrategy));
    private string BackgroundSuggestionBackground => Background;
    private string BackgroundSuggestionText => $"Bg {Background} → Fg {BackgroundSuggestionForeground}";

    // Derived only from the selected text color.
    private string TextSuggestionBackground => Upper(HighlightColor.SuggestBackground(Color, SuggestionStrategy));
    private string TextSuggestionForeground => Color;
    private string TextSuggestionText => $"Fg {Color} → Bg {TextSuggestionBackground}";

    private string StrategyName => SuggestionStrategy.ToString();

    private void UseBackgroundSuggestion() => Color = BackgroundSuggestionForeground;
    private void UseTextSuggestion() => Background = TextSuggestionBackground;

    // The deep sample is supplied to AtomHighlightDeep as an HTML string. The component
    // highlights matches inside this markup during Blazor's own render pass (no JS), so it
    // re-highlights correctly and safely whenever the terms change.
    private const string DeepSampleHtml = @"
        <article class='deep-sample'>
            <header>
                <h3>Blazor Component Overview</h3>
                <span class='badge'>v9.0</span>
            </header>
            <section>
                <p>Build interactive web UIs with <strong>Blazor</strong> and modern <em>CSS</em> techniques.</p>
                <p>Even inside a <a href='https://dotnet.microsoft.com/apps/aspnet/web-apps/blazor' target='_blank'>Blazor documentation link</a>, matching terms are highlighted.</p>
            </section>
            <section>
                <h4>Quick CSS Example</h4>
                <pre><code>.blazor-button {
    background: var(--css-accent);
    color: var(--blazor-fg);
}</code></pre>
            </section>
            <section>
                <h4>Feature Checklist</h4>
                <ul>
                    <li>Server-side rendering with <span class='pill'>Blazor Server</span></li>
                    <li>Client-side WebAssembly via Blazor WASM</li>
                    <li>CSS isolation for scoped styles</li>
                    <li>Reusable component model</li>
                </ul>
            </section>
            <section>
                <h4>Browser Matrix</h4>
                <table>
                    <thead><tr><th>Engine</th><th>Blazor Support</th><th>CSS Notes</th></tr></thead>
                    <tbody>
                        <tr><td>Blink</td><td>Full</td><td>Modern CSS OK</td></tr>
                        <tr><td>WebKit</td><td>Full</td><td>Modern CSS OK</td></tr>
                        <tr><td>Gecko</td><td>Full</td><td>Modern CSS OK</td></tr>
                    </tbody>
                </table>
            </section>
            <footer>
                <button type='button' class='btn'>Learn more about Blazor</button>
                <small>Generated by the BlazorAtoms highlight playground</small>
            </footer>
        </article>";

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<AtomHighlight");
            if (TermsList.Count > 0) sb.Append($" Terms=\"@({TermsArrayLiteral})\"");
            if (CaseSensitive) sb.Append(" CaseSensitive=\"true\"");
            if (WholeWord) sb.Append(" WholeWord=\"true\"");
            if (Style != HighlightStyle.Mark) sb.Append($" HighlightStyle=\"HighlightStyle.{Style}\"");
            if (!string.IsNullOrEmpty(Background) && Background != "#fde047") sb.Append($" Background=\"{Background}\"");
            if (!string.IsNullOrEmpty(Color)) sb.Append($" Color=\"{Color}\"");
            if (Radius != 2) sb.Append($" Radius=\"{Radius.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(Padding) && Padding != "0 2px") sb.Append($" Padding=\"{Padding}\"");
            sb.Append(">\n");
            sb.Append($"    {LightSampleText}\n");
            sb.Append("</AtomHighlight>");
            return sb.ToString();
        }
    }

    private string TermsArrayLiteral => "new[] { " + string.Join(", ", TermsList.Select(t => $"\"{t}\"")) + " }";
}
