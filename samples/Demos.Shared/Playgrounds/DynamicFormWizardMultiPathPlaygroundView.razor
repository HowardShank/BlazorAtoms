@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using BlazorAtoms.DynamicFormWizard
@using BlazorAtoms.DynamicFormWizard.Attributes

<PageTitle>Dynamic Form Wizard — Multi-Path Playground</PageTitle>

<h1>Dynamic Form Wizard — one model, four different paths</h1>
<p>Step 1 picks a <code>Journey</code>. All four behaviors live in the <em>same</em> POCO --
   nothing but <code>[DependsOn]</code>/<code>[FormPathEnd]</code> placement changes the shape of
   the walk:</p>
<ul>
    <li><strong>Quick</strong> -- exactly 2 steps (<code>[FormPathEnd]</code> stops it right after step 2).</li>
    <li><strong>Detailed</strong> -- exactly 4 steps (<code>[FormPathEnd]</code> stops it after step 4, never reaching the shared step 5).</li>
    <li><strong>Guided</strong> and <strong>Complete</strong> -- diverge with their own content on steps 2-3, then merge back onto the same shared step 5 (no <code>[DependsOn]</code> there at all -- Guided gets there by skipping the empty step 4; Complete gets there by walking every single step from start to end).</li>
</ul>
<p><a href="playground/dynamicformwizard">&larr; Back to the main Dynamic Form Wizard playground</a></p>
<p><code>ShowCancelButton</code>/<code>OnWizardCancel</code> (#137) and Save/Load draft (#134) work
   here too -- try saving mid-way through the <strong>Detailed</strong> or <strong>Complete</strong>
   path, then loading the draft back: <code>InitialStep</code> resumes at the exact declared step
   number saved, regardless of which path got you there.</p>

<div class="dfw-columns">
    <div class="dfw-wizard">
        @if (_completed is not null)
        {
            <p><strong>Submitted!</strong> Journey=@_completed.Path</p>
            <button type="button" @onclick="Reset">Start over</button>
        }
        else if (_cancelled)
        {
            <p><strong>Cancelled.</strong> Nothing was submitted.</p>
            <button type="button" @onclick="Reset">Start over</button>
        }
        else
        {
            <div class="dfw-draft-controls">
                <button type="button" @onclick="SaveDraft">Save draft</button>
                <button type="button" @onclick="LoadDraft" disabled="@(_savedDraftJson is null)">Resume saved draft</button>
            </div>
            @if (_draftStatus is not null)
            {
                <p><em>@_draftStatus</em></p>
            }
            @if (_savedDraftJson is not null)
            {
                <pre class="dfw-draft-json"><code>@_savedDraftJson</code></pre>
            }
            <DynamicWizard @ref="_wizardRef" @key="_wizardInstanceKey" TModel="MultiPathModel" Model="_model"
                           OnWizardComplete="HandleComplete" OnWizardCancel="HandleCancel" ShowCancelButton="true"
                           InitialStep="_initialStep" />
        }
    </div>

    <div class="dfw-source">
        <h2>The POCO</h2>
        <pre><code>@PocoSource</code></pre>
    </div>
</div>

@code {
    private MultiPathModel _model = new();
    private MultiPathModel? _completed;
    private bool _cancelled;

    private DynamicWizard<MultiPathModel>? _wizardRef;
    private int? _initialStep;
    private int _wizardInstanceKey;
    private string? _savedDraftJson;
    private string? _draftStatus;

    private record DraftSnapshot(MultiPathModel Model, int Step);

    private void HandleComplete(MultiPathModel model) => _completed = model;

    private void HandleCancel(MultiPathModel model) => _cancelled = true;

    private void Reset()
    {
        _model = new();
        _completed = null;
        _cancelled = false;
        _initialStep = null;
        _savedDraftJson = null;
        _draftStatus = null;
    }

    private void SaveDraft()
    {
        var step = _wizardRef?.CurrentStep ?? 1;
        _savedDraftJson = JsonSerializer.Serialize(new DraftSnapshot(_model, step));
        _draftStatus = $"Draft saved at step {step}.";
    }

    private void LoadDraft()
    {
        if (_savedDraftJson is null)
        {
            return;
        }

        var snapshot = JsonSerializer.Deserialize<DraftSnapshot>(_savedDraftJson)!;
        _model = snapshot.Model;
        _initialStep = snapshot.Step;
        _wizardInstanceKey++;
        _draftStatus = $"Draft loaded -- resumed at step {snapshot.Step}.";
    }

    public enum Journey { Quick, Detailed, Guided, Complete }

    public class MultiPathModel
    {
        [FormStep(1, "Choose Your Path")]
        public Journey Path { get; set; } = Journey.Quick;

        // Quick's true end -- 2 steps total (1, 2), never reaches step 3+.
        [FormStep(2)]
        [DependsOn(nameof(Path), Journey.Quick)]
        [FormPathEnd(nameof(Path), Journey.Quick)]
        public string QuickNote { get; set; } = string.Empty;

        [FormStep(2)]
        [DependsOn(nameof(Path), Journey.Detailed)]
        public string DetailedStepA { get; set; } = string.Empty;

        [FormStep(2)]
        [DependsOn(nameof(Path), Journey.Guided)]
        public string GuidedStepA { get; set; } = string.Empty;

        [FormStep(2)]
        [DependsOn(nameof(Path), Journey.Complete)]
        public string CompleteStepA { get; set; } = string.Empty;

        [FormStep(3)]
        [DependsOn(nameof(Path), Journey.Detailed)]
        public string DetailedStepB { get; set; } = string.Empty;

        [FormStep(3)]
        [DependsOn(nameof(Path), Journey.Guided)]
        public string GuidedStepB { get; set; } = string.Empty;

        [FormStep(3)]
        [DependsOn(nameof(Path), Journey.Complete)]
        public string CompleteStepB { get; set; } = string.Empty;

        // Detailed's true end -- 4 steps total (1, 2, 3, 4), never reaches the shared step 5.
        [FormStep(4)]
        [DependsOn(nameof(Path), Journey.Detailed)]
        [FormPathEnd(nameof(Path), Journey.Detailed)]
        public string DetailedStepC { get; set; } = string.Empty;

        // Guided has nothing here -- it skips step 4 entirely and lands on step 5 next.
        [FormStep(4)]
        [DependsOn(nameof(Path), Journey.Complete)]
        public string CompleteStepC { get; set; } = string.Empty;

        // Unconditional -- Guided (1,2,3,5) and Complete (1,2,3,4,5) both merge back here.
        [FormStep(5, "Review")]
        public string ReviewNotes { get; set; } = string.Empty;
    }

    private const string PocoSource = """
        public enum Journey { Quick, Detailed, Guided, Complete }

        public class MultiPathModel
        {
            [FormStep(1, "Choose Your Path")]
            public Journey Path { get; set; } = Journey.Quick;

            // Quick's true end -- 2 steps total, never reaches step 3+.
            [FormStep(2)]
            [DependsOn(nameof(Path), Journey.Quick)]
            [FormPathEnd(nameof(Path), Journey.Quick)]
            public string QuickNote { get; set; } = string.Empty;

            [FormStep(2)] [DependsOn(nameof(Path), Journey.Detailed)]
            public string DetailedStepA { get; set; } = string.Empty;

            [FormStep(2)] [DependsOn(nameof(Path), Journey.Guided)]
            public string GuidedStepA { get; set; } = string.Empty;

            [FormStep(2)] [DependsOn(nameof(Path), Journey.Complete)]
            public string CompleteStepA { get; set; } = string.Empty;

            [FormStep(3)] [DependsOn(nameof(Path), Journey.Detailed)]
            public string DetailedStepB { get; set; } = string.Empty;

            [FormStep(3)] [DependsOn(nameof(Path), Journey.Guided)]
            public string GuidedStepB { get; set; } = string.Empty;

            [FormStep(3)] [DependsOn(nameof(Path), Journey.Complete)]
            public string CompleteStepB { get; set; } = string.Empty;

            // Detailed's true end -- 4 steps total, never reaches the shared step 5.
            [FormStep(4)]
            [DependsOn(nameof(Path), Journey.Detailed)]
            [FormPathEnd(nameof(Path), Journey.Detailed)]
            public string DetailedStepC { get; set; } = string.Empty;

            // Guided has nothing here -- skips step 4, lands on step 5 next.
            [FormStep(4)] [DependsOn(nameof(Path), Journey.Complete)]
            public string CompleteStepC { get; set; } = string.Empty;

            // Unconditional -- Guided (1,2,3,5) and Complete (1,2,3,4,5) merge back here.
            [FormStep(5, "Review")]
            public string ReviewNotes { get; set; } = string.Empty;
        }
        """;
}

<style>
    .dfw-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
    }

    .dfw-source pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .dfw-draft-controls {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .dfw-draft-json {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.8rem;
        line-height: 1.5;
        max-height: 12rem;
        overflow-y: auto;
    }

    @@media (max-width: 900px) {
        .dfw-columns {
            grid-template-columns: 1fr;
        }
    }
</style>
