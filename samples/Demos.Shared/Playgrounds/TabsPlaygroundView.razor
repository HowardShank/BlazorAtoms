                                Panel content for <code>@key</code>. The panel is focusable, so Tab out
                                of the strip lands here.
                            </p>
                        }
                    </AtomTabPanel>
                }
            </Panels>
        </AtomTabs>
    </section>

    <section class="tab-case">
        <h2>Variant &times; Orientation</h2>
        <p class="note">Current Size / Effect / Align apply. Each set has its own independent selection
           and its own generated id prefix.</p>
        <div class="tab-matrix">
            @foreach (var variant in Variants)
            {
                <div class="tab-matrix-cell">
                    <code>@variant</code>
                    <AtomTabs Value="one" Variant="@variant" Size="@SizeSel" Effect="@EffectSel"
                              Align="@AlignSel" AriaLabel="@($"{variant} sample")">
                        <TabList>
                            <AtomTab Value="one" Title="One" />
                            <AtomTab Value="two" Title="Two" />
                        </TabList>
                        <Panels>
                            <AtomTabPanel Value="one">First.</AtomTabPanel>
                            <AtomTabPanel Value="two">Second.</AtomTabPanel>
                        </Panels>
                    </AtomTabs>
                </div>
            }
        </div>
    </section>
</div>

<p class="tab-log">Bound value: <code>@(string.IsNullOrEmpty(ActiveTab) ? "(unset — first tab shown)" : ActiveTab)</code>
   &middot; changes: <code>@_changes</code></p>

<CodeSnippetBox Code="@Snippet" FileName="TabsExample.razor" />

<style>
    .tab-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(215px,1fr)); gap:1rem 1.5rem; }
    .tab-controls { background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; margin-bottom:1.5rem; }
    .tab-controls .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .tab-controls label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .tab-controls label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .tab-controls input[type=range] { width:100%; accent-color:#2563eb; }
    .tab-controls input[type=text], .tab-controls select
        { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; min-width:0; }
    .tab-controls .row { display:flex; align-items:center; gap:.5rem; }
    .tab-controls .row input[type=checkbox] { accent-color:#2563eb; width:16px; height:16px; flex:none; }
    .tab-controls .row.color input[type=color] { flex:none; width:38px; height:32px; padding:2px; background:#070b10; border:1px solid #1b2330; border-radius:6px; cursor:pointer; }
    .tab-controls .row.color input[type=text] { flex:1 1 auto; min-width:0; }
    .tab-controls .row label.inline { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
    .tab-controls .clr-btn { flex:none; padding:.35rem .55rem; border:1px solid #1b2330; background:#161d29; color:#cfd8e3; border-radius:6px; cursor:pointer; font-size:.75rem; }
    .tab-controls .clr-btn:hover { background:#1e2836; }
    .note { font-size:.75rem; color:#5fb7c9; font-family:ui-monospace,monospace; }

    .tab-stage { display:flex; flex-direction:column; gap:1.25rem; }
    .tab-case { border:1px solid #e2e8f0; border-radius:12px; padding:1.25rem 1.5rem; }
    .tab-case h2 { margin:0 0 .75rem; font-size:1rem; font-family:ui-monospace,Consolas,monospace; color:#334155; }
    .tab-case > .note { display:block; margin-bottom:.75rem; color:#64748b; }
    .tab-case h3 { margin:0 0 .5rem; font-size:.95rem; }

    .tab-matrix { display:grid; grid-template-columns:repeat(auto-fit,minmax(17rem,1fr)); gap:1.5rem; }
    .tab-matrix-cell > code { display:block; margin-bottom:.4rem; font-size:.8rem; color:#64748b; }

    .tab-probe { padding:.4rem .5rem; border:1px solid #cbd5e1; border-radius:6px; font:inherit; font-size:.85rem; }
    .tab-log { font-family:ui-monospace,monospace; font-size:.8rem; color:#64748b; }
</style>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private static readonly TabsVariant[] Variants = Enum.GetValues<TabsVariant>();
    private static readonly TabsSize[] Sizes = Enum.GetValues<TabsSize>();
    private static readonly TabsOrientation[] Orientations = Enum.GetValues<TabsOrientation>();
    private static readonly TabsAlign[] Aligns = Enum.GetValues<TabsAlign>();
    private static readonly TabsEffect[] Effects = Enum.GetValues<TabsEffect>();
    private static readonly TabsActivation[] Activations = Enum.GetValues<TabsActivation>();
    private static readonly TabPanelRender[] PanelRenders = Enum.GetValues<TabPanelRender>();

    private TabsVariant VariantSel = TabsVariant.Line;
    private TabsSize SizeSel = TabsSize.Medium;
    private TabsOrientation OrientationSel = TabsOrientation.Horizontal;
    private TabsAlign AlignSel = TabsAlign.Start;
    private TabsEffect EffectSel = TabsEffect.None;
    private TabsActivation ActivationSel = TabsActivation.Automatic;
    private TabPanelRender PanelRenderSel = TabPanelRender.Active;

    /// <summary>Backing text for the tab set. Parsed rather than bound directly, since no native input
    /// edits a collection.</summary>
    private string TabsCsv = "Alpha, Bravo, Charlie";

    private IReadOnlyList<string> TabKeys =>
        TabsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>Deliberately starts empty, to show the container falling back to the first tab without
    /// writing anything into the bound field.</summary>
    private string ActiveTab
    {
        get => _activeTab;
        set { _activeTab = value; _changes++; }
    }

    private string _activeTab = "";
    private int _changes;

    private bool ShowIcons;
    private bool ShowBadge = true;
    private bool CustomCaption;
    private bool DisableThird;
    private bool ScrollableV;
    private bool VisibleV = true;
    private string AriaLabelV = "Account settings";

    private double IndicatorThicknessV;
    private double RadiusV = -1;
    private double PanelPaddingV = -1;
    private double Panel1PaddingV = -1;
    private double GapV = -1;
    private double FontSizeV;
    private double DurationV;

    private string AccentColorV = "";
    private string TabColorV = "";
    private string ActiveTabColorV = "";
    private string IndicatorColorV = "";
    private string BorderColorV = "";
    private string PanelBgV = "";
    private string CssClassV = "";
    private string StyleV = "";

    private string AccentPick { get => Hex(AccentColorV, "#2563eb"); set => AccentColorV = value; }
    private string TabPick { get => Hex(TabColorV, "#64748b"); set => TabColorV = value; }
    private string ActiveTabPick { get => Hex(ActiveTabColorV, "#2563eb"); set => ActiveTabColorV = value; }
    private string IndicatorPick { get => Hex(IndicatorColorV, "#2563eb"); set => IndicatorColorV = value; }
    private string BorderPick { get => Hex(BorderColorV, "#e2e8f0"); set => BorderColorV = value; }
    private string PanelBgPick { get => Hex(PanelBgV, "#ffffff"); set => PanelBgV = value; }

    // ---- fragments ---------------------------------------------------------------------------

    private static readonly RenderFragment CustomFirstCaption = b => b.AddMarkupContent(0,
        "<em>Custom</em>&nbsp;<strong>caption</strong>");

    /// <summary>Three simple glyphs cycled by index, so the Icon slot is exercised on every tab
    /// whatever the tab count.</summary>
    private static RenderFragment IconFor(int index) => (index % 3) switch
    {
        0 => GearIcon,
        1 => CardIcon,
        _ => BellIcon,
    };

    private static readonly RenderFragment GearIcon = b => b.AddMarkupContent(0,
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">" +
        "<circle cx=\"12\" cy=\"12\" r=\"3.5\"/><path d=\"M12 2v3M12 19v3M2 12h3M19 12h3\" stroke-linecap=\"round\"/></svg>");

    private static readonly RenderFragment CardIcon = b => b.AddMarkupContent(0,
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">" +
        "<rect x=\"2.5\" y=\"5\" width=\"19\" height=\"14\" rx=\"2\"/><path d=\"M2.5 10h19\"/></svg>");

    private static readonly RenderFragment BellIcon = b => b.AddMarkupContent(0,
        "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\">" +
        "<path d=\"M6 9a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6\"/><path d=\"M10 20a2 2 0 0 0 4 0\"/></svg>");

    // ---- helpers -----------------------------------------------------------------------------

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    /// <summary>0 means "leave the parameter unset" for sliders whose zero has no useful meaning.</summary>
    private static double? Opt(double v) => v > 0 ? v : null;

    /// <summary>For sliders where 0 IS meaningful (Radius, Gap, padding), -1 is the unset sentinel.</summary>
    private static double? Signed(double v) => v >= 0 ? v : null;

    private static string Hex(string v, string fallback) =>
        v.StartsWith('#') && (v.Length == 7 || v.Length == 4) ? v : fallback;

    // ---- generated snippet -------------------------------------------------------------------

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            const string i = "          ";
            var keys = TabKeys;

            sb.Append("<AtomTabs @bind-Value=\"_tab\"");
            if (VariantSel != TabsVariant.Line) sb.Append($"\n{i}Variant=\"TabsVariant.{VariantSel}\"");
            if (SizeSel != TabsSize.Medium) sb.Append($"\n{i}Size=\"TabsSize.{SizeSel}\"");
            if (OrientationSel != TabsOrientation.Horizontal)
                sb.Append($"\n{i}Orientation=\"TabsOrientation.{OrientationSel}\"");
            if (AlignSel != TabsAlign.Start) sb.Append($"\n{i}Align=\"TabsAlign.{AlignSel}\"");
            if (EffectSel != TabsEffect.None) sb.Append($"\n{i}Effect=\"TabsEffect.{EffectSel}\"");
            if (ActivationSel != TabsActivation.Automatic)
                sb.Append($"\n{i}ActivationMode=\"TabsActivation.{ActivationSel}\"");
            if (PanelRenderSel != TabPanelRender.Active)
                sb.Append($"\n{i}PanelRender=\"TabPanelRender.{PanelRenderSel}\"");
            if (ScrollableV) sb.Append($"\n{i}Scrollable=\"true\"");
            if (!VisibleV) sb.Append($"\n{i}Visible=\"false\"");
            if (!string.IsNullOrEmpty(AriaLabelV)) sb.Append($"\n{i}AriaLabel=\"{AriaLabelV}\"");
            if (!string.IsNullOrEmpty(AccentColorV)) sb.Append($"\n{i}AccentColor=\"{AccentColorV}\"");
            if (!string.IsNullOrEmpty(TabColorV)) sb.Append($"\n{i}TabColor=\"{TabColorV}\"");
            if (!string.IsNullOrEmpty(ActiveTabColorV)) sb.Append($"\n{i}ActiveTabColor=\"{ActiveTabColorV}\"");
            if (!string.IsNullOrEmpty(IndicatorColorV)) sb.Append($"\n{i}IndicatorColor=\"{IndicatorColorV}\"");
            if (IndicatorThicknessV > 0) sb.Append($"\n{i}IndicatorThickness=\"{IndicatorThicknessV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(BorderColorV)) sb.Append($"\n{i}BorderColor=\"{BorderColorV}\"");
            if (!string.IsNullOrEmpty(PanelBgV)) sb.Append($"\n{i}PanelBackgroundColor=\"{PanelBgV}\"");
            if (RadiusV >= 0) sb.Append($"\n{i}Radius=\"{RadiusV.ToString(Inv)}\"");
            if (PanelPaddingV >= 0) sb.Append($"\n{i}PanelPadding=\"{PanelPaddingV.ToString(Inv)}\"");
            if (GapV >= 0) sb.Append($"\n{i}Gap=\"{GapV.ToString(Inv)}\"");
            if (FontSizeV > 0) sb.Append($"\n{i}FontSize=\"{FontSizeV.ToString(Inv)}\"");
            if (DurationV > 0) sb.Append($"\n{i}Duration=\"{DurationV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(CssClassV)) sb.Append($"\n{i}CssClass=\"{CssClassV}\"");
            if (!string.IsNullOrEmpty(StyleV)) sb.Append($"\n{i}Style=\"{StyleV}\"");
            sb.Append(">\n");

            sb.Append("    <TabList>\n");
            for (var t = 0; t < keys.Count; t++)
            {
                var key = keys[t];
                sb.Append($"        <AtomTab Value=\"{key}\"");
                if (!(CustomCaption && t == 0)) sb.Append($" Title=\"{key}\"");
                if (ShowBadge && t == 1) sb.Append(" Badge=\"3\"");
                if (DisableThird && t == 2) sb.Append(" Disabled=\"true\"");

                var hasSlots = ShowIcons || (CustomCaption && t == 0);
                if (!hasSlots)
                {
                    sb.Append(" />\n");
                    continue;
                }

                sb.Append(">\n");
                if (ShowIcons) sb.Append("            <Icon><svg …/></Icon>\n");
                if (CustomCaption && t == 0)
                    sb.Append("            <ChildContent><em>Custom</em> <strong>caption</strong></ChildContent>\n");
                sb.Append("        </AtomTab>\n");
            }
            sb.Append("    </TabList>\n");

            sb.Append("    <Panels>\n");
            for (var t = 0; t < keys.Count; t++)
            {
                sb.Append($"        <AtomTabPanel Value=\"{keys[t]}\"");
                if (t == 0 && Panel1PaddingV >= 0) sb.Append($" Padding=\"{Panel1PaddingV.ToString(Inv)}\"");
                sb.Append($">\n            <p>{keys[t]} content.</p>\n        </AtomTabPanel>\n");
            }
            sb.Append("    </Panels>\n");
            sb.Append("</AtomTabs>");

            return sb.ToString();
        }
    }
}
