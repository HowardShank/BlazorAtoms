@using BlazorAtoms.Barcodes

<PageTitle>AtomBarcode — Blazor Atoms</PageTitle>

<h1>AtomBarcode</h1>
<p>Linear (1D) barcodes as pure inline SVG — no JavaScript, no dependencies. Choose a symbology and type a value;
   input that's invalid for the chosen symbology shows an inline error tile.</p>

<div class="ba-stage">
    <AtomBarcode @ref="_barcode" Value="@Value" Symbology="@Symbology" Height="@Height" ModuleWidth="@ModuleWidth"
                 Color="@Color" Background="@(UseBackground ? Background : null)" ShowText="@ShowText"
                 QuietZone="@QuietZone" SvgClass="@Nz(SvgClass)"
                 Href="@Nz(LinkHref)" AutoLink="@AutoLink" LinkTarget="@LinkTarget"
                 CssClass="@Nz(HatchClass)" Style="@Nz(HatchStyle)" title="@Nz(HatchTitle)" />
</div>

<div class="ba-link">
    <div class="ba-ctrl ba-wide">
        <label>Explicit Href (wins over AutoLink)</label>
        <input type="text" @bind="LinkHref" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ba-ctrl">
        <label>AutoLink from Value</label>
        <div class="row">
            <input type="checkbox" id="baAutoLink" @bind="AutoLink" />
            <label for="baAutoLink" class="inline">http/https/mailto/tel only</label>
        </div>
    </div>
    <div class="ba-ctrl">
        <label>Link target</label>
        <input type="text" @bind="LinkTarget" @bind:event="oninput" placeholder="_blank" />
    </div>
</div>

<div class="ba-export">
    <div class="ba-export-row">
        <label>Format</label>
        <select @bind="ExportFormat">
            @foreach (var f in ExportFormats) { <option value="@f">@f</option> }
        </select>
        <label>Filename</label>
        <input type="text" @bind="SaveFileName" @bind:event="oninput" placeholder="barcode.svg" />
        <button type="button" @onclick="DoCopy">Copy</button>
        <button type="button" @onclick="DoSave">Save</button>
    </div>
    @if (!string.IsNullOrEmpty(ExportStatus))
    {
        <div class="ba-export-status @(ExportError ? "err" : "ok")">@ExportStatus</div>
    }
</div>

<div class="ba-controls">
    <div class="ba-ctrl ba-wide">
        <label>Value</label>
        <input type="text" @bind="Value" @bind:event="oninput" />
    </div>
    <div class="ba-ctrl">
        <label>Symbology</label>
        <select @bind="Symbology">
            @foreach (var s in Symbologies) { <option value="@s">@s</option> }
        </select>
    </div>
    <div class="ba-ctrl">
        <label>Module width <span class="val">@ModuleWidth.ToString(Inv)px</span></label>
        <input type="range" min="1" max="5" step="0.5" @bind="ModuleWidth" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ba-ctrl">
        <label>Height <span class="val">@((int)Height)px</span></label>
        <input type="range" min="30" max="140" step="2" @bind="Height" @bind:event="oninput" />
    </div>
    <div class="ba-ctrl">
        <label>Bar color <span class="val">@Color</span></label>
        <input type="color" @bind="Color" @bind:event="oninput" />
    </div>
    <div class="ba-ctrl">
        <label>Background</label>
        <div class="row">
            <input type="checkbox" @bind="UseBackground" />
            <input type="color" @bind="Background" @bind:event="oninput" disabled="@(!UseBackground)" />
        </div>
    </div>
    <div class="ba-ctrl">
        <label>Text</label>
        <div class="row">
            <input type="checkbox" id="baText" @bind="ShowText" />
            <label for="baText" class="inline">Show human-readable value</label>
        </div>
    </div>
    <div class="ba-ctrl">
        <label>Quiet zone <span class="val">@QuietZone</span></label>
        <input type="range" min="0" max="20" step="1" @bind="QuietZone" @bind:event="oninput" />
    </div>
    <div class="ba-ctrl">
        <label>Svg class (SvgClass)</label>
        <input type="text" @bind="SvgClass" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ba-ctrl">
        <label>Extra class (CssClass)</label>
        <input type="text" @bind="HatchClass" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ba-ctrl">
        <label>Extra style (Style)</label>
        <input type="text" @bind="HatchStyle" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ba-ctrl">
        <label>title attr (splat)</label>
        <input type="text" @bind="HatchTitle" @bind:event="oninput" placeholder="(none)" />
    </div>
</div>

<p class="ba-hint">
    <code>Code128</code>: ASCII 32–126 · <code>Code39</code>: A–Z 0–9 and <code>- . $ / + %</code> ·
    <code>Ean13</code>/<code>UpcA</code>/<code>Itf</code>: digits · <code>Codabar</code>: digits and <code>- $ : / . +</code>.
</p>

<CodeSnippetBox Code="@Snippet" FileName="AtomBarcodeExample.razor" />

<style>
    .ba-stage { background:#fff; border:1px solid #d0d0d8; border-radius:12px; padding:1.5rem; text-align:center; margin-bottom:1.5rem; overflow-x:auto; }
    .ba-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:1rem 1.5rem; background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; }
    .ba-ctrl { display:flex; flex-direction:column; gap:.35rem; }
    .ba-ctrl.ba-wide { grid-column:1 / -1; }
    .ba-ctrl label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; }
    .ba-ctrl label .val { color:#5fb7c9; font-family:ui-monospace,monospace; text-transform:none; }
    .ba-ctrl input[type=text] { padding:.5rem .6rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .ba-ctrl select { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; }
    .ba-ctrl input[type=range] { width:100%; accent-color:#00b3c4; }
    .ba-ctrl input[type=color] { width:100%; height:32px; background:none; border:1px solid #1b2330; border-radius:6px; padding:2px; }
    .ba-ctrl .row { display:flex; align-items:center; gap:.5rem; }
    .ba-ctrl .row input[type=checkbox] { accent-color:#00b3c4; width:16px; height:16px; }
    .ba-ctrl .row label.inline { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; }
    .ba-hint { color:#6b7785; font-size:.85rem; margin-top:1rem; }
    .ba-link { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:1rem 1.5rem; background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1rem 1.25rem; margin:1rem 0; color:#cfd8e3; }
    .ba-export { background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1rem 1.25rem; margin:1rem 0; color:#cfd8e3; }
    .ba-export-row { display:flex; flex-wrap:wrap; align-items:center; gap:.6rem; }
    .ba-export-row label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; }
    .ba-export-row select, .ba-export-row input { padding:.4rem .55rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .ba-export-row button { padding:.45rem .9rem; border-radius:6px; border:1px solid #00b3c4; background:#00b3c4; color:#001417; font-weight:600; cursor:pointer; }
    .ba-export-row button:hover { background:#22c9d9; }
    .ba-export-status { margin-top:.6rem; font-family:ui-monospace,monospace; font-size:.85rem; }
    .ba-export-status.ok { color:#5fb7c9; }
    .ba-export-status.err { color:#e5787a; }
</style>

@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly BarcodeSymbology[] Symbologies = (BarcodeSymbology[])Enum.GetValues(typeof(BarcodeSymbology));
    private static readonly BarcodeExportFormat[] ExportFormats = (BarcodeExportFormat[])Enum.GetValues(typeof(BarcodeExportFormat));

    private AtomBarcode? _barcode;
    private string LinkHref = "";
    private bool AutoLink = false;
    private string LinkTarget = "_blank";
    private BarcodeExportFormat ExportFormat = BarcodeExportFormat.Svg;
    private string SaveFileName = "barcode.svg";
    private string ExportStatus = "";
    private bool ExportError;

    private async Task DoCopy()
    {
        if (_barcode is null) return;
        try
        {
            await _barcode.CopyAsync(ExportFormat);
            ExportError = false;
            ExportStatus = $"Copied {ExportFormat} to clipboard.";
        }
        catch (BarcodeExportException ex)
        {
            ExportError = true;
            ExportStatus = ex.Message;
        }
    }

    private async Task DoSave()
    {
        if (_barcode is null) return;
        try
        {
            await _barcode.SaveAsync(ExportFormat, SaveFileName);
            ExportError = false;
            ExportStatus = $"Saved {ExportFormat} as {SaveFileName}.";
        }
        catch (BarcodeExportException ex)
        {
            ExportError = true;
            ExportStatus = ex.Message;
        }
    }

    private string Value = "BLAZORATOMS-123";
    private BarcodeSymbology Symbology = BarcodeSymbology.Code128;
    private double Height = 70;
    private double ModuleWidth = 2;
    private string Color = "#111111";
    private bool UseBackground = true;
    private string Background = "#ffffff";
    private bool ShowText = true;
    private int QuietZone = 10;

    private string SvgClass = "";
    private string HatchClass = "";
    private string HatchStyle = "";
    private string HatchTitle = "";

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<AtomBarcode");
            sb.Append($" Value=\"{Value}\"");
            if (Symbology != BarcodeSymbology.Code128) sb.Append($" Symbology=\"BarcodeSymbology.{Symbology}\"");
            if (Height != 60) sb.Append($" Height=\"{Height.ToString(Inv)}\"");
            if (ModuleWidth != 2) sb.Append($" ModuleWidth=\"{ModuleWidth.ToString(Inv)}\"");
            if (QuietZone != 10) sb.Append($" QuietZone=\"{QuietZone}\"");
            if (Color != "#000000") sb.Append($" Color=\"{Color}\"");
            if (UseBackground) sb.Append($" Background=\"{Background}\"");
            if (!ShowText) sb.Append(" ShowText=\"false\"");
            if (!string.IsNullOrEmpty(SvgClass)) sb.Append($" SvgClass=\"{SvgClass}\"");
            if (!string.IsNullOrEmpty(HatchClass)) sb.Append($" CssClass=\"{HatchClass}\"");
            if (!string.IsNullOrEmpty(HatchStyle)) sb.Append($" Style=\"{HatchStyle}\"");
            if (!string.IsNullOrEmpty(HatchTitle)) sb.Append($" title=\"{HatchTitle}\"");
            sb.Append(" />");
            return sb.ToString();
        }
    }
}
