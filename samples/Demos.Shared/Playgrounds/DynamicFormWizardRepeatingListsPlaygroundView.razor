@using System.ComponentModel.DataAnnotations
@using System.Text.Json
@using BlazorAtoms.DynamicFormWizard
@using BlazorAtoms.DynamicFormWizard.Attributes
@using BlazorAtoms.DynamicFormWizard.Validators

<PageTitle>Dynamic Form Wizard — Repeating Lists &amp; DependsOn Operators Playground</PageTitle>

<h1>Dynamic Form Wizard — repeating <code>List&lt;T&gt;</code> + richer <code>DependsOn</code></h1>
<p>Step 1: an age field gates a "Working-age discount" field using two stacked
   <code>[DependsOn]</code> conditions -- <code>GreaterThanOrEqual 18</code> AND
   <code>LessThanOrEqual 65</code> -- a range expressed by reusing the existing AND-combine rule,
   no new construct needed.</p>
<p>Step 2: <code>List&lt;string&gt;</code> renders as a repeatable row of single inputs (tier 1b,
   scalar item shape) with Add/Remove.</p>
<p>Step 3: <code>List&lt;Beneficiary&gt;</code> renders one <code>&lt;fieldset&gt;</code> sub-form
   per item (tier 1b, complex item shape), each validated on its own
   (<code>[Required]</code> on <code>Name</code>), plus <code>[MinItemCount]</code>/
   <code>[MaxItemCount]</code> on the list itself. Check a beneficiary's <strong>Primary</strong>
   checkbox to reveal that <em>same row's</em> Note field -- <code>Note</code>'s
   <code>[DependsOn(nameof(IsPrimary), true)]</code> resolves against that item instance itself, not
   the top-level model, so toggling one row never affects any other row (DESIGN-DISCUSSION.md
   section M.2, #138).</p>
<p><a href="playground/dynamicformwizard">&larr; Back to the main Dynamic Form Wizard playground</a></p>
<p><code>ShowCancelButton</code>/<code>OnWizardCancel</code> (#137) and Save/Load draft (#134) work
   here too -- including <code>Tags</code>/<code>Beneficiaries</code>, both plain
   <code>List&lt;T&gt;</code> and neither needing any special handling to round-trip through
   <code>System.Text.Json</code>.</p>

<div class="dfw-columns">
    <div class="dfw-wizard">
        @if (_completed is not null)
        {
            <p><strong>Submitted!</strong></p>
            <dl class="dfw-summary">
                <dt>Age</dt><dd>@_completed.Age</dd>
                <dt>WorkingAgeDiscount</dt><dd>@_completed.WorkingAgeDiscount</dd>
                <dt>Tags</dt><dd>@string.Join(", ", _completed.Tags)</dd>
                <dt>Beneficiaries</dt>
                <dd>
                    @foreach (var b in _completed.Beneficiaries)
                    {
                        <div>
                            @b.Name -- @b.SharePercent%
                            @if (b.IsPrimary)
                            {
                                <text> (Primary@(string.IsNullOrEmpty(b.Note) ? "" : $": {b.Note}"))</text>
                            }
                        </div>
                    }
                </dd>
            </dl>
            <button type="button" @onclick="Reset">Start over</button>
        }
        else if (_cancelled)
        {
            <p><strong>Cancelled.</strong> Nothing was submitted.</p>
            <button type="button" @onclick="Reset">Start over</button>
        }
        else
        {
            <div class="dfw-draft-controls">
                <button type="button" @onclick="SaveDraft">Save draft</button>
                <button type="button" @onclick="LoadDraft" disabled="@(_savedDraftJson is null)">Resume saved draft</button>
            </div>
            @if (_draftStatus is not null)
            {
                <p><em>@_draftStatus</em></p>
            }
            @if (_savedDraftJson is not null)
            {
                <pre class="dfw-draft-json"><code>@_savedDraftJson</code></pre>
            }
            <DynamicWizard @ref="_wizardRef" @key="_wizardInstanceKey" TModel="ApplicationModel" Model="_model"
                           OnWizardComplete="HandleComplete" OnWizardCancel="HandleCancel" ShowCancelButton="true"
                           InitialStep="_initialStep" />
        }
    </div>

    <div class="dfw-source">
        <h2>The POCO</h2>
        <pre><code>@PocoSource</code></pre>
    </div>
</div>

@code {
    private ApplicationModel _model = new();
    private ApplicationModel? _completed;
    private bool _cancelled;

    private DynamicWizard<ApplicationModel>? _wizardRef;
    private int? _initialStep;
    private int _wizardInstanceKey;
    private string? _savedDraftJson;
    private string? _draftStatus;

    private record DraftSnapshot(ApplicationModel Model, int Step);

    private void HandleComplete(ApplicationModel model) => _completed = model;

    private void HandleCancel(ApplicationModel model) => _cancelled = true;

    private void Reset()
    {
        _model = new();
        _completed = null;
        _cancelled = false;
        _initialStep = null;
        _savedDraftJson = null;
        _draftStatus = null;
    }

    private void SaveDraft()
    {
        var step = _wizardRef?.CurrentStep ?? 1;
        _savedDraftJson = JsonSerializer.Serialize(new DraftSnapshot(_model, step));
        _draftStatus = $"Draft saved at step {step}.";
    }

    private void LoadDraft()
    {
        if (_savedDraftJson is null)
        {
            return;
        }

        var snapshot = JsonSerializer.Deserialize<DraftSnapshot>(_savedDraftJson)!;
        _model = snapshot.Model;
        _initialStep = snapshot.Step;
        _wizardInstanceKey++;
        _draftStatus = $"Draft loaded -- resumed at step {snapshot.Step}.";
    }

    public class Beneficiary
    {
        [Required(ErrorMessage = "Name is required.")]
        public string Name { get; set; } = string.Empty;

        public int SharePercent { get; set; }

        public bool IsPrimary { get; set; }

        // List-item sibling [DependsOn] (DESIGN-DISCUSSION.md section M.2, #138) -- resolves
        // against THIS item instance, not the top-level model. A plain nameof works here (no
        // dotted path needed) because both properties live on the same TItem.
        [DependsOn(nameof(IsPrimary), true)]
        public string Note { get; set; } = string.Empty;
    }

    public class ApplicationModel
    {
        [FormStep(1, "Eligibility")]
        [FormOrder(1)]
        [Range(0, 120, ErrorMessage = "Enter a real age.")]
        public int Age { get; set; } = 30;

        [FormStep(1)]
        [FormOrder(2)]
        [DependsOn(nameof(Age), 18, ComparisonOperator.GreaterThanOrEqual)]
        [DependsOn(nameof(Age), 65, ComparisonOperator.LessThanOrEqual)]
        public bool WorkingAgeDiscount { get; set; }

        [FormStep(2, "Tags")]
        public List<string> Tags { get; set; } = new() { "priority" };

        [FormStep(3, "Beneficiaries")]
        [MinItemCount(1, ErrorMessage = "At least one beneficiary is required.")]
        [MaxItemCount(4, ErrorMessage = "No more than 4 beneficiaries.")]
        public List<Beneficiary> Beneficiaries { get; set; } = new() { new Beneficiary { Name = "Alice", SharePercent = 100 } };
    }

    private const string PocoSource = """
        public class Beneficiary
        {
            [Required(ErrorMessage = "Name is required.")]
            public string Name { get; set; } = string.Empty;

            public int SharePercent { get; set; }

            public bool IsPrimary { get; set; }

            [DependsOn(nameof(IsPrimary), true)]
            public string Note { get; set; } = string.Empty;
        }

        public class ApplicationModel
        {
            [FormStep(1, "Eligibility")] [FormOrder(1)]
            [Range(0, 120, ErrorMessage = "Enter a real age.")]
            public int Age { get; set; } = 30;

            [FormStep(1)] [FormOrder(2)]
            [DependsOn(nameof(Age), 18, ComparisonOperator.GreaterThanOrEqual)]
            [DependsOn(nameof(Age), 65, ComparisonOperator.LessThanOrEqual)]
            public bool WorkingAgeDiscount { get; set; }

            [FormStep(2, "Tags")]
            public List<string> Tags { get; set; } = new() { "priority" };

            [FormStep(3, "Beneficiaries")]
            [MinItemCount(1, ErrorMessage = "At least one beneficiary is required.")]
            [MaxItemCount(4, ErrorMessage = "No more than 4 beneficiaries.")]
            public List<Beneficiary> Beneficiaries { get; set; } = new() { new Beneficiary { Name = "Alice", SharePercent = 100 } };
        }
        """;
}

<style>
    .dfw-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
    }

    .dfw-source pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .dfw-draft-controls {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 0.75rem;
    }

    .dfw-draft-json {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.8rem;
        line-height: 1.5;
        max-height: 12rem;
        overflow-y: auto;
    }

    .dfw-summary {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.25rem 1rem;
    }

    .dfw-summary dt {
        font-weight: 600;
    }

    .dfw-summary dd {
        margin: 0;
    }

    @@media (max-width: 900px) {
        .dfw-columns {
            grid-template-columns: 1fr;
        }
    }
</style>
