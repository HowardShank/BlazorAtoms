@using BlazorAtoms.DragDrop

<div class="demo-note">Grid orientation — items flow left-to-right and wrap. Drag any cell to a new position.</div>

<AtomDropzone TItem="string" Items="@Cells" Orientation="DropzoneOrientation.Grid">
    <ChildContent Context="c">
        <div class="demo-grid-item">@c</div>
    </ChildContent>
</AtomDropzone>

@code {
    public List<string> Cells { get; } = new() { "1", "2", "3", "4", "5", "6", "7", "8", "9" };
}
