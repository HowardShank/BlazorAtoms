@using System.Globalization
@using BlazorAtoms.Cards

<PageTitle>Card Layout Playground</PageTitle>

<h1>Card layout playground</h1>
<p><code>AtomCard</code> plus its three sections — <code>AtomCardHeader</code>,
   <code>AtomCardBody</code>, <code>AtomCardFooter</code>. A plain structural surface, separate from the
   hover-reveal family in the same package: <code>AtomCardReveal</code> and its siblings share
   <code>AtomCardBase</code>, whose background image, accent and dot indicator all exist to serve a
   reveal animation this card doesn't have. Zero JS.</p>
<p>The root element follows the semantics: a <code>&lt;div&gt;</code> normally, a real
   <code>&lt;a&gt;</code> when <code>Href</code> is set, a <code>&lt;button&gt;</code> when only
   <code>OnClick</code> is. Section padding and dividers cascade from the card, and a section's own
   value still wins.</p>
<p><a href="playground/progress">&larr; Progress playground</a> &middot;
   <a href="playground/cardvariants">Hover-reveal card variants &rarr;</a></p>

<div class="cdl-controls">
    <div class="ctrl">
        <label>Variant</label>
        <select @bind="VariantSel">
            @foreach (var v in Variants) { <option value="@v">@v</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Elevation</label>
        <select @bind="ElevationSel">
            @foreach (var e in Elevations) { <option value="@e">@e</option> }
        </select>
        <span class="note">only Elevated draws a shadow</span>
    </div>
    <div class="ctrl">
        <label>Effect</label>
        <select @bind="EffectSel">
            @foreach (var e in Effects) { <option value="@e">@e</option> }
        </select>
        <span class="note">hover / press the card</span>
    </div>
    <div class="ctrl">
        <label>MediaPosition</label>
        <select @bind="MediaPositionSel">
            @foreach (var m in MediaPositions) { <option value="@m">@m</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>MediaSize (Start/End only)</label>
        <input type="text" @bind="MediaSizeV" @bind:event="oninput" placeholder="(33%)" />
        <span class="note">ignored for Top/Bottom, where media spans the full width</span>
    </div>
    <div class="ctrl">
        <label>Interaction</label>
        <div class="row"><input type="checkbox" id="cdlMedia" @bind="ShowMedia" /><label for="cdlMedia" class="inline">Media slot</label></div>
        <div class="row"><input type="checkbox" id="cdlClick" @bind="Clickable" /><label for="cdlClick" class="inline">OnClick (&rarr; button)</label></div>
        <div class="row"><input type="checkbox" id="cdlVis" @bind="VisibleV" /><label for="cdlVis" class="inline">Visible</label></div>
    </div>
    <div class="ctrl">
        <label>Href (link mode)</label>
        <input type="text" @bind="HrefV" @bind:event="oninput" placeholder="(renders a div/button)" />
    </div>
    <div class="ctrl">
        <label>Target</label>
        <input type="text" @bind="TargetV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>AriaLabel</label>
        <input type="text" @bind="AriaLabelV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Padding (px, -1=default) <span class="val">@PaddingV.ToString(Inv)</span></label>
        <input type="range" min="-1" max="48" step="1" @bind="PaddingV" @bind:event="oninput" @bind:culture="Inv" />
        <span class="note">cascades to every section</span>
    </div>
    <div class="ctrl">
        <label>Radius (px, -1=default) <span class="val">@RadiusV.ToString(Inv)</span></label>
        <input type="range" min="-1" max="40" step="1" @bind="RadiusV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>BorderWidth (px, -1=default) <span class="val">@BorderWidthV.ToString(Inv)</span></label>
        <input type="range" min="-1" max="8" step="1" @bind="BorderWidthV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Duration (s, 0=default) <span class="val">@DurationV.ToString(Inv)</span></label>
        <input type="range" min="0" max="2" step="0.05" @bind="DurationV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Width (CSS length)</label>
        <input type="text" @bind="WidthV" @bind:event="oninput" placeholder="(fills parent)" />
    </div>
    <div class="ctrl">
        <label>Height (CSS length)</label>
        <input type="text" @bind="HeightV" @bind:event="oninput" placeholder="(grows with content)" />
    </div>
    <div class="ctrl">
        <label>BackgroundColor</label>
        <div class="row color">
            <input type="color" @bind="BgPick" @bind:event="oninput" />
            <input type="text" @bind="BackgroundColorV" @bind:event="oninput" placeholder="(Canvas)" />
            <button type="button" class="clr-btn" @onclick="@(() => BackgroundColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>AccentColor</label>
        <div class="row color">
            <input type="color" @bind="AccentPick" @bind:event="oninput" />
            <input type="text" @bind="AccentColorV" @bind:event="oninput" placeholder="(#2563eb)" />
            <button type="button" class="clr-btn" @onclick="@(() => AccentColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>BorderColor</label>
        <div class="row color">
            <input type="color" @bind="BorderPick" @bind:event="oninput" />
            <input type="text" @bind="BorderColorV" @bind:event="oninput" placeholder="(currentColor tint)" />
            <button type="button" class="clr-btn" @onclick="@(() => BorderColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>DividerColor</label>
        <div class="row color">
            <input type="color" @bind="DividerPick" @bind:event="oninput" />
            <input type="text" @bind="DividerColorV" @bind:event="oninput" placeholder="(currentColor tint)" />
            <button type="button" class="clr-btn" @onclick="@(() => DividerColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>TextColor</label>
        <div class="row color">
            <input type="color" @bind="TextPick" @bind:event="oninput" />
            <input type="text" @bind="TextColorV" @bind:event="oninput" placeholder="(CanvasText)" />
            <button type="button" class="clr-btn" @onclick="@(() => TextColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>CssClass</label>
        <input type="text" @bind="CssClassV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Style</label>
        <input type="text" @bind="StyleV" @bind:event="oninput" placeholder="e.g. opacity:.9" />
    </div>
</div>

<div class="cdl-stage">
    @* ---- nested sections (the usual shape) ------------------------------------------------- *@
    <section class="cdl-case">
        <h2>AtomCard with nested sections</h2>
        <div class="cdl-row">
            <AtomCard Variant="@VariantSel" Elevation="@ElevationSel" Effect="@EffectSel"
                      MediaPosition="@MediaPositionSel"
                      Media="@(ShowMedia ? MediaFragment : null)"
                      MediaSize="@Nz(MediaSizeV)"
                      Href="@Nz(HrefV)" Target="@Nz(TargetV)" AriaLabel="@Nz(AriaLabelV)"
                      OnClick="@(Clickable ? EventCallback.Factory.Create<Microsoft.AspNetCore.Components.Web.MouseEventArgs>(this, () => Log("card")) : default)"
                      Padding="@Signed(PaddingV)" Divider="@CardDivider"
                      Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                      Duration="@Opt(DurationV)"
                      Width="@Nz(WidthV)" Height="@Nz(HeightV)"
                      BackgroundColor="@Nz(BackgroundColorV)" AccentColor="@Nz(AccentColorV)"
                      BorderColor="@Nz(BorderColorV)" DividerColor="@Nz(DividerColorV)"
                      TextColor="@Nz(TextColorV)"
                      Visible="@VisibleV"
                      CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)">
                <AtomCardHeader Title="@Nz(TitleV)"
                                HeadingLevel="@HeadingLevelV"
                                Subtitle="@(ShowSubtitle ? SubtitleFragment : null)"
                                Avatar="@(ShowAvatar ? AvatarFragment : null)"
                                Actions="@(ShowActions ? ActionsFragment : null)"
                                ChildContent="@(HeaderCustomContent ? HeaderContentFragment : null)"
                                Divider="@HeaderDivider"
                                Padding="@Signed(HeaderPaddingV)"
                                BackgroundColor="@Nz(HeaderBgV)" />
                <AtomCardBody Scrollable="@BodyScrollable"
                              MaxHeight="@Nz(BodyMaxHeightV)"
                              Padding="@Signed(BodyPaddingV)"
                              BackgroundColor="@Nz(BodyBgV)">
                    <p>@BodyTextV</p>
                    @if (LongBody)
                    {
                        <p>Set <code>Scrollable</code> with a <code>MaxHeight</code> and this second
                           paragraph scrolls inside the body instead of stretching the card. The
                           scroll box is focusable, so it is reachable without a mouse.</p>
                        <p>A third paragraph, to make sure there is genuinely something to scroll.</p>
                    }
                </AtomCardBody>
                <AtomCardFooter Align="@FooterAlign" Divider="@FooterDivider"
                                Padding="@Signed(FooterPaddingV)"
                                BackgroundColor="@Nz(FooterBgV)">
                    <button type="button" class="cdl-btn" @onclick="@(() => Log("footer: Cancel"))">Cancel</button>
                    <button type="button" class="cdl-btn primary" @onclick="@(() => Log("footer: Save"))">Save</button>
                </AtomCardFooter>
            </AtomCard>
        </div>
        <div class="cdl-opts">
            <div class="ctrl">
                <label>Header Title</label>
                <input type="text" @bind="TitleV" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>HeadingLevel (h1-h6) <span class="val">@HeadingLevelV</span></label>
                <input type="range" min="1" max="6" step="1" @bind="HeadingLevelV" @bind:event="oninput" />
                <span class="note">a real heading element, so the outline stays correct</span>
            </div>
            <div class="ctrl">
                <label>Header slots</label>
                <div class="row"><input type="checkbox" id="cdlSub" @bind="ShowSubtitle" /><label for="cdlSub" class="inline">Subtitle</label></div>
                <div class="row"><input type="checkbox" id="cdlAv" @bind="ShowAvatar" /><label for="cdlAv" class="inline">Avatar</label></div>
                <div class="row"><input type="checkbox" id="cdlAct" @bind="ShowActions" /><label for="cdlAct" class="inline">Actions</label></div>
                <div class="row"><input type="checkbox" id="cdlHdrCC" @bind="HeaderCustomContent" /><label for="cdlHdrCC" class="inline">ChildContent</label></div>
                <span class="note">ChildContent replaces Title + Subtitle entirely</span>
            </div>
            <div class="ctrl">
                <label>Header Padding (px, -1=inherit) <span class="val">@HeaderPaddingV.ToString(Inv)</span></label>
                <input type="range" min="-1" max="48" step="1" @bind="HeaderPaddingV" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>Header BackgroundColor</label>
                <div class="row color">
                    <input type="color" @bind="HeaderBgPick" @bind:event="oninput" />
                    <input type="text" @bind="HeaderBgV" @bind:event="oninput" placeholder="(transparent)" />
                    <button type="button" class="clr-btn" @onclick="@(() => HeaderBgV = "")">clear</button>
                </div>
            </div>
            <div class="ctrl">
                <label>Body text</label>
                <input type="text" @bind="BodyTextV" @bind:event="oninput" />
            </div>
            <div class="ctrl">
                <label>Body</label>
                <div class="row"><input type="checkbox" id="cdlLong" @bind="LongBody" /><label for="cdlLong" class="inline">Long content</label></div>
                <div class="row"><input type="checkbox" id="cdlScroll" @bind="BodyScrollable" /><label for="cdlScroll" class="inline">Scrollable</label></div>
            </div>
            <div class="ctrl">
                <label>Body MaxHeight</label>
                <input type="text" @bind="BodyMaxHeightV" @bind:event="oninput" placeholder="(none)" />
            </div>
            <div class="ctrl">
                <label>Body Padding (px, -1=inherit) <span class="val">@BodyPaddingV.ToString(Inv)</span></label>
                <input type="range" min="-1" max="48" step="1" @bind="BodyPaddingV" @bind:event="oninput" @bind:culture="Inv" />
                <span class="note">a section's own value beats the cascade</span>
            </div>
            <div class="ctrl">
                <label>Body BackgroundColor</label>
                <div class="row color">
                    <input type="color" @bind="BodyBgPick" @bind:event="oninput" />
                    <input type="text" @bind="BodyBgV" @bind:event="oninput" placeholder="(transparent)" />
                    <button type="button" class="clr-btn" @onclick="@(() => BodyBgV = "")">clear</button>
                </div>
            </div>
            <div class="ctrl">
                <label>Footer Align</label>
                <select @bind="FooterAlign">
                    @foreach (var a in Aligns) { <option value="@a">@a</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Footer Padding (px, -1=inherit) <span class="val">@FooterPaddingV.ToString(Inv)</span></label>
                <input type="range" min="-1" max="48" step="1" @bind="FooterPaddingV" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>Footer BackgroundColor</label>
                <div class="row color">
                    <input type="color" @bind="FooterBgPick" @bind:event="oninput" />
                    <input type="text" @bind="FooterBgV" @bind:event="oninput" placeholder="(transparent)" />
                    <button type="button" class="clr-btn" @onclick="@(() => FooterBgV = "")">clear</button>
                </div>
            </div>
            <div class="ctrl">
                <label>Dividers</label>
                <div class="row"><input type="checkbox" id="cdlCardDiv" @bind="CardDivider" /><label for="cdlCardDiv" class="inline">Card default</label></div>
                <div class="row"><input type="checkbox" id="cdlHdrDiv" @bind="HeaderDividerSet" /><label for="cdlHdrDiv" class="inline">Header override</label></div>
                <div class="row"><input type="checkbox" id="cdlFtrDiv" @bind="FooterDividerSet" /><label for="cdlFtrDiv" class="inline">Footer override</label></div>
                <span class="note">overrides force the rule ON regardless of the card</span>
            </div>
        </div>
    </section>

    @* ---- the same card via slots ----------------------------------------------------------- *@
    <section class="cdl-case">
        <h2>The same card via <code>Header</code>/<code>Body</code>/<code>Footer</code> slots</h2>
        <p class="note">Identical output — the slots render the section components for you. Useful when
           the content is short, or when the card is placed by a loop.</p>
        <div class="cdl-row">
            <AtomCard Variant="@VariantSel" Elevation="@ElevationSel" Effect="@EffectSel"
                      MediaPosition="@MediaPositionSel"
                      Media="@(ShowMedia ? MediaFragment : null)"
                      Padding="@Signed(PaddingV)" Divider="@CardDivider"
                      Radius="@Signed(RadiusV)" BorderWidth="@Signed(BorderWidthV)"
                      Width="@Nz(WidthV)"
                      BackgroundColor="@Nz(BackgroundColorV)" AccentColor="@Nz(AccentColorV)"
                      Header="@SlotHeader" Body="@SlotBody" Footer="@SlotFooter" />
        </div>
    </section>

    @* ---- every variant at a glance --------------------------------------------------------- *@
    <section class="cdl-case">
        <h2>Variant &times; Elevation</h2>
        <p class="note">Each row is one <code>Variant</code>; the current <code>Effect</code> applies.
           Only <code>Elevated</code> responds to <code>Elevation</code>.</p>
        @foreach (var variant in Variants)
        {
            <div class="cdl-matrix">
                <code class="cdl-matrix-name">@variant</code>
                @foreach (var elevation in Elevations)
                {
                    <AtomCard Variant="@variant" Elevation="@elevation" Effect="@EffectSel"
                              Radius="@Signed(RadiusV)" Width="8.5rem"
                              AccentColor="@Nz(AccentColorV)">
                        <AtomCardBody Padding="10">
                            <small>@elevation</small>
                        </AtomCardBody>
                    </AtomCard>
                }
            </div>
        }
    </section>

    @* ---- sections standalone --------------------------------------------------------------- *@
    <section class="cdl-case">
        <h2>Sections outside a card</h2>
        <p class="note">No cascaded <code>CardContext</code> — each section falls back to its own CSS
           defaults, so they compose into any container.</p>
        <div class="cdl-loose">
            <AtomCardHeader Title="Standalone header" />
            <AtomCardBody>Standalone body.</AtomCardBody>
            <AtomCardFooter Align="CardSectionAlign.End">
                <button type="button" class="cdl-btn" @onclick="@(() => Log("loose footer"))">OK</button>
            </AtomCardFooter>
        </div>
    </section>
</div>

<p class="cdl-log">Clicks: <code>@ClickLog</code></p>

