<style>
    .cdl-controls, .cdl-opts { display:grid; grid-template-columns:repeat(auto-fit,minmax(215px,1fr)); gap:1rem 1.5rem; }
    .cdl-controls { background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; margin-bottom:1.5rem; }
    .cdl-controls .ctrl, .cdl-opts .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .cdl-controls label, .cdl-opts label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .cdl-controls label .val, .cdl-opts label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .cdl-controls input[type=range], .cdl-opts input[type=range] { width:100%; accent-color:#2563eb; }
    .cdl-controls input[type=text], .cdl-controls select, .cdl-opts input[type=text], .cdl-opts select
        { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; min-width:0; }
    .cdl-controls .row, .cdl-opts .row { display:flex; align-items:center; gap:.5rem; }
    .cdl-controls .row input[type=checkbox], .cdl-opts .row input[type=checkbox] { accent-color:#2563eb; width:16px; height:16px; flex:none; }
    .cdl-controls .row.color input[type=color] { flex:none; width:38px; height:32px; padding:2px; background:#070b10; border:1px solid #1b2330; border-radius:6px; cursor:pointer; }
    .cdl-controls .row.color input[type=text] { flex:1 1 auto; min-width:0; }
    .cdl-controls .row label.inline, .cdl-opts .row label.inline { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
    .cdl-controls .clr-btn, .cdl-opts .clr-btn { flex:none; padding:.35rem .55rem; border:1px solid #1b2330; background:#161d29; color:#cfd8e3; border-radius:6px; cursor:pointer; font-size:.75rem; }
    .cdl-controls .clr-btn:hover { background:#1e2836; }
    .note { font-size:.75rem; color:#5fb7c9; font-family:ui-monospace,monospace; }

    .cdl-stage { display:flex; flex-direction:column; gap:1.25rem; }
    .cdl-case { border:1px solid #e2e8f0; border-radius:12px; padding:1.25rem 1.5rem; }
    .cdl-case h2 { margin:0 0 .75rem; font-size:1rem; font-family:ui-monospace,Consolas,monospace; color:#334155; }
    .cdl-case > .note { display:block; margin-bottom:.75rem; color:#64748b; }
    .cdl-row { display:flex; flex-wrap:wrap; align-items:flex-start; gap:1rem; margin-bottom:1rem; max-width:34rem; }
    .cdl-case .cdl-opts { background:#0d1118; border:1px solid #1b2330; border-radius:10px; padding:1rem 1.25rem; color:#cfd8e3; }

    .cdl-matrix { display:flex; flex-wrap:wrap; align-items:stretch; gap:1rem; padding:.75rem 0; border-bottom:1px dashed #eef2f7; }
    .cdl-matrix:last-child { border-bottom:0; }
    .cdl-matrix-name { flex:0 0 5.5rem; align-self:center; font-size:.8rem; color:#64748b; }

    .cdl-loose { max-width:26rem; border:1px dashed #cbd5e1; border-radius:8px; }

    /* Footer/header controls are the consumer's markup — the sections only place them. */
    .cdl-btn { padding:.35rem .75rem; border:1px solid #cbd5e1; border-radius:6px; background:#fff; color:#334155; font:inherit; font-size:.85rem; cursor:pointer; }
    .cdl-btn.primary { border-color:#2563eb; background:#2563eb; color:#fff; }
    .cdl-btn:hover { filter:brightness(.96); }

    .cdl-log { font-family:ui-monospace,monospace; font-size:.8rem; color:#64748b; }
</style>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private static readonly CardVariant[] Variants = Enum.GetValues<CardVariant>();
    private static readonly CardElevation[] Elevations = Enum.GetValues<CardElevation>();
    private static readonly CardEffect[] Effects = Enum.GetValues<CardEffect>();
    private static readonly CardMediaPosition[] MediaPositions = Enum.GetValues<CardMediaPosition>();
    private static readonly CardSectionAlign[] Aligns = Enum.GetValues<CardSectionAlign>();

    // ---- card surface ------------------------------------------------------------------------

    private CardVariant VariantSel = CardVariant.Elevated;
    private CardElevation ElevationSel = CardElevation.Medium;
    private CardEffect EffectSel = CardEffect.HoverLift;
    private CardMediaPosition MediaPositionSel = CardMediaPosition.Top;

    private bool ShowMedia = true;
    private string MediaSizeV = "";
    private bool Clickable;
    private bool VisibleV = true;
    private string HrefV = "";
    private string TargetV = "";
    private string AriaLabelV = "";
    private double PaddingV = -1;
    private double RadiusV = -1;
    private double BorderWidthV = -1;
    private double DurationV;
    private string WidthV = "22rem";
    private string HeightV = "";
    private string BackgroundColorV = "";
    private string AccentColorV = "";
    private string BorderColorV = "";
    private string DividerColorV = "";
    private string TextColorV = "";
    private string CssClassV = "";
    private string StyleV = "";

    private string BgPick { get => Hex(BackgroundColorV, "#ffffff"); set => BackgroundColorV = value; }
    private string AccentPick { get => Hex(AccentColorV, "#2563eb"); set => AccentColorV = value; }
    private string BorderPick { get => Hex(BorderColorV, "#cbd5e1"); set => BorderColorV = value; }
    private string DividerPick { get => Hex(DividerColorV, "#e2e8f0"); set => DividerColorV = value; }
    private string TextPick { get => Hex(TextColorV, "#0f172a"); set => TextColorV = value; }

    // ---- section state -----------------------------------------------------------------------

    private string TitleV = "Quarterly report";
    private int HeadingLevelV = 3;
    private bool ShowSubtitle = true;
    private bool ShowAvatar;
    private bool ShowActions = true;
    private bool HeaderCustomContent;
    private double HeaderPaddingV = -1;
    private string HeaderBgV = "";
    private string BodyTextV = "Revenue is up 12% on the quarter, driven mostly by renewals.";
    private bool LongBody;
    private bool BodyScrollable;
    private string BodyMaxHeightV = "";
    private double BodyPaddingV = -1;
    private string BodyBgV = "";
    private CardSectionAlign FooterAlign = CardSectionAlign.End;
    private double FooterPaddingV = -1;
    private string FooterBgV = "";

    private string HeaderBgPick { get => Hex(HeaderBgV, "#f1f5f9"); set => HeaderBgV = value; }
    private string BodyBgPick { get => Hex(BodyBgV, "#ffffff"); set => BodyBgV = value; }
    private string FooterBgPick { get => Hex(FooterBgV, "#f8fafc"); set => FooterBgV = value; }

    private bool CardDivider = true;
    private bool HeaderDividerSet;
    private bool FooterDividerSet;

    /// <summary>Null leaves the card's cascade in charge; true forces the rule on. There is no
    /// "force off" control here because that is what clearing the card default already does.</summary>
    private bool? HeaderDivider => HeaderDividerSet ? true : null;

    private bool? FooterDivider => FooterDividerSet ? true : null;

    // ---- click log ---------------------------------------------------------------------------

    private int _clicks;
    private string _last = "";

    private string ClickLog => _clicks == 0 ? "none yet" : $"{_clicks} × — last: {_last}";

    private void Log(string what)
    {
        _clicks++;
        _last = what;
    }

    // ---- fragments ---------------------------------------------------------------------------

    /// <summary>An inline SVG rather than a raster file, per the library's graphics policy — and it
    /// needs no asset in the demo hosts.</summary>
    private static readonly RenderFragment MediaFragment = b => b.AddMarkupContent(0,
        "<svg viewBox=\"0 0 320 120\" role=\"img\" aria-label=\"Decorative chart\" " +
        "style=\"display:block;width:100%;height:auto\">" +
        "<defs><linearGradient id=\"cdlGrad\" x1=\"0\" y1=\"0\" x2=\"1\" y2=\"1\">" +
        "<stop offset=\"0\" stop-color=\"#2563eb\"/><stop offset=\"1\" stop-color=\"#0ea5e9\"/>" +
        "</linearGradient></defs>" +
        "<rect width=\"320\" height=\"120\" fill=\"url(#cdlGrad)\"/>" +
        "<path d=\"M0 96 L60 74 L120 84 L180 44 L240 58 L320 20\" fill=\"none\" stroke=\"#fff\" " +
        "stroke-width=\"3\" stroke-linejoin=\"round\" opacity=\".9\"/></svg>");

    private static readonly RenderFragment SubtitleFragment = b => b.AddMarkupContent(0,
        "Updated <em>2 hours ago</em>");

    private static readonly RenderFragment AvatarFragment = b => b.AddMarkupContent(0,
        "<span style=\"display:inline-flex;width:36px;height:36px;border-radius:999px;" +
        "background:#2563eb;color:#fff;align-items:center;justify-content:center;font-size:.8rem\">HS</span>");

    private static readonly RenderFragment ActionsFragment = b => b.AddMarkupContent(0,
        "<button type=\"button\" class=\"cdl-btn\">&hellip;</button>");

    /// <summary>Shows <c>ChildContent</c> taking over the header's whole text block — Title and
    /// Subtitle stop rendering entirely while this is supplied.</summary>
    private static readonly RenderFragment HeaderContentFragment = b => b.AddMarkupContent(0,
        "<div style=\"display:flex;align-items:baseline;gap:.4rem\">" +
        "<strong>Custom header markup</strong><small style=\"opacity:.7\">(Title/Subtitle ignored)</small></div>");

    private RenderFragment SlotHeader => b => b.AddMarkupContent(0,
        $"<strong>{TitleV}</strong>");

    private RenderFragment SlotBody => b => b.AddMarkupContent(0, $"<p>{BodyTextV}</p>");

    private static readonly RenderFragment SlotFooter = b => b.AddMarkupContent(0,
        "<small>Supplied through the Footer slot.</small>");

    // ---- helpers -----------------------------------------------------------------------------

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private static double? Opt(double v) => v > 0 ? v : null;

    /// <summary>0 is meaningful for Padding/Radius/BorderWidth, so -1 is the unset sentinel.</summary>
    private static double? Signed(double v) => v >= 0 ? v : null;

    private static string Hex(string v, string fallback) =>
        v.StartsWith('#') && (v.Length == 7 || v.Length == 4) ? v : fallback;

    // ---- generated snippet -------------------------------------------------------------------

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder();
            const string i = "          ";

            sb.Append("<AtomCard");
            if (VariantSel != CardVariant.Elevated) sb.Append($" Variant=\"CardVariant.{VariantSel}\"");
            if (ElevationSel != CardElevation.Medium) sb.Append($"\n{i}Elevation=\"CardElevation.{ElevationSel}\"");
            if (EffectSel != CardEffect.None) sb.Append($"\n{i}Effect=\"CardEffect.{EffectSel}\"");
            if (ShowMedia && MediaPositionSel != CardMediaPosition.Top)
                sb.Append($"\n{i}MediaPosition=\"CardMediaPosition.{MediaPositionSel}\"");
            if (ShowMedia && !string.IsNullOrEmpty(MediaSizeV)) sb.Append($"\n{i}MediaSize=\"{MediaSizeV}\"");
            if (!string.IsNullOrEmpty(HrefV)) sb.Append($"\n{i}Href=\"{HrefV}\"");
            if (!string.IsNullOrEmpty(TargetV)) sb.Append($"\n{i}Target=\"{TargetV}\"");
            if (Clickable && string.IsNullOrEmpty(HrefV)) sb.Append($"\n{i}OnClick=\"OpenReport\"");
            if (!string.IsNullOrEmpty(AriaLabelV)) sb.Append($"\n{i}AriaLabel=\"{AriaLabelV}\"");
            if (PaddingV >= 0) sb.Append($"\n{i}Padding=\"{PaddingV.ToString(Inv)}\"");
            if (!CardDivider) sb.Append($"\n{i}Divider=\"false\"");
            if (RadiusV >= 0) sb.Append($"\n{i}Radius=\"{RadiusV.ToString(Inv)}\"");
            if (BorderWidthV >= 0) sb.Append($"\n{i}BorderWidth=\"{BorderWidthV.ToString(Inv)}\"");
            if (DurationV > 0) sb.Append($"\n{i}Duration=\"{DurationV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(WidthV)) sb.Append($"\n{i}Width=\"{WidthV}\"");
            if (!string.IsNullOrEmpty(HeightV)) sb.Append($"\n{i}Height=\"{HeightV}\"");
            if (!string.IsNullOrEmpty(BackgroundColorV)) sb.Append($"\n{i}BackgroundColor=\"{BackgroundColorV}\"");
            if (!string.IsNullOrEmpty(AccentColorV)) sb.Append($"\n{i}AccentColor=\"{AccentColorV}\"");
            if (!string.IsNullOrEmpty(BorderColorV)) sb.Append($"\n{i}BorderColor=\"{BorderColorV}\"");
            if (!string.IsNullOrEmpty(DividerColorV)) sb.Append($"\n{i}DividerColor=\"{DividerColorV}\"");
            if (!string.IsNullOrEmpty(TextColorV)) sb.Append($"\n{i}TextColor=\"{TextColorV}\"");
            if (!VisibleV) sb.Append($"\n{i}Visible=\"false\"");
            if (!string.IsNullOrEmpty(CssClassV)) sb.Append($"\n{i}CssClass=\"{CssClassV}\"");
            if (!string.IsNullOrEmpty(StyleV)) sb.Append($"\n{i}Style=\"{StyleV}\"");
            sb.Append(">\n");

            if (ShowMedia)
            {
                sb.Append("    <Media>\n        <img src=\"report.png\" alt=\"\" />\n    </Media>\n");
            }

            sb.Append("    <AtomCardHeader");
            // ChildContent replaces Title/Subtitle, so emitting both would misrepresent the preview.
            if (!HeaderCustomContent && !string.IsNullOrEmpty(TitleV)) sb.Append($" Title=\"{TitleV}\"");
            if (!HeaderCustomContent && HeadingLevelV != 3) sb.Append($" HeadingLevel=\"{HeadingLevelV}\"");
            if (HeaderDividerSet) sb.Append(" Divider=\"true\"");
            if (HeaderPaddingV >= 0) sb.Append($" Padding=\"{HeaderPaddingV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(HeaderBgV)) sb.Append($" BackgroundColor=\"{HeaderBgV}\"");
            if (HeaderCustomContent)
            {
                sb.Append(">\n        <strong>Custom header markup</strong>\n    </AtomCardHeader>\n");
            }
            else if (ShowSubtitle || ShowAvatar || ShowActions)
            {
                sb.Append(">\n");
                if (ShowAvatar) sb.Append("        <Avatar><AtomInitialsAvatar Name=\"Howard S\" /></Avatar>\n");
                if (ShowSubtitle) sb.Append("        <Subtitle>Updated <em>2 hours ago</em></Subtitle>\n");
                if (ShowActions) sb.Append("        <Actions><AtomIconButton AriaLabel=\"More\" /></Actions>\n");
                sb.Append("    </AtomCardHeader>\n");
            }
            else
            {
                sb.Append(" />\n");
            }

            sb.Append("    <AtomCardBody");
            if (BodyScrollable) sb.Append(" Scrollable=\"true\"");
            if (!string.IsNullOrEmpty(BodyMaxHeightV)) sb.Append($" MaxHeight=\"{BodyMaxHeightV}\"");
            if (BodyPaddingV >= 0) sb.Append($" Padding=\"{BodyPaddingV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(BodyBgV)) sb.Append($" BackgroundColor=\"{BodyBgV}\"");
            sb.Append($">\n        <p>{BodyTextV}</p>\n    </AtomCardBody>\n");

            sb.Append("    <AtomCardFooter");
            if (FooterAlign != CardSectionAlign.Start) sb.Append($" Align=\"CardSectionAlign.{FooterAlign}\"");
            if (FooterDividerSet) sb.Append(" Divider=\"true\"");
            if (FooterPaddingV >= 0) sb.Append($" Padding=\"{FooterPaddingV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(FooterBgV)) sb.Append($" BackgroundColor=\"{FooterBgV}\"");
            sb.Append(">\n");
            sb.Append("        <button type=\"button\" @onclick=\"Cancel\">Cancel</button>\n");
            sb.Append("        <button type=\"button\" @onclick=\"SaveAsync\">Save</button>\n");
            sb.Append("    </AtomCardFooter>\n");
            sb.Append("</AtomCard>");

            return sb.ToString();
        }
    }
}
