@page "/playground/textlava"
@using BlazorAtoms.Typography

<PageTitle>AtomTextLava Playground</PageTitle>

<h1>AtomTextLava playground</h1>
<p>
    A zero-JS single-word effect: <code>Word</code> rises up out of an animated molten-lava-gradient
    background. The lava background always loops (ambient); <code>Loop</code> controls only
    whether the word itself keeps bubbling up and down, or rises once and holds.
</p>
<p><a href="/">&larr; Back to home</a></p>

<div class="textlava-preview">
    <AtomTextLava @ref="_lava"
                    Word="@Word"
                    Loop="@Loop"
                    RiseDistance="@RiseDistance"
                    Duration="@Duration"
                    GlowColor="@GlowColor"
                    BgColorHot="@BgColorHot"
                    BgColorCool="@BgColorCool"
                    BgColorBaseDark="@BgColorBaseDark"
                    BgColorBaseLight="@BgColorBaseLight"
                    Style="@($"font-size:{FontSize};")" />
</div>

<div class="textlava-controls">
    <div class="ctrl">
        <label>Word</label>
        <input type="text" @bind="Word" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>Loop (bubble up/down)</label>
        <select @bind="LoopOption">
            <option value="loop">Loop</option>
            <option value="oneshot">One-shot (rise and hold)</option>
        </select>
    </div>
    <div class="ctrl">
        <label>Rise distance</label>
        <input type="text" @bind="RiseDistance" @bind:event="oninput" placeholder="1.5rem" />
    </div>
    <div class="ctrl">
        <label>Duration (per rise/sink)</label>
        <input type="text" @bind="Duration" @bind:event="oninput" placeholder="1.2s" />
    </div>
    <div class="ctrl">
        <label>Glow color</label>
        <div class="textlava-color-row">
            <input type="color" @bind="GlowColor" @bind:event="oninput" />
            <input type="text" @bind="GlowColor" @bind:event="oninput" placeholder="#ff5500" />
        </div>
    </div>
    <div class="ctrl">
        <label>Font size</label>
        <input type="text" @bind="FontSize" @bind:event="oninput" placeholder="3rem" />
    </div>
    <div class="ctrl">
        <label>Background: hot blob</label>
        <div class="textlava-color-row">
            <input type="color" @bind="BgColorHot" @bind:event="oninput" />
            <input type="text" @bind="BgColorHot" @bind:event="oninput" placeholder="#ff6a00" />
        </div>
    </div>
    <div class="ctrl">
        <label>Background: cool blob</label>
        <div class="textlava-color-row">
            <input type="color" @bind="BgColorCool" @bind:event="oninput" />
            <input type="text" @bind="BgColorCool" @bind:event="oninput" placeholder="#ff2d00" />
        </div>
    </div>
    <div class="ctrl">
        <label>Background: base (dark end)</label>
        <div class="textlava-color-row">
            <input type="color" @bind="BgColorBaseDark" @bind:event="oninput" />
            <input type="text" @bind="BgColorBaseDark" @bind:event="oninput" placeholder="#3a0a00" />
        </div>
    </div>
    <div class="ctrl">
        <label>Background: base (light end)</label>
        <div class="textlava-color-row">
            <input type="color" @bind="BgColorBaseLight" @bind:event="oninput" />
            <input type="text" @bind="BgColorBaseLight" @bind:event="oninput" placeholder="#1a0500" />
        </div>
    </div>
    <div class="ctrl ctrl-wide">
        <button class="textlava-repeat" @onclick="() => _lava.Replay()">Repeat Animation (rerun as initial load)</button>
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomTextLavaExample.razor" />

<style>
    .textlava-preview { display:flex; align-items:center; justify-content:center; min-height:10rem;
        background:#0a0a0a; border-radius:12px; padding:2rem; margin-bottom:1.5rem; }
    .textlava-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 1.5rem;
        background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem;
        color:#cfd8e3; margin-bottom:1.5rem; }
    .textlava-controls .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .textlava-controls label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; }
    .textlava-controls input[type=text], .textlava-controls select {
        padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330;
        background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .textlava-controls .ctrl-wide { grid-column:1 / -1; }
    .textlava-color-row { display:flex; gap:.5rem; align-items:center; }
    .textlava-color-row input[type=color] { padding:0; width:2.75rem; height:2.2rem; flex:0 0 auto; }
    .textlava-color-row input[type=text] { flex:1 1 auto; min-width:0; }
    .textlava-repeat { padding:.5rem 1rem; border-radius:6px; border:1px solid rgba(255,255,255,.15);
        background:transparent; color:#ff8a3d; cursor:pointer; }
    .textlava-repeat:hover { background:rgba(0,0,0,.7); color:#fff; }
</style>

@code {
    private AtomTextLava _lava = default!;
    private string Word = "MOLTEN";
    private bool Loop = true;
    private string RiseDistance = "1.5rem";
    private string Duration = "1.2s";
    private string GlowColor = "#ff5500";
    private string FontSize = "3rem";
    private string BgColorHot = "#ff6a00";
    private string BgColorCool = "#ff2d00";
    private string BgColorBaseDark = "#3a0a00";
    private string BgColorBaseLight = "#1a0500";

    // <select @bind="Loop"> with a bool doesn't work: Blazor's bind converter renders bool as
    // "True"/"False" (PascalCase), which never matches literal option value="true"/"false" — the
    // select silently fails to reflect or update Loop. Bind to this string-backed property instead.
    private string LoopOption
    {
        get => Loop ? "loop" : "oneshot";
        set => Loop = value == "loop";
    }

    private string Snippet
    {
        get
        {
            var attrs = $"Word=\"{Word}\"";
            if (!Loop) attrs += " Loop=\"false\"";
            if (RiseDistance != "1.5rem") attrs += $" RiseDistance=\"{RiseDistance}\"";
            if (Duration != "1.2s") attrs += $" Duration=\"{Duration}\"";
            if (GlowColor != "#ff5500") attrs += $" GlowColor=\"{GlowColor}\"";
            if (BgColorHot != "#ff6a00") attrs += $" BgColorHot=\"{BgColorHot}\"";
            if (BgColorCool != "#ff2d00") attrs += $" BgColorCool=\"{BgColorCool}\"";
            if (BgColorBaseDark != "#3a0a00") attrs += $" BgColorBaseDark=\"{BgColorBaseDark}\"";
            if (BgColorBaseLight != "#1a0500") attrs += $" BgColorBaseLight=\"{BgColorBaseLight}\"";
            return $"<AtomTextLava {attrs} />";
        }
    }
}
