    .prg-log { font-family:ui-monospace,monospace; font-size:.8rem; color:#64748b; }
</style>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;

    private static readonly ProgressVariant[] Variants = Enum.GetValues<ProgressVariant>();
    private static readonly ProgressSize[] Sizes = Enum.GetValues<ProgressSize>();
    private static readonly ProgressEffect[] Effects = Enum.GetValues<ProgressEffect>();
    private static readonly ProgressValuePosition[] ValuePositions = Enum.GetValues<ProgressValuePosition>();
    private static readonly ProgressRingCap[] RingCaps = Enum.GetValues<ProgressRingCap>();
    private static readonly ProgressStepsOrientation[] StepOrientations = Enum.GetValues<ProgressStepsOrientation>();
    private static readonly ProgressStepMarker[] StepMarkers = Enum.GetValues<ProgressStepMarker>();

    // ---- shared surface ----------------------------------------------------------------------

    private ProgressVariant VariantSel = ProgressVariant.Primary;
    private ProgressSize SizeSel = ProgressSize.Medium;
    private ProgressEffect EffectSel = ProgressEffect.None;

    private bool HasValue = true;
    private double ValueV = 62;
    private double MinV;
    private double MaxV = 100;
    private string LabelV = "Uploading";
    private string AriaLabelV = "";
    private bool ShowValueV = true;
    private bool UseFormatter;
    private bool VisibleV = true;
    private double ThicknessV;
    private double RadiusV = -1;
    private double FontSizeV;
    private double DurationV;
    private string FillColorV = "";
    private string TrackColorV = "";
    private string TextColorV = "";
    private string CssClassV = "";
    private string StyleV = "";

    /// <summary>Null when the Determinate box is clear — that IS the indeterminate state.</summary>
    private double? OptValue => HasValue ? ValueV : null;

    private Func<double, string>? ActiveFormatter =>
        UseFormatter ? v => $"{v.ToString("0.#", Inv)} of {MaxV.ToString("0.#", Inv)}" : null;

    // The color pickers can only ever produce a hex value, so they write through to the text boxes
    // (which also accept named colors, gradients, color-mix(), ...).
    private string FillPick { get => Hex(FillColorV, "#2563eb"); set => FillColorV = value; }
    private string TrackPick { get => Hex(TrackColorV, "#e2e8f0"); set => TrackColorV = value; }
    private string TextPick { get => Hex(TextColorV, "#334155"); set => TextColorV = value; }

    // ---- per-component state -----------------------------------------------------------------

    private ProgressValuePosition BarValuePosition = ProgressValuePosition.Inside;
    private bool UseBuffer;
    private double BufferV = 80;
    private string BarWidthV = "";

    private double DiameterV = 96;
    private ProgressRingCap RingCap = ProgressRingCap.Round;
    private double StartAngleV = -90;
    private bool RingCustomCenter;

    /// <summary>Backing text for the Steps control. Parsed rather than bound to a list directly, since
    /// there is no native input that edits a collection.</summary>
    private string StepsCsv = "Cart, Address, Payment, Review";

    private IReadOnlyList<string> StepCaptions =>
        StepsCsv.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

    /// <summary>One past the last index, which is the "everything complete" position.</summary>
    private int StepSliderMax => StepCaptions.Count;

    private int CurrentStep = 1;
    private ProgressStepsOrientation StepsOrientation = ProgressStepsOrientation.Horizontal;
    private ProgressStepMarker StepMarker = ProgressStepMarker.Check;
    private bool StepsClickable = true;
    private bool FailSecond;
    private bool UseStepTemplate;

    /// <summary>Custom caption markup, to show <c>StepTemplate</c> replacing the plain string.</summary>
    private RenderFragment<int> StepCaption => index => builder =>
    {
        var caption = index < StepCaptions.Count ? StepCaptions[index] : $"Step {index + 1}";
        builder.AddMarkupContent(0, $"<strong>{index + 1}.</strong> <em>{caption}</em>");
    };

    private bool UseBands = true;
    private double LowV = 25;
    private double HighV = 75;
    private bool UseOptimum = true;
    private double OptimumV = 10;
    private int MeterSegments = 1;
    private bool MeterShowScale;
    private string MeterWidthV = "";

    private int _stepClicks;
    private int _lastStep = -1;

    private string StepClickLog => _stepClicks == 0 ? "none yet" : $"{_stepClicks} × — last index {_lastStep}";

    private void GoToStep(int index)
    {
        _stepClicks++;
        _lastStep = index;
        CurrentStep = index;
    }

    /// <summary>Only <c>StatusFor</c> can produce <c>Error</c> — it is never inferred from
    /// <c>Current</c>, because "the user is on step 3" says nothing about step 2 failing.</summary>
    private ProgressStepStatus FailSecondStatus(int index) =>
        index == 1 ? ProgressStepStatus.Error
        : index < CurrentStep ? ProgressStepStatus.Complete
        : index == CurrentStep ? ProgressStepStatus.Active
        : ProgressStepStatus.Pending;

    private static readonly RenderFragment RingCenter = b => b.AddMarkupContent(0,
        "<strong style=\"font-size:1.1rem\">4.2</strong><span style=\"font-size:.7rem;opacity:.7\">GB free</span>");

    // ---- helpers -----------------------------------------------------------------------------

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    /// <summary>0 means "leave the parameter unset" for sliders whose zero has no useful meaning.</summary>
    private static double? Opt(double v) => v > 0 ? v : null;

    /// <summary>For sliders where 0 IS meaningful (Radius), -1 is the unset sentinel.</summary>
    private static double? Signed(double v) => v >= 0 ? v : null;

    /// <summary>A color input can only hold <c>#rrggbb</c>; anything else in the text box (a name, a
    /// gradient) shows the fallback swatch rather than breaking the picker.</summary>
    private static string Hex(string v, string fallback) =>
        v.StartsWith('#') && (v.Length == 7 || v.Length == 4) ? v : fallback;

    // ---- generated snippet -------------------------------------------------------------------

    /// <summary>Attributes shared by every indicator, written once per component so the snippet
    /// mirrors the previews. Only non-default values appear. <paramref name="valued"/> is false for
    /// AtomProgressSteps (no continuous value); <paramref name="rounded"/> is false for it and the ring
    /// (no rectangular track, so no <c>Radius</c> parameter).</summary>
    private string SharedAttrs(string indent, bool valued = true, bool rounded = true)
    {
        var sb = new System.Text.StringBuilder();
        void Add(string a) => sb.Append('\n').Append(indent).Append(a);

        if (valued)
        {
            // Null Value is the indeterminate case; omitting the parameter says the same thing.
            if (HasValue) Add($"Value=\"{ValueV.ToString(Inv)}\"");
            if (MinV != 0) Add($"Min=\"{MinV.ToString(Inv)}\"");
            if (MaxV != 100) Add($"Max=\"{MaxV.ToString(Inv)}\"");
            if (UseFormatter) Add("Formatter=\"v => $\"{v} of 100\"\"");
        }
        if (!string.IsNullOrEmpty(LabelV)) Add($"Label=\"{LabelV}\"");
        if (ShowValueV) Add("ShowValue=\"true\"");
        if (!string.IsNullOrEmpty(AriaLabelV)) Add($"AriaLabel=\"{AriaLabelV}\"");
        if (VariantSel != ProgressVariant.Primary) Add($"Variant=\"ProgressVariant.{VariantSel}\"");
        if (SizeSel != ProgressSize.Medium) Add($"Size=\"ProgressSize.{SizeSel}\"");
        if (EffectSel != ProgressEffect.None) Add($"Effect=\"ProgressEffect.{EffectSel}\"");
        if (!VisibleV) Add("Visible=\"false\"");
        if (ThicknessV > 0) Add($"Thickness=\"{ThicknessV.ToString(Inv)}\"");
        if (rounded && RadiusV >= 0) Add($"Radius=\"{RadiusV.ToString(Inv)}\"");
        if (FontSizeV > 0) Add($"FontSize=\"{FontSizeV.ToString(Inv)}\"");
        if (DurationV > 0) Add($"Duration=\"{DurationV.ToString(Inv)}\"");
        if (!string.IsNullOrEmpty(FillColorV)) Add($"FillColor=\"{FillColorV}\"");
        if (!string.IsNullOrEmpty(TrackColorV)) Add($"TrackColor=\"{TrackColorV}\"");
        if (!string.IsNullOrEmpty(TextColorV)) Add($"TextColor=\"{TextColorV}\"");
        if (!string.IsNullOrEmpty(CssClassV)) Add($"CssClass=\"{CssClassV}\"");
        if (!string.IsNullOrEmpty(StyleV)) Add($"Style=\"{StyleV}\"");
        return sb.ToString();
    }

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder();

            // AtomProgressBar
            sb.Append("<AtomProgressBar");
            var i = "                 ";
            if (BarValuePosition != ProgressValuePosition.Inside)
                sb.Append($" ValuePosition=\"ProgressValuePosition.{BarValuePosition}\"");
            if (UseBuffer) sb.Append($"\n{i}Buffer=\"{BufferV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(BarWidthV)) sb.Append($"\n{i}Width=\"{BarWidthV}\"");
            sb.Append(SharedAttrs(i));
            sb.Append(" />\n\n");

            // AtomProgressRing
            sb.Append("<AtomProgressRing");
            i = "                  ";
            if (DiameterV != 96) sb.Append($" Diameter=\"{DiameterV.ToString(Inv)}\"");
            if (RingCap != ProgressRingCap.Butt) sb.Append($"\n{i}Cap=\"ProgressRingCap.{RingCap}\"");
            if (StartAngleV != -90) sb.Append($"\n{i}StartAngle=\"{StartAngleV.ToString(Inv)}\"");
            sb.Append(SharedAttrs(i, rounded: false));
            if (RingCustomCenter)
            {
                sb.Append(">\n    <CenterContent><strong>4.2</strong> GB free</CenterContent>\n</AtomProgressRing>\n\n");
            }
            else
            {
                sb.Append(" />\n\n");
            }

            // AtomProgressSteps — no Value/Min/Max (no continuous value), and no Radius (no
            // rectangular track). The Steps array is emitted literally so the snippet pastes and
            // compiles without a field the reader has to go and write.
            var steps = string.Join(", ", StepCaptions.Select(s => $"\"{s}\""));
            sb.Append($"<AtomProgressSteps Steps=\"@(new[] {{ {steps} }})\"");
            i = "                   ";
            sb.Append($"\n{i}Current=\"{CurrentStep}\"");
            if (StepsOrientation != ProgressStepsOrientation.Horizontal)
                sb.Append($"\n{i}Orientation=\"ProgressStepsOrientation.{StepsOrientation}\"");
            if (StepMarker != ProgressStepMarker.Number)
                sb.Append($"\n{i}Marker=\"ProgressStepMarker.{StepMarker}\"");
            if (FailSecond) sb.Append($"\n{i}StatusFor=\"StatusOf\"");
            if (StepsClickable) sb.Append($"\n{i}OnStepClick=\"GoToStep\"");
            sb.Append(SharedAttrs(i, valued: false, rounded: false));
            if (UseStepTemplate)
            {
                // Index-derived only, so the snippet stays self-contained — reaching back into the
                // Steps list here would need a field the reader doesn't have.
                sb.Append(">\n    <StepTemplate Context=\"index\">\n");
                sb.Append("        <strong>Step @(index + 1)</strong>\n");
                sb.Append("    </StepTemplate>\n</AtomProgressSteps>\n\n");
            }
            else
            {
                sb.Append(" />\n\n");
            }

            // AtomMeter
            sb.Append("<AtomMeter");
            i = "           ";
            if (UseBands)
            {
                sb.Append($" Low=\"{LowV.ToString(Inv)}\"");
                sb.Append($"\n{i}High=\"{HighV.ToString(Inv)}\"");
            }
            if (UseOptimum) sb.Append($"\n{i}Optimum=\"{OptimumV.ToString(Inv)}\"");
            if (MeterSegments > 1) sb.Append($"\n{i}Segments=\"{MeterSegments}\"");
            if (MeterShowScale) sb.Append($"\n{i}ShowScale=\"true\"");
            if (!string.IsNullOrEmpty(MeterWidthV)) sb.Append($"\n{i}Width=\"{MeterWidthV}\"");
            sb.Append(SharedAttrs(i));
            sb.Append(" />");

            return sb.ToString();
        }
    }
}
