@using System.Globalization
@using BlazorAtoms.Progress

<PageTitle>Progress Playground</PageTitle>

<h1>Progress playground</h1>
<p>The four determinate indicators in <code>BlazorAtoms.Progress</code>. All four share
   <code>AtomProgressBase</code> — the label/readout surface, the <code>Variant</code>/<code>Size</code>/
   <code>Effect</code> axes emitted as <code>data-*</code>, and one <code>--progress-*</code> token
   prefix. Bar, ring and meter add a scalar value via <code>AtomProgressValueBase</code>;
   <code>AtomProgressSteps</code> deliberately does not inherit it, because it has no continuous value
   to scale. Zero JS.</p>
<p><strong>Null <code>Value</code> means indeterminate</strong> — clear the checkbox below and the bar
   sweeps while the ring spins. One parameter rather than a value plus a flag, so
   "<code>Value=40</code> but ignore it" is not expressible.</p>
<p><a href="playground/buttons">&larr; Buttons playground</a> &middot;
   <a href="playground/cardlayout">Card layout playground &rarr;</a></p>

<div class="prg-controls">
    <div class="ctrl">
        <label>Variant</label>
        <select @bind="VariantSel">
            @foreach (var v in Variants) { <option value="@v">@v</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Size</label>
        <select @bind="SizeSel">
            @foreach (var s in Sizes) { <option value="@s">@s</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Effect</label>
        <select @bind="EffectSel">
            @foreach (var e in Effects) { <option value="@e">@e</option> }
        </select>
        <span class="note">CSS only — no C# state</span>
    </div>
    <div class="ctrl">
        <label>Value <span class="val">@(HasValue ? ValueV.ToString(Inv) : "null")</span></label>
        <input type="range" min="0" max="100" step="1" @bind="ValueV" @bind:event="oninput" @bind:culture="Inv" disabled="@(!HasValue)" />
        <div class="row"><input type="checkbox" id="prgHasVal" @bind="HasValue" /><label for="prgHasVal" class="inline">Determinate</label></div>
    </div>
    <div class="ctrl">
        <label>Min <span class="val">@MinV.ToString(Inv)</span></label>
        <input type="range" min="-50" max="50" step="5" @bind="MinV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Max <span class="val">@MaxV.ToString(Inv)</span></label>
        <input type="range" min="10" max="500" step="10" @bind="MaxV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Label</label>
        <input type="text" @bind="LabelV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>AriaLabel</label>
        <input type="text" @bind="AriaLabelV" @bind:event="oninput" placeholder="(falls back to Label)" />
    </div>
    <div class="ctrl">
        <label>Readout</label>
        <div class="row"><input type="checkbox" id="prgShowVal" @bind="ShowValueV" /><label for="prgShowVal" class="inline">ShowValue</label></div>
        <div class="row"><input type="checkbox" id="prgFmt" @bind="UseFormatter" /><label for="prgFmt" class="inline">Formatter ("x of y")</label></div>
        <div class="row"><input type="checkbox" id="prgVis" @bind="VisibleV" /><label for="prgVis" class="inline">Visible</label></div>
    </div>
    <div class="ctrl">
        <label>Thickness (px, 0=Size) <span class="val">@ThicknessV.ToString(Inv)</span></label>
        <input type="range" min="0" max="32" step="1" @bind="ThicknessV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Radius (px, -1=default) <span class="val">@RadiusV.ToString(Inv)</span></label>
        <input type="range" min="-1" max="24" step="1" @bind="RadiusV" @bind:event="oninput" @bind:culture="Inv" />
        <span class="note">bar + meter only &mdash; the ring and the step markers have no rectangular
            track, so it isn't a parameter there</span>
    </div>
    <div class="ctrl">
        <label>FontSize (px, 0=Size) <span class="val">@FontSizeV.ToString(Inv)</span></label>
        <input type="range" min="0" max="28" step="1" @bind="FontSizeV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Duration (s, 0=default) <span class="val">@DurationV.ToString(Inv)</span></label>
        <input type="range" min="0" max="3" step="0.05" @bind="DurationV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>FillColor</label>
        <div class="row color">
            <input type="color" @bind="FillPick" @bind:event="oninput" />
            <input type="text" @bind="FillColorV" @bind:event="oninput" placeholder="(Variant accent)" />
            <button type="button" class="clr-btn" @onclick="@(() => FillColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>TrackColor</label>
        <div class="row color">
            <input type="color" @bind="TrackPick" @bind:event="oninput" />
            <input type="text" @bind="TrackColorV" @bind:event="oninput" placeholder="(default tint)" />
            <button type="button" class="clr-btn" @onclick="@(() => TrackColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>TextColor</label>
        <div class="row color">
            <input type="color" @bind="TextPick" @bind:event="oninput" />
            <input type="text" @bind="TextColorV" @bind:event="oninput" placeholder="(inherits)" />
            <button type="button" class="clr-btn" @onclick="@(() => TextColorV = "")">clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>CssClass</label>
        <input type="text" @bind="CssClassV" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Style</label>
        <input type="text" @bind="StyleV" @bind:event="oninput" placeholder="e.g. opacity:.8" />
    </div>
</div>

<div class="prg-stage">
    @* ---- AtomProgressBar ------------------------------------------------------------------- *@
    <section class="prg-case">
        <h2>AtomProgressBar</h2>
        <AtomProgressBar Value="@OptValue" Min="@MinV" Max="@MaxV"
                         Label="@Nz(LabelV)" ShowValue="@ShowValueV" AriaLabel="@Nz(AriaLabelV)"
                         Formatter="@ActiveFormatter"
                         ValuePosition="@BarValuePosition"
                         Buffer="@(UseBuffer ? BufferV : null)"
                         Width="@Nz(BarWidthV)"
                         Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                         Visible="@VisibleV"
                         Thickness="@Opt(ThicknessV)" Radius="@Signed(RadiusV)" FontSize="@Opt(FontSizeV)"
                         Duration="@Opt(DurationV)"
                         FillColor="@Nz(FillColorV)" TrackColor="@Nz(TrackColorV)" TextColor="@Nz(TextColorV)"
                         CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        <div class="prg-opts">
            <div class="ctrl">
                <label>ValuePosition</label>
                <select @bind="BarValuePosition">
                    @foreach (var p in ValuePositions) { <option value="@p">@p</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Buffer <span class="val">@BufferV.ToString(Inv)</span></label>
                <input type="range" min="0" max="100" step="1" @bind="BufferV" @bind:event="oninput" @bind:culture="Inv" disabled="@(!UseBuffer)" />
                <div class="row"><input type="checkbox" id="prgBuf" @bind="UseBuffer" /><label for="prgBuf" class="inline">Buffer set</label></div>
            </div>
            <div class="ctrl">
                <label>Width (CSS length)</label>
                <input type="text" @bind="BarWidthV" @bind:event="oninput" placeholder="(fills parent)" />
            </div>
        </div>
    </section>

    @* ---- AtomProgressRing ------------------------------------------------------------------ *@
    <section class="prg-case">
        <h2>AtomProgressRing</h2>
        <div class="prg-row">
            <AtomProgressRing Value="@OptValue" Min="@MinV" Max="@MaxV"
                              Label="@Nz(LabelV)" ShowValue="@ShowValueV" AriaLabel="@Nz(AriaLabelV)"
                              Formatter="@ActiveFormatter"
                              Diameter="@DiameterV" Cap="@RingCap" StartAngle="@StartAngleV"
                              CenterContent="@(RingCustomCenter ? RingCenter : null)"
                              Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                              Visible="@VisibleV"
                              Thickness="@Opt(ThicknessV)" FontSize="@Opt(FontSizeV)" Duration="@Opt(DurationV)"
                              FillColor="@Nz(FillColorV)" TrackColor="@Nz(TrackColorV)" TextColor="@Nz(TextColorV)"
                              CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
            <span class="note">Arc drawn with <code>pathLength="100"</code> — the dash math has no
                &pi; in it and is radius-independent.</span>
        </div>
        <div class="prg-opts">
            <div class="ctrl">
                <label>Diameter (px) <span class="val">@DiameterV.ToString(Inv)</span></label>
                <input type="range" min="32" max="260" step="4" @bind="DiameterV" @bind:event="oninput" @bind:culture="Inv" />
            </div>
            <div class="ctrl">
                <label>Cap</label>
                <select @bind="RingCap">
                    @foreach (var c in RingCaps) { <option value="@c">@c</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>StartAngle (deg) <span class="val">@StartAngleV.ToString(Inv)</span></label>
                <input type="range" min="-180" max="180" step="15" @bind="StartAngleV" @bind:event="oninput" @bind:culture="Inv" />
                <span class="note">ignored while indeterminate — the spin owns the transform</span>
            </div>
            <div class="ctrl">
                <label>Center</label>
                <div class="row"><input type="checkbox" id="prgCenter" @bind="RingCustomCenter" /><label for="prgCenter" class="inline">CenterContent (beats ShowValue)</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomProgressSteps ----------------------------------------------------------------- *@
    <section class="prg-case">
        <h2>AtomProgressSteps</h2>
        <div class="prg-row @(StepsOrientation == ProgressStepsOrientation.Vertical ? "narrow" : "")">
            <AtomProgressSteps Steps="@StepCaptions" Current="@CurrentStep"
                               Orientation="@StepsOrientation" Marker="@StepMarker"
                               StatusFor="@(FailSecond ? FailSecondStatus : null)"
                               StepTemplate="@(UseStepTemplate ? StepCaption : null)"
                               OnStepClick="@(StepsClickable ? EventCallback.Factory.Create<int>(this, GoToStep) : default)"
                               Label="@Nz(LabelV)" ShowValue="@ShowValueV" AriaLabel="@Nz(AriaLabelV)"
                               Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                               Visible="@VisibleV"
                               Thickness="@Opt(ThicknessV)" FontSize="@Opt(FontSizeV)" Duration="@Opt(DurationV)"
                               FillColor="@Nz(FillColorV)" TrackColor="@Nz(TrackColorV)" TextColor="@Nz(TextColorV)"
                               CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        </div>
        <div class="prg-opts">
            <div class="ctrl">
                <label>Steps (comma-separated)</label>
                <input type="text" @bind="StepsCsv" @bind:event="oninput" placeholder="(empty list)" />
                <span class="note">@StepCaptions.Count step(s)</span>
            </div>
            <div class="ctrl">
                <label>Current <span class="val">@CurrentStep</span></label>
                <input type="range" min="-1" max="@StepSliderMax" step="1" @bind="CurrentStep" @bind:event="oninput" />
                <span class="note">-1 = all pending, @StepCaptions.Count = all complete</span>
            </div>
            <div class="ctrl">
                <label>Orientation</label>
                <select @bind="StepsOrientation">
                    @foreach (var o in StepOrientations) { <option value="@o">@o</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Marker</label>
                <select @bind="StepMarker">
                    @foreach (var m in StepMarkers) { <option value="@m">@m</option> }
                </select>
            </div>
            <div class="ctrl">
                <label>Behavior</label>
                <div class="row"><input type="checkbox" id="prgClick" @bind="StepsClickable" /><label for="prgClick" class="inline">OnStepClick (markers become buttons)</label></div>
                <div class="row"><input type="checkbox" id="prgFail" @bind="FailSecond" /><label for="prgFail" class="inline">StatusFor: step 2 failed</label></div>
                <div class="row"><input type="checkbox" id="prgTpl" @bind="UseStepTemplate" /><label for="prgTpl" class="inline">StepTemplate (custom caption markup)</label></div>
            </div>
        </div>
    </section>

    @* ---- AtomMeter ------------------------------------------------------------------------- *@
    <section class="prg-case">
        <h2>AtomMeter</h2>
        <p class="note">A measurement, not a task — <code>role="meter"</code>. With an
           <code>Optimum</code> set, <code>data-level</code> recolors the fill; the classification is
           the HTML <code>&lt;meter&gt;</code> spec's own three-way rule.</p>
        <AtomMeter Value="@OptValue" Min="@MinV" Max="@MaxV"
                   Low="@(UseBands ? LowV : null)" High="@(UseBands ? HighV : null)"
                   Optimum="@(UseOptimum ? OptimumV : null)"
                   Segments="@(MeterSegments > 1 ? MeterSegments : null)"
                   ShowScale="@MeterShowScale"
                   Width="@Nz(MeterWidthV)"
                   Label="@Nz(LabelV)" ShowValue="@ShowValueV" AriaLabel="@Nz(AriaLabelV)"
                   Formatter="@ActiveFormatter"
                   Variant="@VariantSel" Size="@SizeSel" Effect="@EffectSel"
                   Visible="@VisibleV"
                   Thickness="@Opt(ThicknessV)" Radius="@Signed(RadiusV)" FontSize="@Opt(FontSizeV)"
                   Duration="@Opt(DurationV)"
                   FillColor="@Nz(FillColorV)" TrackColor="@Nz(TrackColorV)" TextColor="@Nz(TextColorV)"
                   CssClass="@Nz(CssClassV)" Style="@Nz(StyleV)" />
        <div class="prg-opts">
            <div class="ctrl">
                <label>Low <span class="val">@LowV.ToString(Inv)</span></label>
                <input type="range" min="0" max="100" step="1" @bind="LowV" @bind:event="oninput" @bind:culture="Inv" disabled="@(!UseBands)" />
                <div class="row"><input type="checkbox" id="prgBands" @bind="UseBands" /><label for="prgBands" class="inline">Low/High set</label></div>
            </div>
            <div class="ctrl">
                <label>High <span class="val">@HighV.ToString(Inv)</span></label>
                <input type="range" min="0" max="100" step="1" @bind="HighV" @bind:event="oninput" @bind:culture="Inv" disabled="@(!UseBands)" />
            </div>
            <div class="ctrl">
                <label>Optimum <span class="val">@OptimumV.ToString(Inv)</span></label>
                <input type="range" min="0" max="100" step="1" @bind="OptimumV" @bind:event="oninput" @bind:culture="Inv" disabled="@(!UseOptimum)" />
                <div class="row"><input type="checkbox" id="prgOpt" @bind="UseOptimum" /><label for="prgOpt" class="inline">Optimum set (enables levels)</label></div>
            </div>
            <div class="ctrl">
                <label>Segments (1=none) <span class="val">@MeterSegments</span></label>
                <input type="range" min="1" max="20" step="1" @bind="MeterSegments" @bind:event="oninput" />
            </div>
            <div class="ctrl">
                <label>Width (CSS length)</label>
                <input type="text" @bind="MeterWidthV" @bind:event="oninput" placeholder="(fills parent)" />
            </div>
            <div class="ctrl">
                <label>Ruler</label>
                <div class="row"><input type="checkbox" id="prgScale" @bind="MeterShowScale" /><label for="prgScale" class="inline">ShowScale</label></div>
            </div>
        </div>
    </section>

    @* ---- every variant at a glance --------------------------------------------------------- *@
    <section class="prg-case">
        <h2>Variant &times; component</h2>
        <p class="note">Current Size / Effect / Value apply throughout.</p>
        @foreach (var variant in Variants)
        {
            <div class="prg-matrix">
                <code class="prg-matrix-name">@variant</code>
                <AtomProgressBar Value="@OptValue" Min="@MinV" Max="@MaxV" Variant="@variant"
                                 Size="@SizeSel" Effect="@EffectSel" Width="14rem" />
                <AtomProgressRing Value="@OptValue" Min="@MinV" Max="@MaxV" Variant="@variant"
                                  Size="@SizeSel" Effect="@EffectSel" Diameter="44" />
                <AtomMeter Value="@OptValue" Min="@MinV" Max="@MaxV" Variant="@variant"
                           Size="@SizeSel" Effect="@EffectSel" Width="10rem" />
            </div>
        }
    </section>
</div>

<p class="prg-log">Step clicks: <code>@StepClickLog</code></p>

<CodeSnippetBox Code="@Snippet" FileName="ProgressExample.razor" />

<style>
    .prg-controls, .prg-opts { display:grid; grid-template-columns:repeat(auto-fit,minmax(215px,1fr)); gap:1rem 1.5rem; }
    .prg-controls { background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; margin-bottom:1.5rem; }
    .prg-controls .ctrl, .prg-opts .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .prg-controls label, .prg-opts label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .prg-controls label .val, .prg-opts label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .prg-controls input[type=range], .prg-opts input[type=range] { width:100%; accent-color:#2563eb; }
    .prg-controls input[type=text], .prg-controls select, .prg-opts input[type=text], .prg-opts select
        { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; min-width:0; }
    .prg-controls .row, .prg-opts .row { display:flex; align-items:center; gap:.5rem; }
    .prg-controls .row input[type=checkbox], .prg-opts .row input[type=checkbox] { accent-color:#2563eb; width:16px; height:16px; flex:none; }
    .prg-controls .row.color input[type=color] { flex:none; width:38px; height:32px; padding:2px; background:#070b10; border:1px solid #1b2330; border-radius:6px; cursor:pointer; }
    .prg-controls .row.color input[type=text] { flex:1 1 auto; min-width:0; }
    .prg-controls .row label.inline, .prg-opts .row label.inline { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
    .prg-controls .clr-btn, .prg-opts .clr-btn { flex:none; padding:.35rem .55rem; border:1px solid #1b2330; background:#161d29; color:#cfd8e3; border-radius:6px; cursor:pointer; font-size:.75rem; }
    .prg-controls .clr-btn:hover { background:#1e2836; }
    .note { font-size:.75rem; color:#5fb7c9; font-family:ui-monospace,monospace; }

    .prg-stage { display:flex; flex-direction:column; gap:1.25rem; }
    .prg-case { border:1px solid #e2e8f0; border-radius:12px; padding:1.25rem 1.5rem; }
    .prg-case h2 { margin:0 0 .75rem; font-size:1rem; font-family:ui-monospace,Consolas,monospace; color:#334155; }
    .prg-case > .note { display:block; margin-bottom:.75rem; color:#64748b; }
    .prg-case > .atom-progress-bar, .prg-case > .atom-meter { margin-bottom:1rem; }
    .prg-row { display:flex; flex-wrap:wrap; align-items:center; gap:1rem; margin-bottom:1rem; }
    .prg-row.narrow { max-width:22rem; }
    .prg-row .note { color:#64748b; max-width:28rem; }
    .prg-case .prg-opts { background:#0d1118; border:1px solid #1b2330; border-radius:10px; padding:1rem 1.25rem; color:#cfd8e3; }

