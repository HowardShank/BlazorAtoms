@using System.ComponentModel.DataAnnotations
@using BlazorAtoms.DynamicFormWizard
@using BlazorAtoms.DynamicFormWizard.Attributes

<PageTitle>Dynamic Form Wizard — Standard DataAnnotations Playground</PageTitle>

<h1>Dynamic Form Wizard — standard DataAnnotations attributes</h1>
<p>Step 1: <code>[DataType(DataType.Password/EmailAddress/MultilineText)]</code> render a real
   <code>input type="password"</code>/<code>type="email"</code>/a <code>&lt;textarea&gt;</code>
   instead of plain text, and <code>[Compare(nameof(Password))]</code> cross-checks two properties
   -- it already worked before this feature batch, since the engine's <code>ValidationContext</code>
   wraps the whole model, not just one value.</p>
<p>Step 2: <code>[Editable(false)]</code> plus <code>[DisplayFormat(DataFormatString=...)]</code>
   render a formatted, read-only "Account ID" -- no input at all, regardless of its underlying
   type. A <code>[ScaffoldColumn(false)]</code> internal note field is on the model but never
   rendered, never validated, and never counted toward this step's visibility.</p>
<p><code>[FormLabel(LabelPosition)]</code> (#142) moves a field's label: Email uses
   <code>Left</code> (label beside the input), Bio uses <code>Inline</code> (label becomes the
   textarea's placeholder instead of a visible element), and Nickname uses <code>Hidden</code>
   (no visible label at all -- moved onto the input's <code>aria-label</code> instead, so it stays
   accessible). The wizard's own <code>FieldAttributes</code> parameter (#143) also splats a
   <code>data-testid</code> onto Nickname's input, alongside that same synthesized
   <code>aria-label</code>.</p>
<p><a href="playground/dynamicformwizard">&larr; Back to the main Dynamic Form Wizard playground</a></p>

<div class="dfw-columns">
    <div class="dfw-wizard">
        @if (_completed is null)
        {
            <DynamicWizard TModel="AccountModel" Model="_model" OnWizardComplete="HandleComplete" FieldAttributes="_fieldAttributes" />
        }
        else
        {
            <p><strong>Submitted!</strong></p>
            <dl class="dfw-summary">
                <dt>Email</dt><dd>@_completed.Email</dd>
                <dt>Nickname</dt><dd>@_completed.Nickname</dd>
                <dt>Bio</dt><dd>@_completed.Bio</dd>
                <dt>AccountId</dt><dd>@_completed.AccountId</dd>
                <dt>InternalAuditNote (never shown to the user)</dt><dd>@_completed.InternalAuditNote</dd>
            </dl>
            <button type="button" @onclick="Reset">Start over</button>
        }
    </div>

    <div class="dfw-source">
        <h2>The POCO</h2>
        <pre><code>@PocoSource</code></pre>
    </div>
</div>

@code {
    private AccountModel _model = new();
    private AccountModel? _completed;

    // FieldAttributes (#143) is a wizard-level parameter, not a model attribute -- it splats extra
    // HTML onto one named field's rendered input regardless of what tier renders it.
    private readonly Dictionary<string, IReadOnlyDictionary<string, object>> _fieldAttributes = new()
    {
        [nameof(AccountModel.Nickname)] = new Dictionary<string, object> { ["data-testid"] = "nickname-field" },
    };

    private void HandleComplete(AccountModel model) => _completed = model;

    private void Reset()
    {
        _model = new();
        _completed = null;
    }

    public class AccountModel
    {
        [FormStep(1, "Account")]
        [FormOrder(1)]
        [FormLabel(LabelPosition.Left)]
        [DataType(DataType.EmailAddress)]
        [Required(ErrorMessage = "Email is required.")]
        public string Email { get; set; } = string.Empty;

        [FormStep(1)]
        [FormOrder(2)]
        [DataType(DataType.Password)]
        [Required(ErrorMessage = "Password is required.")]
        public string Password { get; set; } = string.Empty;

        [FormStep(1)]
        [FormOrder(3)]
        [DataType(DataType.Password)]
        [Compare(nameof(Password), ErrorMessage = "Passwords must match.")]
        public string ConfirmPassword { get; set; } = string.Empty;

        [FormStep(1)]
        [FormOrder(4)]
        [FormLabel(LabelPosition.Hidden)]
        public string Nickname { get; set; } = string.Empty;

        [FormStep(1)]
        [FormOrder(5)]
        [FormLabel(LabelPosition.Inline)]
        [DataType(DataType.MultilineText)]
        public string Bio { get; set; } = string.Empty;

        [FormStep(2, "Review")]
        [FormOrder(1)]
        [Editable(false)]
        [DisplayFormat(DataFormatString = "ACC-{0:D6}")]
        public int AccountId { get; set; } = 42;

        // [ScaffoldColumn(false)] -- on the model, but excluded entirely: never rendered, never
        // validated, never counted toward step 2's visibility (it's the ONLY property on step 2
        // besides AccountId, so if this filter didn't work, step 2 would still show it as a field).
        [FormStep(2)]
        [ScaffoldColumn(false)]
        [Required(ErrorMessage = "This would block submission if it were ever validated.")]
        public string InternalAuditNote { get; set; } = "reviewed-by:system";
    }

    private const string PocoSource = """
        public class AccountModel
        {
            [FormStep(1, "Account")] [FormOrder(1)]
            [FormLabel(LabelPosition.Left)]
            [DataType(DataType.EmailAddress)]
            [Required(ErrorMessage = "Email is required.")]
            public string Email { get; set; } = string.Empty;

            [FormStep(1)] [FormOrder(2)]
            [DataType(DataType.Password)]
            [Required(ErrorMessage = "Password is required.")]
            public string Password { get; set; } = string.Empty;

            [FormStep(1)] [FormOrder(3)]
            [DataType(DataType.Password)]
            [Compare(nameof(Password), ErrorMessage = "Passwords must match.")]
            public string ConfirmPassword { get; set; } = string.Empty;

            // No visible label at all -- aria-label only. Combined with the wizard's own
            // FieldAttributes["Nickname"] = { ["data-testid"] = "nickname-field" }.
            [FormStep(1)] [FormOrder(4)]
            [FormLabel(LabelPosition.Hidden)]
            public string Nickname { get; set; } = string.Empty;

            // No visible label -- becomes the textarea's placeholder instead.
            [FormStep(1)] [FormOrder(5)]
            [FormLabel(LabelPosition.Inline)]
            [DataType(DataType.MultilineText)]
            public string Bio { get; set; } = string.Empty;

            [FormStep(2, "Review")] [FormOrder(1)]
            [Editable(false)]
            [DisplayFormat(DataFormatString = "ACC-{0:D6}")]
            public int AccountId { get; set; } = 42;

            // Excluded entirely -- never rendered, validated, or counted toward step visibility.
            [FormStep(2)]
            [ScaffoldColumn(false)]
            [Required(ErrorMessage = "This would block submission if it were ever validated.")]
            public string InternalAuditNote { get; set; } = "reviewed-by:system";
        }
        """;
}

<style>
    .dfw-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
    }

    .dfw-source pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .dfw-summary {
        display: grid;
        grid-template-columns: max-content 1fr;
        gap: 0.25rem 1rem;
    }

    .dfw-summary dt {
        font-weight: 600;
    }

    .dfw-summary dd {
        margin: 0;
    }

    @@media (max-width: 900px) {
        .dfw-columns {
            grid-template-columns: 1fr;
        }
    }
</style>
