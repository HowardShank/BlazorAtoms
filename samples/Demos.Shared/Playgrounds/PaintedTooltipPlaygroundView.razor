@using BlazorAtoms.Tooltips

<PageTitle>AtomPaintedTooltip Playground</PageTitle>

<style>
    .tt-stage-outer { display:flex; align-items:center; justify-content:center; min-height:220px;
        background: radial-gradient(ellipse at center,#0b1019 0%,#07090d 100%); border:1px solid #1b2330;
        border-radius:12px; padding:1.5rem; margin-bottom:1.5rem; }
    .tt-trigger-btn { padding:.6rem 1.1rem; border-radius:6px; border:1px solid #2a3242; background:#161b26; color:#e5e9f0; font-size:.95rem; cursor:pointer; }
    .tt-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 1.5rem;
        background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; }
    .tt-ctrl { display:flex; flex-direction:column; gap:.35rem; }
    .tt-ctrl label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .tt-ctrl label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .tt-controls input[type=range], .tt-controls input[type=text], .tt-controls select { width:100%; accent-color:#00b3c4; }
    .tt-controls input[type=color] { width:100%; height:32px; background:none; border:1px solid #1b2330; border-radius:6px; padding:2px; }
    .tt-ctrl .row { display:flex; align-items:center; gap:.5rem; }
    .tt-ctrl .row input[type=checkbox] { accent-color:#00b3c4; width:16px; height:16px; }
    .tt-ctrl .row label { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
</style>

<h1>AtomPaintedTooltip playground</h1>
<p>SVG paints the bubble: gradient fill, stroke border, optional shadow — on every shape.</p>
<p><a href="demo">&larr; Back to demo</a></p>

<div class="tt-stage-outer">
    <AtomPaintedTooltip Text="@Text" Placement="@Placement" Shape="@Shape" ShowArrow="@ShowArrow" Shadow="@Shadow"
                        GradientFrom="@(UseGradient ? GradFrom : null)" GradientTo="@(UseGradient ? GradTo : null)"
                        GradientAngle="@GradAngle" Background="@(UseGradient ? null : Bg)"
                        BorderColor="@Border" BorderWidth="@BorderWidth" ArrowSize="@ArrowSize" Offset="@Offset"
                        TextAlign="@TextAlign" VerticalAlign="@VerticalAlign"
                        Width="@(string.IsNullOrWhiteSpace(Width) ? null : Width)" Height="@(string.IsNullOrWhiteSpace(Height) ? null : Height)"
                        CssClass="@Nz(HatchClass)" Style="@Nz(HatchStyle)" title="@Nz(HatchTitle)">
        <button class="tt-trigger-btn">Hover or Tab to me</button>
    </AtomPaintedTooltip>
</div>

<div class="tt-controls">
    <div class="tt-ctrl"><label>Text</label><input type="text" @bind="Text" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Placement</label><select @bind="Placement">@foreach (var p in Enum.GetValues<Placement>()){<option value="@p">@p</option>}</select></div>
    <div class="tt-ctrl"><label>Shape</label><select @bind="Shape">@foreach (var s in Enum.GetValues<PaintedTooltipShape>()){<option value="@s">@s</option>}</select></div>
    <div class="tt-ctrl"><label>Fill</label>
        <div class="row"><input type="checkbox" id="ug" @bind="UseGradient" /><label for="ug">Use gradient</label></div>
    </div>
    <div class="tt-ctrl"><label>Solid background</label><input type="color" @bind="Bg" @bind:event="oninput" disabled="@UseGradient" /></div>
    <div class="tt-ctrl"><label>Gradient from</label><input type="color" @bind="GradFrom" @bind:event="oninput" disabled="@(!UseGradient)" /></div>
    <div class="tt-ctrl"><label>Gradient to</label><input type="color" @bind="GradTo" @bind:event="oninput" disabled="@(!UseGradient)" /></div>
    <div class="tt-ctrl"><label>Gradient angle <span class="val">@(GradAngle)&deg;</span></label><input type="range" min="0" max="360" step="5" @bind="GradAngle" @bind:event="oninput" disabled="@(!UseGradient)" /></div>
    <div class="tt-ctrl"><label>Border color</label><input type="color" @bind="Border" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Border width <span class="val">@(BorderWidth)px</span></label><input type="range" min="0" max="6" step="1" @bind="BorderWidth" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Arrow size <span class="val">@(ArrowSize)px</span></label><input type="range" min="0" max="20" step="1" @bind="ArrowSize" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Offset <span class="val">@(Offset)px</span></label><input type="range" min="0" max="32" step="1" @bind="Offset" @bind:event="oninput" /></div>
    <div class="tt-ctrl"><label>Width (e.g. 160px)</label><input type="text" @bind="Width" @bind:event="oninput" placeholder="auto" /></div>
    <div class="tt-ctrl"><label>Height (e.g. 90px)</label><input type="text" @bind="Height" @bind:event="oninput" placeholder="auto" /></div>
    <div class="tt-ctrl"><label>Text align (H)</label><select @bind="TextAlign"><option value="">(default)</option>@foreach (var a in Enum.GetValues<TooltipTextAlign>()){<option value="@a">@a</option>}</select></div>
    <div class="tt-ctrl"><label>Vertical align</label><select @bind="VerticalAlign"><option value="">(default)</option>@foreach (var a in Enum.GetValues<TooltipVerticalAlign>()){<option value="@a">@a</option>}</select></div>
    <div class="tt-ctrl"><label>Options</label>
        <div class="row"><input type="checkbox" id="sa" @bind="ShowArrow" /><label for="sa">Show arrow</label></div>
        <div class="row"><input type="checkbox" id="sh" @bind="Shadow" /><label for="sh">Shadow</label></div>
    </div>
    <div class="tt-ctrl"><label>Extra class (CssClass)</label><input type="text" @bind="HatchClass" @bind:event="oninput" placeholder="(none)" /></div>
    <div class="tt-ctrl"><label>Extra style (Style)</label><input type="text" @bind="HatchStyle" @bind:event="oninput" placeholder="(none)" /></div>
    <div class="tt-ctrl"><label>title attr (splat)</label><input type="text" @bind="HatchTitle" @bind:event="oninput" placeholder="(none)" /></div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomPaintedTooltipExample.razor" />

@code {
    private string Text = "I'm painted";
    private Placement Placement = Placement.Top;
    private PaintedTooltipShape Shape = PaintedTooltipShape.Rectangle;
    private bool ShowArrow = true;
    private bool Shadow = true;
    private bool UseGradient = true;
    private string Bg = "#1f2430";
    private string GradFrom = "#f97316";
    private string GradTo = "#7c3aed";
    private double GradAngle = 120;
    private string Border = "#f8fafc";
    private double BorderWidth = 1;
    private double ArrowSize = 8;
    private double Offset = 8;
    private string Width = "";
    private string Height = "";
    private TooltipTextAlign? TextAlign;
    private TooltipVerticalAlign? VerticalAlign;

    private string HatchClass = "";
    private string HatchStyle = "";
    private string HatchTitle = "";

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<AtomPaintedTooltip");
            sb.Append($" Text=\"{Text}\"");
            if (Placement != Placement.Top) sb.Append($" Placement=\"Placement.{Placement}\"");
            if (Shape != PaintedTooltipShape.Rectangle) sb.Append($" Shape=\"PaintedTooltipShape.{Shape}\"");
            if (!ShowArrow) sb.Append(" ShowArrow=\"false\"");
            if (!Shadow) sb.Append(" Shadow=\"false\"");
            if (UseGradient)
            {
                sb.Append($" GradientFrom=\"{GradFrom}\" GradientTo=\"{GradTo}\"");
                if (GradAngle != 120) sb.Append($" GradientAngle=\"{GradAngle}\"");
            }
            else
            {
                sb.Append($" Background=\"{Bg}\"");
            }
            sb.Append($" BorderColor=\"{Border}\"");
            if (BorderWidth != 1) sb.Append($" BorderWidth=\"{BorderWidth}\"");
            if (ArrowSize != 8) sb.Append($" ArrowSize=\"{ArrowSize}\"");
            if (Offset != 8) sb.Append($" Offset=\"{Offset}\"");
            if (!string.IsNullOrWhiteSpace(Width)) sb.Append($" Width=\"{Width}\"");
            if (!string.IsNullOrWhiteSpace(Height)) sb.Append($" Height=\"{Height}\"");
            if (TextAlign is not null) sb.Append($" TextAlign=\"TooltipTextAlign.{TextAlign}\"");
            if (VerticalAlign is not null) sb.Append($" VerticalAlign=\"TooltipVerticalAlign.{VerticalAlign}\"");
            if (!string.IsNullOrEmpty(HatchClass)) sb.Append($" CssClass=\"{HatchClass}\"");
            if (!string.IsNullOrEmpty(HatchStyle)) sb.Append($" Style=\"{HatchStyle}\"");
            if (!string.IsNullOrEmpty(HatchTitle)) sb.Append($" title=\"{HatchTitle}\"");
            sb.Append(">\n    <button>Hover or Tab to me</button>\n</AtomPaintedTooltip>");
            return sb.ToString();
        }
    }
}
