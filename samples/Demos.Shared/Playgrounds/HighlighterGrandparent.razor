@using BlazorAtoms.Highlights

@* The wrapper lives here, in the outermost component — it highlights its own heading plus
   everything Parent/Child render below it, without either of those components knowing
   AtomHighlighter exists. *@
<AtomHighlighter Keywords="@Keywords"
                 HighlightClass="@HighlightClass"
                 CaseSensitive="@CaseSensitive"
                 WholeWord="@WholeWord"
                 HighlightStyle="@HighlightStyle"
                 Background="@Background"
                 Color="@Color"
                 Radius="@Radius"
                 Padding="@Padding">
    <h1>Grandparent component</h1>
    <HighlighterParent />
</AtomHighlighter>

@code {
    [Parameter] public string[] Keywords { get; set; } = [];

    [Parameter] public string HighlightClass { get; set; } = "atom-highlighter";

    [Parameter] public bool CaseSensitive { get; set; }

    [Parameter] public bool WholeWord { get; set; }

    [Parameter] public HighlightStyle HighlightStyle { get; set; } = HighlightStyle.Mark;

    [Parameter] public string? Background { get; set; }

    [Parameter] public string? Color { get; set; }

    [Parameter] public double? Radius { get; set; }

    [Parameter] public string? Padding { get; set; }
}
