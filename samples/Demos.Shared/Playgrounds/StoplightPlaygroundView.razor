@using System.Globalization
@using BlazorAtoms.Equipment

<PageTitle>AtomStoplight Playground</PageTitle>

<h1>AtomStoplight playground</h1>
<p>Tune <code>&lt;AtomStoplight&gt;</code> live. A traditional red/yellow/green traffic signal drawn as
   pure inline SVG &mdash; rim/glass/sheen lamps under a small visor, the active one (picked by
   <code>State</code>) switching from a dim tint to its full hue with a <code>currentColor</code> glow.
   First of a planned family of semi-realistic status indicators for physical objects.</p>
<p><a href="playground/activityindicators">&larr; Back to demo</a></p>

<div class="sl-stage">
    <AtomStoplight State="@State" Orientation="@Orientation" Width="@WidthV"
                   RedColor="@Nz(RedColor)" YellowColor="@Nz(YellowColor)" GreenColor="@Nz(GreenColor)"
                   AriaLabel="@Nz(AriaLabel)"
                   CssClass="@Nz(HatchClass)" Style="@Nz(HatchStyle)" title="@Nz(HatchTitle)" />
</div>

<div class="sl-controls">
    <div class="ctrl">
        <label>State</label>
        <select @bind="State">
            @foreach (var s in States) { <option value="@s">@s</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Orientation</label>
        <select @bind="Orientation">
            @foreach (var o in Orientations) { <option value="@o">@o</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Width (px) <span class="val">@WidthV.ToString(Inv)</span></label>
        <input type="range" min="48" max="240" step="4" @bind="WidthV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Red color (RedColor)</label>
        <div class="row color">
            <input type="color" @bind="RedColor" @bind:event="oninput" aria-label="Red color picker" />
            <input type="text" @bind="RedColor" @bind:event="oninput" placeholder="(default)" />
        </div>
    </div>
    <div class="ctrl">
        <label>Yellow color (YellowColor)</label>
        <div class="row color">
            <input type="color" @bind="YellowColor" @bind:event="oninput" aria-label="Yellow color picker" />
            <input type="text" @bind="YellowColor" @bind:event="oninput" placeholder="(default)" />
        </div>
    </div>
    <div class="ctrl">
        <label>Green color (GreenColor)</label>
        <div class="row color">
            <input type="color" @bind="GreenColor" @bind:event="oninput" aria-label="Green color picker" />
            <input type="text" @bind="GreenColor" @bind:event="oninput" placeholder="(default)" />
        </div>
    </div>
    <div class="ctrl">
        <label>Aria label (AriaLabel)</label>
        <input type="text" @bind="AriaLabel" @bind:event="oninput" placeholder="(auto)" />
    </div>
    <div class="ctrl">
        <label>Extra class (CssClass)</label>
        <input type="text" @bind="HatchClass" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Extra style (Style)</label>
        <input type="text" @bind="HatchStyle" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>title attr (splat)</label>
        <input type="text" @bind="HatchTitle" @bind:event="oninput" placeholder="(none)" />
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomStoplightExample.razor" />

<style>
    .sl-stage { display:flex; justify-content:center; background:#0a0a0c; border:1px solid #d0d0d8; border-radius:12px; padding:2.5rem 1.5rem; margin-bottom:1.5rem; }
    .sl-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 1.5rem; background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; }
    .sl-controls .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .sl-controls label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .sl-controls label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .sl-controls input[type=range] { width:100%; accent-color:#ff3b30; }
    .sl-controls input[type=text], .sl-controls select { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .sl-controls .row.color { display:flex; align-items:center; gap:.4rem; }
    .sl-controls .row.color input[type=color] { flex:none; width:38px; height:32px; padding:2px; background:#070b10; border:1px solid #1b2330; border-radius:6px; cursor:pointer; }
    .sl-controls .row.color input[type=text] { flex:1 1 auto; min-width:0; }
</style>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static readonly StoplightState[] States = (StoplightState[])Enum.GetValues(typeof(StoplightState));
    private static readonly StoplightOrientation[] Orientations = (StoplightOrientation[])Enum.GetValues(typeof(StoplightOrientation));

    private StoplightState State = StoplightState.Red;
    private StoplightOrientation Orientation = StoplightOrientation.Vertical;
    private double WidthV = 96;

    private string RedColor = "";
    private string YellowColor = "";
    private string GreenColor = "";
    private string AriaLabel = "";

    private string HatchClass = "";
    private string HatchStyle = "";
    private string HatchTitle = "";

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<AtomStoplight");
            if (State != StoplightState.Red) sb.Append($" State=\"StoplightState.{State}\"");
            if (Orientation != StoplightOrientation.Vertical) sb.Append($" Orientation=\"StoplightOrientation.{Orientation}\"");
            if (WidthV != 96) sb.Append($" Width=\"{WidthV.ToString(Inv)}\"");
            if (!string.IsNullOrEmpty(RedColor)) sb.Append($" RedColor=\"{RedColor}\"");
            if (!string.IsNullOrEmpty(YellowColor)) sb.Append($" YellowColor=\"{YellowColor}\"");
            if (!string.IsNullOrEmpty(GreenColor)) sb.Append($" GreenColor=\"{GreenColor}\"");
            if (!string.IsNullOrEmpty(AriaLabel)) sb.Append($" AriaLabel=\"{AriaLabel}\"");
            if (!string.IsNullOrEmpty(HatchClass)) sb.Append($" CssClass=\"{HatchClass}\"");
            if (!string.IsNullOrEmpty(HatchStyle)) sb.Append($" Style=\"{HatchStyle}\"");
            if (!string.IsNullOrEmpty(HatchTitle)) sb.Append($" title=\"{HatchTitle}\"");
            sb.Append(" />");
            return sb.ToString();
        }
    }
}
