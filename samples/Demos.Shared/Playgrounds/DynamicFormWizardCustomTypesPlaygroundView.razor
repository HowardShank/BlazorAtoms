@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Rendering
@using BlazorAtoms.DynamicFormWizard
@using BlazorAtoms.DynamicFormWizard.Attributes

<PageTitle>Dynamic Form Wizard — Custom Types Playground</PageTitle>

<h1>Dynamic Form Wizard — 5 steps, 2 different custom-type renderers</h1>
<p>A 5-step model with two distinct consumer-registered types via <code>FieldRenderers</code>
   (EXTENSIBILITY.md's type-registry seam, tier 1 of the field dispatch): <code>Money</code> on
   step 2, a 1-5 <code>StarRating</code> on step 4. Every other step uses the built-in dispatch.</p>
<p><a href="playground/dynamicformwizard">&larr; Back to the main Dynamic Form Wizard playground</a></p>

<div class="dfw-columns">
    <div class="dfw-wizard">
        @if (_completed is null)
        {
            <DynamicWizard TModel="ProjectSetupModel" Model="_model" OnWizardComplete="HandleComplete" FieldRenderers="_renderers" />
        }
        else
        {
            <p>
                <strong>Submitted!</strong> Project=@_completed.ProjectName, Type=@_completed.Type,
                Budget=@_completed.Budget.Amount @_completed.Budget.Currency,
                Target=@_completed.TargetDate.ToShortDateString(), Satisfaction=@_completed.ExpectedSatisfaction.Stars stars
            </p>
            <button type="button" @onclick="Reset">Start over</button>
        }
    </div>

    <div class="dfw-source">
        <h2>The POCO</h2>
        <pre><code>@PocoSource</code></pre>
    </div>
</div>

@code {
    private ProjectSetupModel _model = new();
    private ProjectSetupModel? _completed;

    private readonly Dictionary<Type, Type> _renderers = new()
    {
        [typeof(Money)] = typeof(MoneyInput),
        [typeof(StarRating)] = typeof(StarRatingInput),
    };

    private void HandleComplete(ProjectSetupModel model) => _completed = model;

    private void Reset()
    {
        _model = new();
        _completed = null;
    }

    public enum ProjectType { Internal, Client }

    public record Money(decimal Amount, string Currency);

    public record StarRating(int Stars);

    public class ProjectSetupModel
    {
        [FormStep(1, "Project Basics")]
        [FormOrder(1)]
        [Required(ErrorMessage = "Project name is required.")]
        public string ProjectName { get; set; } = string.Empty;

        [FormStep(1)]
        [FormOrder(2)]
        public ProjectType Type { get; set; } = ProjectType.Internal;

        [FormStep(2, "Budget")]
        public Money Budget { get; set; } = new(0m, "USD");

        [FormStep(3, "Timeline")]
        public DateTime TargetDate { get; set; } = DateTime.Today.AddMonths(1);

        [FormStep(4, "Satisfaction")]
        public StarRating ExpectedSatisfaction { get; set; } = new(3);

        [FormStep(5, "Confirm")]
        public bool AcceptTerms { get; set; }
    }

    // Custom type 1: Money -- one currency-formatted input, not auto-expanded into two fields.
    private class MoneyInput : ComponentBase
    {
        [Parameter] public Money Value { get; set; } = new(0m, "USD");
        [Parameter] public EventCallback<Money> ValueChanged { get; set; }

        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "dfw-money");

            builder.OpenElement(2, "input");
            builder.AddAttribute(3, "type", "number");
            builder.AddAttribute(4, "step", "0.01");
            builder.AddAttribute(5, "value", Value.Amount);
            builder.AddAttribute(6, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, async e =>
            {
                if (decimal.TryParse(e.Value?.ToString(), out var amount))
                {
                    await ValueChanged.InvokeAsync(Value with { Amount = amount });
                }
            }));
            builder.CloseElement();

            builder.OpenElement(7, "select");
            builder.AddAttribute(8, "value", Value.Currency);
            builder.AddAttribute(9, "onchange", EventCallback.Factory.Create<ChangeEventArgs>(this, async e =>
            {
                await ValueChanged.InvokeAsync(Value with { Currency = e.Value?.ToString() ?? "USD" });
            }));
            foreach (var currency in new[] { "USD", "EUR", "GBP" })
            {
                builder.OpenElement(10, "option");
                builder.AddAttribute(11, "value", currency);
                builder.AddContent(12, currency);
                builder.CloseElement();
            }
            builder.CloseElement();

            builder.CloseElement();
        }
    }

    // Custom type 2: a 1-5 star click picker -- a completely different shape from Money, proving
    // the registry isn't special-cased to any one kind of custom type.
    private class StarRatingInput : ComponentBase
    {
        [Parameter] public StarRating Value { get; set; } = new(0);
        [Parameter] public EventCallback<StarRating> ValueChanged { get; set; }

        protected override void BuildRenderTree(RenderTreeBuilder builder)
        {
            builder.OpenElement(0, "span");
            builder.AddAttribute(1, "class", "dfw-stars");

            for (var i = 1; i <= 5; i++)
            {
                var star = i;
                builder.OpenElement(2, "button");
                builder.AddAttribute(3, "type", "button");
                builder.AddAttribute(4, "class", star <= Value.Stars ? "dfw-star dfw-star--filled" : "dfw-star");
                builder.AddAttribute(5, "onclick", EventCallback.Factory.Create(this, () => ValueChanged.InvokeAsync(new StarRating(star))));
                builder.AddContent(6, "★");
                builder.CloseElement();
            }

            builder.CloseElement();
        }
    }

    private const string PocoSource = """
        public enum ProjectType { Internal, Client }

        public record Money(decimal Amount, string Currency);
        public record StarRating(int Stars);

        public class ProjectSetupModel
        {
            [FormStep(1, "Project Basics")] [FormOrder(1)]
            [Required(ErrorMessage = "Project name is required.")]
            public string ProjectName { get; set; } = string.Empty;

            [FormStep(1)] [FormOrder(2)]
            public ProjectType Type { get; set; } = ProjectType.Internal;

            [FormStep(2, "Budget")]
            public Money Budget { get; set; } = new(0m, "USD");   // custom renderer: MoneyInput

            [FormStep(3, "Timeline")]
            public DateTime TargetDate { get; set; } = DateTime.Today.AddMonths(1);

            [FormStep(4, "Satisfaction")]
            public StarRating ExpectedSatisfaction { get; set; } = new(3);  // custom renderer: StarRatingInput

            [FormStep(5, "Confirm")]
            public bool AcceptTerms { get; set; }
        }

        // Registered on the wizard: FieldRenderers = new() {
        //     [typeof(Money)] = typeof(MoneyInput),
        //     [typeof(StarRating)] = typeof(StarRatingInput),
        // }
        """;
}

<style>
    .dfw-columns {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 2rem;
        align-items: start;
    }

    .dfw-source pre {
        background: #1e1e2e;
        color: #cdd6f4;
        padding: 1rem;
        border-radius: 0.5rem;
        overflow-x: auto;
        font-size: 0.85rem;
        line-height: 1.5;
    }

    .dfw-money {
        display: inline-flex;
        gap: 0.4rem;
    }

    .dfw-stars {
        display: inline-flex;
        gap: 0.15rem;
    }

    .dfw-star {
        font-size: 1.4rem;
        line-height: 1;
        background: none;
        border: none;
        cursor: pointer;
        color: #d1d5db;
    }

    .dfw-star--filled {
        color: #f59e0b;
    }

    @@media (max-width: 900px) {
        .dfw-columns {
            grid-template-columns: 1fr;
        }
    }
</style>
