@using System.Globalization
@using System.Text
@using BlazorAtoms.Data

<PageTitle>AtomDataHasher Playground</PageTitle>

<h1>AtomDataHasher playground</h1>
<p>Live CRC / cryptographic hash of arbitrary text. Type on the left, hex digest on the right —
   updates every keystroke. CRC-32 / CRC-64 use the library's own table-based engines (no
   <c>System.IO.Hashing</c> dependency); MD5 / SHA-256 / SHA-512 wrap
   <c>System.Security.Cryptography</c>.</p>
<p><a href="demo">&larr; Back to demo</a></p>

<div class="hasher-stage">
    <AtomDataHasher Label="@Nz(Label)"
                    @bind-Value="Value"
                    @bind-Algorithm="Algorithm"
                    Multiline="@Multiline"
                    Rows="@RowsV"
                    Width="@(WidthV > 0 ? WidthV : null)"
                    ShowAlgorithmPicker="@ShowPicker"
                    AlgorithmLabel="@AlgorithmLabelV"
                    ResultLabel="@ResultLabelV"
                    ResultColor="@Nz(ResultColorV)"
                    ResultBackgroundColor="@Nz(ResultBgColorV)"
                    Disabled="@Disabled"
                    ReadOnly="@ReadOnly"
                    Visible="@Visible"
                    Placeholder="@Nz(Placeholder)"
                    HelpText="@Nz(HelpText)" />
</div>

<div class="hasher-controls">
    <div class="ctrl">
        <label>Value</label>
        <textarea rows="3" @bind="Value" @bind:event="oninput"></textarea>
    </div>
    <div class="ctrl">
        <label>Algorithm</label>
        <select @bind="Algorithm">
            @foreach (var a in Algs) { <option value="@a">@a</option> }
        </select>
    </div>
    <div class="ctrl">
        <label>Label</label>
        <input type="text" @bind="Label" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Algorithm picker label</label>
        <input type="text" @bind="AlgorithmLabelV" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>Result label</label>
        <input type="text" @bind="ResultLabelV" @bind:event="oninput" />
    </div>
    <div class="ctrl">
        <label>Placeholder</label>
        <input type="text" @bind="Placeholder" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Help text</label>
        <input type="text" @bind="HelpText" @bind:event="oninput" placeholder="(none)" />
    </div>
    <div class="ctrl">
        <label>Result color (ResultColor)</label>
        <div class="row color">
            <input type="color" @bind="ResultColorV" @bind:event="oninput" aria-label="Result color picker" />
            <input type="text" @bind="ResultColorV" @bind:event="oninput" placeholder="(css default)" />
            <button type="button" class="clr-btn" @onclick="() => ResultColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>Result background (ResultBackgroundColor)</label>
        <div class="row color">
            <input type="color" @bind="ResultBgColorV" @bind:event="oninput" aria-label="Result bg color picker" />
            <input type="text" @bind="ResultBgColorV" @bind:event="oninput" placeholder="(css default)" />
            <button type="button" class="clr-btn" @onclick="() => ResultBgColorV = string.Empty">Clear</button>
        </div>
    </div>
    <div class="ctrl">
        <label>Width (px, 0 = auto) <span class="val">@WidthV.ToString(Inv)</span></label>
        <input type="range" min="0" max="900" step="10" @bind="WidthV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Rows (multiline) <span class="val">@RowsV</span></label>
        <input type="range" min="1" max="20" step="1" @bind="RowsV" @bind:event="oninput" @bind:culture="Inv" />
    </div>
    <div class="ctrl">
        <label>Mode</label>
        <div class="row"><input type="checkbox" id="dhMulti" @bind="Multiline" /><label for="dhMulti" class="inline">Multiline (textarea)</label></div>
        <div class="row"><input type="checkbox" id="dhPick" @bind="ShowPicker" /><label for="dhPick" class="inline">Show algorithm picker</label></div>
        <div class="row"><input type="checkbox" id="dhVis" @bind="Visible" /><label for="dhVis" class="inline">Visible</label></div>
        <div class="row"><input type="checkbox" id="dhDis" @bind="Disabled" /><label for="dhDis" class="inline">Disabled</label></div>
        <div class="row"><input type="checkbox" id="dhRead" @bind="ReadOnly" /><label for="dhRead" class="inline">ReadOnly (= Disabled)</label></div>
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="AtomDataHasherExample.razor" />

<style>
    .hasher-stage { background:#f8fafc; border:1px solid #cbd5e1; border-radius:12px; padding:1.5rem; margin-bottom:1.5rem; }
    .hasher-controls { display:grid; grid-template-columns:repeat(auto-fit,minmax(230px,1fr)); gap:1rem 1.5rem; background:#0d1118; border:1px solid #1b2330; border-radius:12px; padding:1.25rem 1.5rem; color:#cfd8e3; margin-bottom:1.5rem; }
    .hasher-controls .ctrl { display:flex; flex-direction:column; gap:.4rem; }
    .hasher-controls label { font-size:.8rem; text-transform:uppercase; letter-spacing:.06em; color:#8794a3; display:flex; justify-content:space-between; gap:.5rem; }
    .hasher-controls label .val { color:#5fb7c9; font-family:ui-monospace,Consolas,monospace; text-transform:none; }
    .hasher-controls input[type=range] { width:100%; accent-color:#2563eb; }
    .hasher-controls input[type=text], .hasher-controls select, .hasher-controls textarea { padding:.45rem .5rem; border-radius:6px; border:1px solid #1b2330; background:#070b10; color:#e6edf3; font-family:ui-monospace,monospace; }
    .hasher-controls .row { display:flex; align-items:center; gap:.5rem; }
    .hasher-controls .row input[type=checkbox] { accent-color:#2563eb; width:16px; height:16px; }
    .hasher-controls .row.color { gap:.4rem; }
    .hasher-controls .row.color input[type=color] { flex:none; width:38px; height:32px; padding:2px; background:#070b10; border:1px solid #1b2330; border-radius:6px; cursor:pointer; }
    .hasher-controls .row.color input[type=text] { flex:1 1 auto; min-width:0; }
    .hasher-controls .clr-btn { flex:none; padding:.35rem .55rem; border:1px solid #1b2330; background:#161d29; color:#cfd8e3; border-radius:6px; cursor:pointer; font-size:.75rem; }
    .hasher-controls .clr-btn:hover { background:#1e2836; }
    .hasher-controls .row label.inline { text-transform:none; letter-spacing:0; color:#cfd8e3; font-size:.85rem; justify-content:flex-start; }
</style>

@code {
    private static readonly CultureInfo Inv = CultureInfo.InvariantCulture;
    private static readonly HashAlgorithmKind[] Algs = (HashAlgorithmKind[])Enum.GetValues(typeof(HashAlgorithmKind));

    private string Value = "The quick brown fox jumps over the lazy dog";
    private string Label = "Payload";
    private string Placeholder = "Type or paste text to hash";
    private string HelpText = "Digest updates on every keystroke.";
    private string AlgorithmLabelV = "Algorithm";
    private string ResultLabelV = "Result";
    private string ResultColorV = "";
    private string ResultBgColorV = "";
    private HashAlgorithmKind Algorithm = HashAlgorithmKind.Crc32;
    private double WidthV = 0;
    private int RowsV = 5;
    private bool Multiline = true;
    private bool ShowPicker = true;
    private bool Visible = true;
    private bool Disabled;
    private bool ReadOnly;

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private string Snippet
    {
        get
        {
            var sb = new StringBuilder("<AtomDataHasher");
            if (!string.IsNullOrEmpty(Label)) sb.Append($" Label=\"{Label}\"");
            sb.Append(" @bind-Value=\"value\"");
            if (Algorithm != HashAlgorithmKind.Crc32) sb.Append($" Algorithm=\"HashAlgorithmKind.{Algorithm}\"");
            if (!Multiline) sb.Append(" Multiline=\"false\"");
            if (RowsV != 5 && Multiline) sb.Append($" Rows=\"{RowsV}\"");
            if (WidthV > 0) sb.Append($" Width=\"{WidthV.ToString(Inv)}\"");
            if (!ShowPicker) sb.Append(" ShowAlgorithmPicker=\"false\"");
            if (AlgorithmLabelV != "Algorithm") sb.Append($" AlgorithmLabel=\"{AlgorithmLabelV}\"");
            if (ResultLabelV != "Result") sb.Append($" ResultLabel=\"{ResultLabelV}\"");
            if (!string.IsNullOrEmpty(ResultColorV)) sb.Append($" ResultColor=\"{ResultColorV}\"");
            if (!string.IsNullOrEmpty(ResultBgColorV)) sb.Append($" ResultBackgroundColor=\"{ResultBgColorV}\"");
            if (!Visible) sb.Append(" Visible=\"false\"");
            if (Disabled) sb.Append(" Disabled=\"true\"");
            if (ReadOnly) sb.Append(" ReadOnly=\"true\"");
            if (!string.IsNullOrEmpty(Placeholder)) sb.Append($" Placeholder=\"{Placeholder}\"");
            if (!string.IsNullOrEmpty(HelpText)) sb.Append($" HelpText=\"{HelpText}\"");
            sb.Append(" />");
            return sb.ToString();
        }
    }
}
