    private void OnClosed(RadialMenuItem item) => LastEvent = $"OnBranchClosed: {item.Label}";

    // ---- "unset" helpers ----------------------------------------------------------------------

    private static string? Nz(string s) => string.IsNullOrWhiteSpace(s) ? null : s;

    private static double? NzD(string s) =>
        double.TryParse(s, NumberStyles.Float, Inv, out var v) ? v : null;

    private static int? NzI(string s) =>
        int.TryParse(s, NumberStyles.Integer, Inv, out var v) ? v : null;

    // ---- snippet ------------------------------------------------------------------------------

    // Emitted one attribute per line, aligned under the tag name. The flat single-line form ran past
    // 250 characters once a handful of controls were off their defaults: unreadable in the snippet
    // box and unreadable once pasted into a file. Attributes are collected first and then joined, so
    // every guard stays one self-contained line.
    private const string SnippetPad = "                ";   // aligns under "<AtomRadialMenu "

    private string Snippet
    {
        get
        {
            var a = new List<string> { "Items=\"@items\"", "@bind-Open=\"open\"" };

            if (StartAngleV != 0) a.Add($"StartAngle=\"{StartAngleV.ToString(Inv)}\"");
            if (EndAngleV != 360) a.Add($"EndAngle=\"{EndAngleV.ToString(Inv)}\"");
            if (DistributionV != RadialMenuDistribution.Auto) a.Add($"Distribution=\"RadialMenuDistribution.{DistributionV}\"");
            if (NzD(AngleStepV) is double step) a.Add($"AngleStep=\"{step.ToString(Inv)}\"");
            if (DirectionV != RadialMenuDirection.Clockwise) a.Add($"Direction=\"RadialMenuDirection.{DirectionV}\"");

            if (NzD(RadiusV) is double radius) a.Add($"Radius=\"{radius.ToString(Inv)}\"");
            if (RadiusModeV != RadialMenuRadiusMode.Auto) a.Add($"RadiusMode=\"RadialMenuRadiusMode.{RadiusModeV}\"");
            if (NzD(MaxRadiusV) is double maxRadius) a.Add($"MaxRadius=\"{maxRadius.ToString(Inv)}\"");
            if (OverflowV != RadialMenuOverflow.GrowRadius) a.Add($"Overflow=\"RadialMenuOverflow.{OverflowV}\"");
            if (NzI(MaxPerRingV) is int perRing) a.Add($"MaxPerRing=\"{perRing}\"");
            if (PageSizeV != 8) a.Add($"PageSize=\"{PageSizeV}\"");
            if (VisibleCountV != 8) a.Add($"VisibleCount=\"{VisibleCountV}\"");
            if (RingGapV != 16) a.Add($"RingGap=\"{RingGapV.ToString(Inv)}\"");
            if (ItemGapV != 8) a.Add($"ItemGap=\"{ItemGapV.ToString(Inv)}\"");
            if (CrowdingV != 12) a.Add($"CrowdingWarnThreshold=\"{CrowdingV}\"");
            if (NzI(MaxVisibleDepthV) is int levels) a.Add($"MaxVisibleDepth=\"{levels}\"");

            if (CenterSizeV != 64) a.Add($"CenterSize=\"{CenterSizeV.ToString(Inv)}\"");
            if (ItemSizeV != 48) a.Add($"ItemSize=\"{ItemSizeV.ToString(Inv)}\"");
            if (MinItemSizeV != 24) a.Add($"MinItemSize=\"{MinItemSizeV.ToString(Inv)}\"");
            if (SizeModeV != RadialMenuSizeMode.Fixed) a.Add($"SizeMode=\"RadialMenuSizeMode.{SizeModeV}\"");
            if (SizeScaleV != 0.9) a.Add($"SizeScalePerDepth=\"{SizeScaleV.ToString(Inv)}\"");
            if (SizeStepV != 4) a.Add($"SizeStep=\"{SizeStepV.ToString(Inv)}\"");
            if (FontSizeV != 13) a.Add($"FontSize=\"{FontSizeV.ToString(Inv)}\"");
            if (LineHeightV != 1.2) a.Add($"LineHeight=\"{LineHeightV.ToString(Inv)}\"");
