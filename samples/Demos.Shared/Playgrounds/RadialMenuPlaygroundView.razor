    // ---- events -------------------------------------------------------------------------------

    private void OnInvoked(RadialMenuItem item) => LastEvent = $"OnItemInvoked: {item.Label ?? item.Tooltip}";
    private async Task OnOpened(RadialMenuItem item)
    {
        LastEvent = $"OnBranchOpened: {item.Label}";

        if (SourceV != ItemSource.LazyTree
            || item.Data is not string key
            || !_lazyLoaded.Add(key))          // Add returns false if it was already fetched
