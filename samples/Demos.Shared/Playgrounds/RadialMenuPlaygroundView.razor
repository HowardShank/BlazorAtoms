    private string? LastEvent;

    // ---- items --------------------------------------------------------------------------------

    private string SourceHint => SourceV switch
    {
        ItemSource.LongLabels => "Long labels: switch SizeMode to FromFont or Measure to watch the shapes grow to fit.",
        ItemSource.IconsOnly => "No labels at all — the case for LabelPlacement=TooltipOnly.",
        ItemSource.NestedTree => "Three levels deep. Try each ExpandMode.",
        ItemSource.DeepTree => "Five levels, several children at every level. Turn on Debug and read the path on each tag. Cascade gets huge by level 4; Drill stays the same size at any depth.",
        ItemSource.WithDisabled => "Every third item is disabled, and keyboard navigation skips them.",
        ItemSource.LazyTree => "Children are fetched when a branch opens. Each unloaded branch carries one disabled \"Loading\" child, because an item with no children is a LEAF and could not be opened at all. Three fetch levels, then leaves.",
        _ => "Plain leaves, count driven by the slider.",
    };

    private IReadOnlyList<RadialMenuItem> CurrentItems => SourceV switch
    {
        ItemSource.LongLabels => Build(i => new RadialMenuItem { Label = LongLabels[i % LongLabels.Length] }),
        ItemSource.IconsOnly => Build(i => new RadialMenuItem { Tooltip = $"Action {i + 1}" }),
        ItemSource.WithDisabled => Build(i => new RadialMenuItem { Label = $"Item {i + 1}", Disabled = i % 3 == 2 }),
        ItemSource.NestedTree => Tree,
        ItemSource.DeepTree => Deep,
        ItemSource.LazyTree => _lazy,
        _ => Build(i => new RadialMenuItem { Label = $"Item {i + 1}" }),
    };

    // ---- LazyTree: children fetched when a branch opens ---------------------------------------
    // AtomRadialMenu adds the path to its open set and rebuilds its rings BEFORE it awaits
    // OnBranchOpened, so by the time this handler runs the branch is already open. Handing back the
    // real children just renders them - the user never clicks twice.

    private RadialMenuItem[] _lazy = LazyRoots();
    private readonly HashSet<string> _lazyLoaded = [];
    private string? _lazyBusy;
    private int _lazyFetches;

    /// <summary>
    /// A branch whose children have not arrived yet. The single placeholder child is load-bearing:
    /// IsBranch is <c>Children is { Count: &gt; 0 }</c>, so without it the item would be a LEAF -
    /// clicking it would raise OnItemInvoked, never OnBranchOpened, and CloseOnLeafInvoke would shut
    /// the menu. Disabled so the placeholder itself cannot be activated.
    /// </summary>
    private static RadialMenuItem LazyBranch(string key, string label) => new()
    {
        Label = label,
        Data = key,
        Children = [new RadialMenuItem { Label = "Loading\u2026", Disabled = true }],
    };

    private static RadialMenuItem[] LazyRoots() =>
    [
        LazyBranch("customers", "Customers"),
        LazyBranch("orders", "Orders"),
        LazyBranch("reports", "Reports"),
        LazyBranch("admin", "Admin"),
    ];

    private async Task ReloadLazyData()
    {
        // Collapse BEFORE swapping the data in. Open paths are positional, so any left behind would
        // keep branches expanded on paths into the OLD tree, and the next click on one would close it
        // rather than load it. Open=false is not enough here: under Trigger=Always the menu is pinned
        // open and never runs the close path that clears them, which is exactly why
        // CollapseAllAsync exists.
        if (_menu is not null) await _menu.CollapseAllAsync();

        _lazy = LazyRoots();
        _lazyLoaded.Clear();
        _lazyFetches = 0;
        _lazyBusy = null;

        // After the collapse, because it raises OnBranchClosed for each branch it closed and those
        // handlers write LastEvent.
        LastEvent = "data set reloaded";
    }

    /// <summary>The fake API. Stops handing back branches at the third level so the example ends.</summary>
    private static RadialMenuItem[] Fetch(string key)
    {
        var depth = key.Count(c => c == '/');
        var names = depth switch
        {
            0 => key switch
            {
                "customers" => new[] { "Active", "Lapsed", "Prospects" },
                "orders" => ["Open", "Shipped", "Returned"],
                "reports" => ["Daily", "Monthly"],
                _ => ["Users", "Roles", "Audit"],
            },
            1 => ["This year", "Last year", "Archive"],
            _ => ["Summary", "Detail"],
        };

        return names
            .Select((name, i) => depth < 2
                ? LazyBranch($"{key}/{i}", name)
                : new RadialMenuItem { Label = name, Data = $"{key}/{i}" })
            .ToArray();
    }

    /// <summary>
    /// Rebuilds the tree with <paramref name="children"/> under the node whose <c>Data</c> is
    /// <paramref name="key"/>. RadialMenuItem is init-only, so a change anywhere means new instances
    /// down the spine - which is exactly what a data-driven menu does anyway. Positions are preserved,
    /// because the component's open paths are index-based.
    /// </summary>
    private static RadialMenuItem[] WithChildren(
        IReadOnlyList<RadialMenuItem> items, string key, IReadOnlyList<RadialMenuItem> children) =>
        items.Select(item =>
            item.Data as string == key
                ? Clone(item, children)
                : item.Children is { Count: > 0 } kids
                    ? Clone(item, WithChildren(kids, key, children))
                    : item)
            .ToArray();

    private static RadialMenuItem Clone(RadialMenuItem item, IReadOnlyList<RadialMenuItem> children) => new()
    {
        Id = item.Id,
        Label = item.Label,
        Icon = item.Icon,
        Tooltip = item.Tooltip,
        Disabled = item.Disabled,
        Data = item.Data,
        StartAngle = item.StartAngle,
        EndAngle = item.EndAngle,
        Shape = item.Shape,
        CssClass = item.CssClass,
        Children = children,
    };

    private RadialMenuItem[] Build(Func<int, RadialMenuItem> make) =>
        Enumerable.Range(0, Math.Max(1, CountV)).Select(make).ToArray();

    private static readonly string[] LongLabels =
        ["Duplicate selection", "Cut", "Bring to front", "Export as SVG", "Paste in place", "Group"];

    private static readonly RadialMenuItem[] Tree =
    [
        new RadialMenuItem
        {
            Label = "Shape",
