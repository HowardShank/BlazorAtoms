@using BlazorAtoms.Screensavers

<PageTitle>ScreensaverRain Playground</PageTitle>

<h1>ScreensaverRain playground</h1>
<p>
    Matrix-style digital rain. Use the controls below to experiment with the display options.
    The canvas is driven by a small JS module and is disposed automatically when you leave the page.
</p>
<p><a href="playground/activityindicators">&larr; Back to demo</a></p>

<div class="ss-stage">
    <div class="ss-pane ss-preview">
        <h2>Preview</h2>
        <ScreensaverRain @ref="_screensaver"
                         TextColor="@TextColor"
                         BackgroundColor="@BackgroundColor"
                         FontFamily="@FontFamily"
                         FontSize="@FontSize"
                         Speed="@Speed"
                         Glow="@Glow"
                         Scanlines="@Scanlines"
                         Width="@Width"
                         Height="@Height"
                         Disabled="@Disabled" />
    </div>

    <div class="ss-pane ss-controls">
        <h2>Controls</h2>
        <div class="ss-ctrl">
            <button type="button" @onclick="Start">Start Rain</button>
            <button type="button" @onclick="Stop">Stop Rain</button>
        </div>
        <div class="ss-ctrl">
            <label>Text color</label>
            <input type="color" @bind="TextColor" @bind:event="oninput" />
            <span>@TextColor</span>
        </div>
        <div class="ss-ctrl">
            <label>Background color</label>
            <input type="color" @bind="BackgroundColor" @bind:event="oninput" />
            <span>@BackgroundColor</span>
        </div>
        <div class="ss-ctrl">
            <label>Font family</label>
            <select @bind="FontFamily">
                <option value="monospace">Monospace</option>
                <option value="'Courier New', monospace">Courier New</option>
                <option value="monospace, sans-serif">Sans-serif fallback</option>
            </select>
        </div>
        <div class="ss-ctrl">
            <label>Font size <span class="val">@FontSize px</span></label>
            <input type="range" min="8" max="32" step="1" @bind="FontSize" @bind:event="oninput" />
        </div>
        <div class="ss-ctrl">
            <label>Speed <span class="val">@SpeedDisplay</span></label>
            <input type="range" min="0.1" max="3" step="0.1" @bind="Speed" @bind:event="oninput" />
        </div>
        <div class="ss-ctrl">
            <label>
                <input type="checkbox" @bind="Glow" /> Glow
            </label>
        </div>
        <div class="ss-ctrl">
            <label>
                <input type="checkbox" @bind="Scanlines" /> Scanlines
            </label>
        </div>
        <div class="ss-ctrl">
            <label>Width</label>
            <input type="text" @bind="Width" />
        </div>
        <div class="ss-ctrl">
            <label>Height</label>
            <input type="text" @bind="Height" />
        </div>
        <div class="ss-ctrl">
            <label>
                <input type="checkbox" @bind="Disabled" /> Disabled
            </label>
        </div>
    </div>
</div>

<CodeSnippetBox Code="@Snippet" FileName="ScreensaverRainExample.razor" />

@code {
    private string TextColor { get; set; } = "#00FF00";
    private string BackgroundColor { get; set; } = "#222f22";
    private string FontFamily { get; set; } = "monospace";
    private double FontSize { get; set; } = 16;
    private double Speed { get; set; } = 1;
    private bool Glow { get; set; } = true;
    private bool Scanlines { get; set; } = false;
    private string Width { get; set; } = "100%";
    private string Height { get; set; } = "360px";
    private bool Disabled { get; set; }

    private ScreensaverRain _screensaver = default!;

    private string SpeedDisplay => Speed.ToString("0.0", System.Globalization.CultureInfo.InvariantCulture) + "x";

    private async Task Start() => await _screensaver.StartAsync();
    private async Task Stop() => await _screensaver.StopAsync();

    private static string? Nz(string s) => string.IsNullOrEmpty(s) ? null : s;

    private string Snippet
    {
        get
        {
            var sb = new System.Text.StringBuilder("<ScreensaverRain");
            if (TextColor != "#00FF00") sb.Append($" TextColor=\"{TextColor}\"");
            if (BackgroundColor != "#00FF00") sb.Append($" BackgroundColor=\"{BackgroundColor}\"");
            if (FontFamily != "monospace") sb.Append($" FontFamily=\"{FontFamily}\"");
            if (FontSize != 16) sb.Append($" FontSize=\"{FontSize}\"");
            if (Speed != 1) sb.Append($" Speed=\"{Speed}\"");
            if (Glow) sb.Append(" Glow=\"true\"");
            if (Scanlines) sb.Append(" Scanlines=\"true\"");
            if (Width != "100%") sb.Append($" Width=\"{Width}\"");
            if (Height != "360px") sb.Append($" Height=\"{Height}\"");
            if (Disabled) sb.Append(" Disabled=\"true\"");
            sb.Append(" />");
            return sb.ToString();
        }
    }
}
