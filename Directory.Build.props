<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Repo root (with trailing slash) so shared build assets resolve from any project depth. -->
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>

    <!-- Visual Studio's "Fast Up-to-Date Check" skips re-invoking MSBuild on F5/Debug based on a
         cached heuristic, not a real evaluation — it has repeatedly served stale output in this
         repo after adding a new ProjectReference, a new component type in a referenced project, or
         a new file produced by a custom MSBuild Target (e.g. build/SharedJs.props's copy target),
         even though `dotnet build`/`dotnet run` from the CLI picked the change up immediately.
         Disabling it forces VS to always run a real MSBuild evaluation before running/debugging. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>

    <!-- Shared package identity. Per-library PackageId/Version live in each csproj;
         shared pack settings (license/icon/urls/SourceLink) live in build/Packable.props. -->
    <Authors>Howard Shank</Authors>
    <Company>Howard Shank</Company>
    <Product>BlazorAtoms</Product>
  </PropertyGroup>

  <!-- Libraries and their tests multi-target net9.0 + net10.0 (one package/build serves both).
       Demo apps are single-target net10.0 — an app only runs on one TFM at a time.
       Checked against both slash directions — CI runs on Linux, local dev is Windows. -->
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('\src\')) OR $(MSBuildProjectFullPath.Contains('/src/')) OR $(MSBuildProjectFullPath.Contains('\tests\')) OR $(MSBuildProjectFullPath.Contains('/tests/'))">
    <TargetFrameworks>net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <PropertyGroup Condition="$(MSBuildProjectFullPath.Contains('\samples\')) OR $(MSBuildProjectFullPath.Contains('/samples/'))">
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

</Project>
