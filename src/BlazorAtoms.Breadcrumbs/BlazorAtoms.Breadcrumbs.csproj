<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Breadcrumbs</PackageId>
    <Title>Blazor Breadcrumbs</Title>
    <Description>Breadcrumb navigation for Blazor combining static and dynamic trails: [AtomBreadcrumb] declares a page's title/parent route for a refresh-safe static chain, AtomBreadcrumbService.Push handles unattributed pages at runtime, AtomBreadcrumbProvider cascades the service (no DI registration), and AtomBreadcrumbBar renders accessible semantic HTML. Zero dependencies.</Description>
    <PackageTags>Blazor;Breadcrumbs;Navigation;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAtoms.Breadcrumbs.Tests" />
  </ItemGroup>

</Project>
