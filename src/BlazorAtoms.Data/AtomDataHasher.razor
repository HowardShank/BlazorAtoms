@inherits AtomComponentBase

<div @attributes="AdditionalAttributes"
     class="@ClassAttr(RootClass)"
     style="@StyleAttr(RootStyle)"
     data-state="@State"
     data-algorithm="@AlgorithmAttr">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="atom-data-hasher-label @LabelCol" for="@_inputId">@Label</label>
    }
    <div class="atom-data-hasher-control @ControlCol">
        @if (ShowAlgorithmPicker)
        {
            <div class="atom-data-hasher-algo">
                <label class="atom-data-hasher-algo-label" for="@_selectId">@AlgorithmLabel</label>
                <select id="@_selectId"
                        class="atom-data-hasher-select"
                        value="@Algorithm"
                        disabled="@IsDisabled"
                        aria-disabled="@(IsDisabled ? "true" : null)"
                        aria-label="@AlgorithmLabel"
                        @onchange="OnAlgorithmChanged">
                    <optgroup label="CRC">
                        <option value="@HashAlgorithmKind.Crc32">CRC-32</option>
                        <option value="@HashAlgorithmKind.Crc64">CRC-64</option>
                    </optgroup>
                    <optgroup label="Cryptographic">
                        <option value="@HashAlgorithmKind.Md5">MD5</option>
                        <option value="@HashAlgorithmKind.Sha256">SHA-256</option>
                        <option value="@HashAlgorithmKind.Sha512">SHA-512</option>
                    </optgroup>
                </select>
            </div>
        }
        <div class="atom-data-hasher-input">
            @if (Multiline)
            {
                <textarea id="@_inputId"
                          class="atom-data-hasher-field"
                          rows="@Rows"
                          placeholder="@Placeholder"
                          disabled="@IsDisabled"
                          aria-disabled="@(IsDisabled ? "true" : null)"
                          aria-invalid="@(HasError ? "true" : null)"
                          aria-label="@EffectiveAriaLabel"
                          value="@Value"
                          @oninput="OnInput"
                          spellcheck="false"
                          autocorrect="off"
                          autocapitalize="off"></textarea>
            }
            else
            {
                <input id="@_inputId"
                       type="text"
                       class="atom-data-hasher-field"
                       placeholder="@Placeholder"
                       disabled="@IsDisabled"
                       aria-disabled="@(IsDisabled ? "true" : null)"
                       aria-invalid="@(HasError ? "true" : null)"
                       aria-label="@EffectiveAriaLabel"
                       value="@Value"
                       @oninput="OnInput"
                       spellcheck="false"
                       autocorrect="off"
                       autocapitalize="off" />
            }
        </div>
        <div class="atom-data-hasher-result" role="status" aria-live="polite">
            <span class="atom-data-hasher-result-label">@ResultLabel (@AlgorithmDisplay):</span>
            <pre class="atom-data-hasher-result-value"
                 data-empty="@(string.IsNullOrEmpty(ResultText) ? "true" : null)">@ResultText</pre>
        </div>
        @if (!string.IsNullOrEmpty(DisplayText))
        {
            <span class="atom-data-hasher-subtext" data-state="@State">@DisplayText</span>
        }
    </div>
</div>
