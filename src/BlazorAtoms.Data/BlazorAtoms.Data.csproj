<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Data</PackageId>
    <Title>Blazor Data Utilities</Title>
    <Description>Data-utility components for Blazor. AtomDataHasher computes CRC (CRC-32/CRC-64) and cryptographic (MD5/SHA-256/SHA-512) checksums of arbitrary text with a live-updating result panel, algorithm picker, EditContext-aware validation, and no JavaScript. CRC engines are implemented in-library so the package stays framework-only. Server or WebAssembly, no JS.</Description>
    <PackageTags>Blazor;Hash;Checksum;CRC;CRC32;CRC64;MD5;SHA256;SHA512;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
