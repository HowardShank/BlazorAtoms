@inherits AtomComponentBase

@* AtomBarcode — linear (1D) barcode generator, rendered as inline SVG.
   Rendering is pure C# / no JS. Copy/Save/GetPngBytes lazily import atom-barcode.js.
   Href / AutoLink wrap the code in an anchor with rel="noopener noreferrer". *@

@if (!CancellationToken.IsCancellationRequested)
{
    var href = ResolvedHref;
    if (href is null)
    {
        <div @ref="_rootRef" @attributes="AdditionalAttributes" class="@ClassAttr("atom-barcode")" style="@StyleAttr(null)">@((MarkupString)BuildSvg())</div>
    }
    else
    {
        <a href="@href" target="@LinkTarget" rel="noopener noreferrer" class="atom-barcode-link">
            <div @ref="_rootRef" @attributes="AdditionalAttributes" class="@ClassAttr("atom-barcode")" style="@StyleAttr(null)">@((MarkupString)BuildSvg())</div>
        </a>
    }
}
