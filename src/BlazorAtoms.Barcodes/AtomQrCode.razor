@inherits AtomComponentBase

@* AtomQrCode — QR (2D) barcode. Rendering is pure C# / inline SVG. Copy/Save/GetPngBytes
   lazy-load ./_content/BlazorAtoms.Barcodes/atom-barcode.js on demand. When Href / AutoLink
   yield a URL, the code is wrapped in an anchor with rel="noopener noreferrer". *@

@if (!CancellationToken.IsCancellationRequested)
{
    var href = ResolvedHref;
    if (href is null)
    {
        <div @ref="_rootRef" @attributes="AdditionalAttributes" class="@ClassAttr("atom-qrcode")" style="@StyleAttr(null)">@((MarkupString)BuildSvg())</div>
    }
    else
    {
        <a href="@href" target="@LinkTarget" rel="noopener noreferrer" class="atom-qrcode-link">
            <div @ref="_rootRef" @attributes="AdditionalAttributes" class="@ClassAttr("atom-qrcode")" style="@StyleAttr(null)">@((MarkupString)BuildSvg())</div>
        </a>
    }
}
