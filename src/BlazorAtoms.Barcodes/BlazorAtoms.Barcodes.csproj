<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Barcodes</PackageId>
    <Title>Blazor Barcodes</Title>
    <Description>Barcode and QR code generation (inline SVG, pure C#) plus AtomQrCodeImage viewer that decodes supplied QR images in-process via ZXing.Net + ImageSharp. Optional Copy/Save API uses a small lazy JS module for clipboard/download.</Description>
    <PackageTags>Blazor;Barcode;QRCode;QR;Code128;EAN;UPC;SVG;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
    <PackageReference Include="ZXing.Net" />
    <PackageReference Include="SixLabors.ImageSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Tests exercise the internal encoders directly. -->
    <InternalsVisibleTo Include="BlazorAtoms.Barcodes.Tests" />
  </ItemGroup>

</Project>
