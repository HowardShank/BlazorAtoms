<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Cards</PackageId>
    <Title>Blazor Cards</Title>
    <Description>Card components for Blazor. Ships AtomCardReveal — a hover-reveal info card: an overlay (title/subtitle/background image/dots) plays a staggered pop/slide entrance on mount, then slides away on hover to reveal a scrollable body panel. Zero JS.</Description>
    <PackageTags>Blazor;Cards;InfoCard;CSS;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAtoms.Cards.Tests" />
  </ItemGroup>

</Project>
