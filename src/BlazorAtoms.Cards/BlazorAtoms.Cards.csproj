<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Cards</PackageId>
    <Title>Blazor Cards</Title>
    <Description>Card components for Blazor, in two families. AtomCard plus AtomCardHeader/AtomCardBody/AtomCardFooter is a plain structural surface: media slot, elevation, clickable as a real anchor or button, and sections that inherit padding and dividers from the card. AtomCardReveal, AtomCardFlip, AtomCardExpand, AtomCardCurl and AtomCardSplit are hover-reveal info cards, each uncovering a body panel a different way. Zero JS.</Description>
    <PackageTags>Blazor;Cards;Card;InfoCard;HoverReveal;CSS;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAtoms.Cards.Tests" />
  </ItemGroup>

</Project>
