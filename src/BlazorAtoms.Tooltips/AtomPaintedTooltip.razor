@inherits AtomComponentBase

@*
    AtomPaintedTooltip.razor
    -------------------------
    Shaped tooltip whose SVG also PAINTS the bubble: optional linear-gradient fill (via <defs>),
    SVG stroke border, optional soft shadow. Falls back to the solid --tip-bg token when no
    gradient is set. Positioning + show/hide are pure CSS; Placement.Cursor uses a small
    self-loaded JS module.
*@

<span @attributes="AdditionalAttributes" class="@ClassAttr("atom-ptooltip")" style="@StyleAttr(RootStyle)">
    <span @ref="_triggerRef" class="atom-ptooltip-trigger" aria-describedby="@(Disabled ? null : _id)">
        @ChildContent
    </span>
    @if (!Disabled && !CancellationToken.IsCancellationRequested)
    {
        <span @ref="_bubbleRef"
              id="@_id"
              role="tooltip"
              class="atom-ptooltip-bubble @(Shadow ? "has-shadow" : null)"
              data-placement="@PlacementValue"
              data-shape="@ShapeValue"
              data-halign="@HAlignValue"
              data-valign="@VAlignValue"
              style="@BubbleStyle">
            <svg class="atom-ptooltip-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @if (HasGradient)
                {
                    <defs>
                        <linearGradient id="@GradId" x1="@GradX1" y1="@GradY1" x2="@GradX2" y2="@GradY2">
                            <stop offset="0" stop-color="@GradientFrom" />
                            <stop offset="1" stop-color="@GradientTo" />
                        </linearGradient>
                    </defs>
                }
                @switch (Shape)
                {
                    case PaintedTooltipShape.Pill:
                        <rect class="apt-path" style="@PathFillStyle" x="1.5" y="1.5" width="97" height="97" rx="50" ry="50" vector-effect="non-scaling-stroke" />
                        break;
                    case PaintedTooltipShape.Ellipse:
                        <ellipse class="apt-path" style="@PathFillStyle" cx="50" cy="50" rx="48.5" ry="48.5" vector-effect="non-scaling-stroke" />
                        break;
                    case PaintedTooltipShape.Cloud:
                        <path class="apt-path" style="@PathFillStyle" d="@CloudPath" vector-effect="non-scaling-stroke" />
                        break;
                    case PaintedTooltipShape.Burst:
                        <path class="apt-path" style="@PathFillStyle" d="@BurstPath" vector-effect="non-scaling-stroke" />
                        break;
                    case PaintedTooltipShape.FoldedCorner:
                        <path class="apt-path" style="@PathFillStyle" d="M1.5 1.5 H74 L98.5 26 V98.5 H1.5 Z" vector-effect="non-scaling-stroke" />
                        <path class="apt-fold" d="M74 1.5 V26 H98.5" vector-effect="non-scaling-stroke" />
                        break;
                    default:
                        <rect class="apt-path" style="@PathFillStyle" x="1.5" y="1.5" width="97" height="97" rx="@RxStr" ry="@RxStr" vector-effect="non-scaling-stroke" />
                        break;
                }
            </svg>
            @if (ShowsArrow)
            {
                <span class="atom-ptooltip-arrow" aria-hidden="true"></span>
            }
            <span class="atom-ptooltip-content">
                @if (TooltipContent is not null)
                {
                    @TooltipContent
                }
                else
                {
                    @Text
                }
            </span>
        </span>
    }
</span>
