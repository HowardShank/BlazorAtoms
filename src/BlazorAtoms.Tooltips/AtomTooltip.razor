@inherits AtomComponentBase

@*
    AtomTooltip.razor
    ------------------
    Wraps arbitrary trigger content; shows a bubble on hover or keyboard focus.
    Placement is pure CSS (position:absolute) for every mode except Placement.Cursor,
    which follows the pointer via a small JS module the component loads itself
    (see AtomTooltip.razor.cs). Show/hide is plain :hover / :focus-within.
*@

<span class="atom-tooltip @Class" style="@RootStyle">
    <span @ref="_triggerRef" class="atom-tooltip-trigger" aria-describedby="@(Disabled ? null : _id)">
        @ChildContent
    </span>
    @if (!Disabled && !CancellationToken.IsCancellationRequested)
    {
        <span @ref="_bubbleRef"
              id="@_id"
              role="tooltip"
              class="atom-tooltip-bubble"
              data-placement="@PlacementValue"
              data-shape="@ShapeValue">
            @if (ShowsArrow)
            {
                <span class="atom-tooltip-arrow" aria-hidden="true"></span>
            }
            <span class="atom-tooltip-content">
                @if (TooltipContent is not null)
                {
                    @TooltipContent
                }
                else
                {
                    @Text
                }
            </span>
        </span>
    }
</span>
