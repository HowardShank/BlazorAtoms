@inherits AtomComponentBase

@*
    AtomShapedTooltip.razor
    ------------------------
    Same trigger-anchored, hover/focus tooltip as AtomTooltip, but the bubble outline is an
    inline SVG path (see ShapeSvg in the code-behind) painted from the CSS color tokens
    (fill:var(--tip-bg); stroke:var(--tip-border)). Border therefore works on every shape.
    Positioning + show/hide are pure CSS; TooltipPlacement.Cursor uses a small self-loaded JS module.
*@

<span @attributes="AdditionalAttributes" class="@ClassAttr("atom-stooltip")" style="@StyleAttr(RootStyle)">
    <span @ref="_triggerRef" class="atom-stooltip-trigger" aria-describedby="@(Disabled ? null : _id)">
        @ChildContent
    </span>
    @if (!Disabled && !CancellationToken.IsCancellationRequested)
    {
        <span @ref="_bubbleRef"
              id="@_id"
              role="tooltip"
              class="atom-stooltip-bubble"
              data-placement="@PlacementValue"
              data-shape="@ShapeValue"
              data-halign="@HAlignValue"
              data-valign="@VAlignValue"
              style="@BubbleStyle">
            <svg class="atom-stooltip-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                @switch (Shape)
                {
                    case ShapedTooltipShape.Pill:
                        <rect class="ast-path" x="1.5" y="1.5" width="97" height="97" rx="50" ry="50" vector-effect="non-scaling-stroke" />
                        break;
                    case ShapedTooltipShape.Ellipse:
                        <ellipse class="ast-path" cx="50" cy="50" rx="48.5" ry="48.5" vector-effect="non-scaling-stroke" />
                        break;
                    case ShapedTooltipShape.Cloud:
                        <path class="ast-path" d="@CloudPath" vector-effect="non-scaling-stroke" />
                        break;
                    case ShapedTooltipShape.Burst:
                        <path class="ast-path" d="@BurstPath" vector-effect="non-scaling-stroke" />
                        break;
                    case ShapedTooltipShape.FoldedCorner:
                        <path class="ast-path" d="M1.5 1.5 H74 L98.5 26 V98.5 H1.5 Z" vector-effect="non-scaling-stroke" />
                        <path class="ast-fold" d="M74 1.5 V26 H98.5" vector-effect="non-scaling-stroke" />
                        break;
                    default:
                        <rect class="ast-path" x="1.5" y="1.5" width="97" height="97" rx="@RxStr" ry="@RxStr" vector-effect="non-scaling-stroke" />
                        break;
                }
            </svg>
            @if (ShowsArrow)
            {
                <span class="atom-stooltip-arrow" aria-hidden="true"></span>
            }
            <span class="atom-stooltip-content">
                @if (TooltipContent is not null)
                {
                    @TooltipContent
                }
                else
                {
                    @Text
                }
            </span>
        </span>
    }
</span>
