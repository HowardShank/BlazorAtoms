@typeparam TValue
@inherits AtomInputBase<TValue>

<div @attributes="AdditionalAttributes"
     class="@ClassAttr(RootClass)"
     style="@StyleAttr(RootStyle)"
     data-state="@State"
     data-variant="@VariantAttr"
     data-size="@SizeAttr"
     data-effect="@EffectAttr">
    @if (!string.IsNullOrEmpty(Label))
    {
        <label class="atom-number-field-label @LabelCol">
            @Label
            @if (Required)
            {
                <span class="atom-number-field-required" aria-hidden="true">*</span>
            }
        </label>
    }
    <div class="atom-number-field-control @ControlCol">
        <div class="atom-number-field-box">
            @if (!string.IsNullOrEmpty(PrefixText))
            {
                <span class="atom-number-field-prefix">@PrefixText</span>
            }
            <input class="atom-number-field-field"
                   type="number"
                   value="@FormattedValue"
                   min="@MinAttr"
                   max="@MaxAttr"
                   step="@StepAttr"
                   placeholder="@Placeholder"
                   disabled="@IsDisabled"
                   readonly="@IsReadOnly"
                   required="@Required"
                   data-spinners="@SpinnersAttr"
                   aria-disabled="@(IsDisabled ? "true" : null)"
                   aria-invalid="@(HasError ? "true" : null)"
                   aria-label="@EffectiveAriaLabel"
                   @oninput="OnInputEvent"
                   @onchange="OnChangeEvent" />
            @if (!string.IsNullOrEmpty(SuffixText))
            {
                <span class="atom-number-field-suffix">@SuffixText</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(DisplayText))
        {
            <span class="atom-number-field-subtext" data-state="@State">@DisplayText</span>
        }
    </div>
</div>
