<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Inputs</PackageId>
    <Title>Blazor Inputs</Title>
    <Description>Form input components for Blazor. The standard fields — AtomTextField, AtomTextArea, AtomNumberField, AtomCheckbox, AtomSwitch, AtomRadioGroup, AtomSelect — each wrap a native control and share one base: @bind-Value, an EditContext/DataAnnotations-aware error state, a real ReadOnly vs Disabled distinction, and Variant/Size/Effect styling axes over --field-* custom properties. Also AtomRangeInput (labeled slider/range control) and AtomCrtInput/AtomCrtDisplay (CRT-terminal styled text input and display). Server or WebAssembly, no JS.</Description>
    <PackageTags>Blazor;Input;TextField;TextArea;Number;Checkbox;Switch;Radio;Select;Range;Slider;Form;Validation;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAtoms.Inputs.Tests" />
  </ItemGroup>

</Project>
