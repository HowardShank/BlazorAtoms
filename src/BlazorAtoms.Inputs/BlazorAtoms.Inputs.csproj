<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Inputs</PackageId>
    <Title>Blazor Inputs</Title>
    <Description>Form input components for Blazor. AtomRangeInput renders a labeled slider/range control — native &lt;input type="range"&gt; for free pointer/touch/keyboard support, min/max/step, a ReadOnly (greyed, no input) vs Disabled (renders nothing) distinction, help text, and an EditContext/DataAnnotations-aware error state with an inline error icon. Server or WebAssembly, no JS.</Description>
    <PackageTags>Blazor;Input;Range;Slider;Form;Validation;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
