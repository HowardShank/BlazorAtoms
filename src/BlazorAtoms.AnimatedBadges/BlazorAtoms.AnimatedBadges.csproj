<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.AnimatedBadges</PackageId>
    <Title>Blazor Animated Badges</Title>
    <Description>Animated badge for Blazor — a label/count that pops in when it has a value, overlays a host element at a corner (or renders inline), and can bounce, spin, pulse, or ping. Fully styleable; accepts any object value with type-aware formatting. Server or WebAssembly, no JS.</Description>
    <PackageTags>Blazor;Badge;Notification;Count;Animation;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
