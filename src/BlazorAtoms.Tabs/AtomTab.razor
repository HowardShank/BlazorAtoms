@inherits AtomComponentBase

@* A real <button>: the browser gives focus, Enter/Space activation and the disabled state for free.
   role="tab" replaces its implicit button role, which is what the tablist pattern expects. *@
<button @attributes="AdditionalAttributes"
        @ref="_element"
        type="button"
        id="@Id"
        class="@ClassAttr("atom-tab")"
        style="@StyleAttr(null)"
        role="tab"
        aria-selected="@(IsActive ? "true" : "false")"
        aria-controls="@PanelId"
        aria-label="@AriaLabel"
        aria-disabled="@(Disabled ? "true" : null)"
        disabled="@Disabled"
        tabindex="@TabIndex"
        data-active="@(IsActive ? "true" : null)"
        @onclick="SelectAsync">
    @if (Icon is not null)
    {
        <span class="atom-tab-icon" aria-hidden="true">@Icon</span>
    }
    <span class="atom-tab-label">
        @if (ChildContent is not null)
        {
            @ChildContent
        }
        else
        {
            @Title
        }
    </span>
    @if (!string.IsNullOrEmpty(Badge))
    {
        <span class="atom-tab-badge">@Badge</span>
    }
</button>
