@inherits AtomChartElementBase

<div @attributes="AdditionalAttributes"
     class="@ClassAttr("atom-chart-empty-state")"
     style="@StyleAttr(null)">
    @if (ChildContent is not null)
    {
        @ChildContent
    }
    else
    {
        <span class="atom-chart-empty-state-text">@Text</span>
    }
</div>
