<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Scrollbars</PackageId>
    <Title>Blazor Scrollbars</Title>
    <Description>Custom-styled scrollbars for Blazor. AtomScrollbar wraps arbitrary child content in a scroll box with a themed scrollbar (color, size, gradient, radius) — full control on WebKit browsers, scrollbar-color/scrollbar-width fallback on Firefox. Zero JS.</Description>
    <PackageTags>Blazor;Scrollbar;CSS;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAtoms.Scrollbars.Tests" />
  </ItemGroup>

</Project>
