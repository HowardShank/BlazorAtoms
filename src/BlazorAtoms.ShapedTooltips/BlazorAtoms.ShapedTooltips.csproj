<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.ShapedTooltips</PackageId>
    <Title>Blazor Shaped Tooltips</Title>
    <Description>Tooltip for Blazor whose bubble outline is drawn with inline SVG (rectangle, pill, ellipse, cloud, burst, folded corner) — so border and arrow work on every shape. Color stays in CSS tokens. Server or WebAssembly.</Description>
    <PackageTags>Blazor;Tooltip;SVG;Shape;Popover;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
