@inherits AtomComponentBase

@*
    AtomScreensaverRain.razor
    ---------------------
    Matrix-style digital rain screensaver. Renders a canvas element and drives the animation
    via a tiny JS module. Supports theme parameters (glow, scanlines, background color, font)
    exposed as data attributes for CSS/JS to consume.
*@
    @if (!Disabled && !CancellationToken.IsCancellationRequested)
    {

<div @attributes="AdditionalAttributes"
     class="@ClassAttr("atom-screensaver-rain")"
     style="@StyleAttr(RootStyle)"
     data-background="@BackgroundColor"
     data-font="@FontFamily"
     data-glow="@(Glow ? "true" : null)"
     data-scanlines="@(Scanlines ? "true" : null)"
     role="img"
     aria-label="Matrix rain screensaver">
        <canvas @ref="_canvasRef" id="@_canvasId" class="atom-screensaver-rain__canvas"></canvas>
</div>
}
