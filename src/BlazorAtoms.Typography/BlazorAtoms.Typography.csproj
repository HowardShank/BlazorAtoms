<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Typography</PackageId>
    <Title>Blazor Typography</Title>
    <Description>Text primitives and animated text components for Blazor. AtomTextCycle rotates through a list of words/phrases in a vertical flip-cascade loop, entirely CSS-driven (generated @keyframes sized to the word count, no JS).</Description>
    <PackageTags>Blazor;Typography;Text;Animation;CSS;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
