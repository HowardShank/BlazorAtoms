@inherits AtomComponentBase

@*
    AtomTextSparkle.razor
    ----------------------
    Zero-JS hover effect: layered 3D text-shadow + a colorized glare sweep (clipped-text gradient)
    + SVG sparkles that pop in around the text. Pure CSS :hover/:active — the trigger itself needs
    no C# state at all, unlike the click/loop-driven Typography components. Renders <a> when Href
    is set (a real link), or a focusable <span> (tabindex, no href) otherwise — same markup either
    way, Blazor omits the href attribute when it's null.
*@

@if (!CancellationToken.IsCancellationRequested && !string.IsNullOrEmpty(Text))
{
    <a @attributes="AdditionalAttributes"
       href="@Href"
       tabindex="@(string.IsNullOrEmpty(Href) ? "0" : null)"
       class="@ClassAttr("atom-text-sparkle")"
       style="@StyleAttr(RootStyle)">
        @for (var i = 0; i < SparkleCount; i++)
        {
            var sparkle = GetSparkle(i);
            <svg class="atom-text-sparkle-svg" style="@SparkleStyle(sparkle)" viewBox="0 0 96 96" fill="none" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M93.781 51.578C95 50.969 96 49.359 96 48c0-1.375-1-2.969-2.219-3.578 0 0-22.868-1.514-31.781-10.422-8.915-8.91-10.438-31.781-10.438-31.781C50.969 1 49.375 0 48 0s-2.969 1-3.594 2.219c0 0-1.5 22.87-10.406 31.781-8.908 8.913-31.781 10.422-31.781 10.422C1 45.031 0 46.625 0 48c0 1.359 1 2.969 2.219 3.578 0 0 22.873 1.51 31.781 10.422 8.906 8.911 10.406 31.781 10.406 31.781C45.031 95 46.625 96 48 96s2.969-1 3.562-2.219c0 0 1.523-22.871 10.438-31.781 8.913-8.908 31.781-10.422 31.781-10.422Z" fill="currentColor" />
            </svg>
        }
        <span class="atom-text-sparkle-textwrap">
            <span class="atom-text-sparkle-label">@Text</span>
            <span class="atom-text-sparkle-label atom-text-sparkle-glare" aria-hidden="true">@Text</span>
        </span>
    </a>
}
