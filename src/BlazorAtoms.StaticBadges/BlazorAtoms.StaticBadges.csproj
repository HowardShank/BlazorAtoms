<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.StaticBadges</PackageId>
    <Title>Blazor Static Badges</Title>
    <Description>Static (no-animation) badge for Blazor — a label/count in a rich variety of shapes: pill, circle, square, rounded, plus SVG-drawn star, hexagon, diamond, shield, starburst, and ribbon. Overlays a host element at a corner or renders inline. Fully styleable; accepts any object value with type-aware formatting. Server or WebAssembly, no JS.</Description>
    <PackageTags>Blazor;Badge;Label;Count;Shape;Star;Ribbon;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
