<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.PaintedTooltips</PackageId>
    <Title>Blazor Painted Tooltips</Title>
    <Description>Tooltip for Blazor whose bubble is drawn with inline SVG that also paints it — gradient fills, gradient/solid stroke, and an optional soft shadow — across every shape. Server or WebAssembly.</Description>
    <PackageTags>Blazor;Tooltip;SVG;Gradient;Shape;Popover;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
