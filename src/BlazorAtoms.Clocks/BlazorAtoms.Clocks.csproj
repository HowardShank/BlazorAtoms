<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Clocks</PackageId>
    <Title>Blazor Clocks</Title>
    <Description>Live time-display components for Blazor. AtomClock — a ticking clock for a single time source (server host, UTC, or the auto-detected browser timezone), with configurable format/culture, an optional label, and opt-out ticking. AtomClockPair — two clocks (e.g. server + local) shown side-by-side or stacked. Server or WebAssembly. Browser-timezone detection uses a tiny self-loaded JS module (opt-in via Kind=Browser); everything else is JS-free.</Description>
    <PackageTags>Blazor;Clock;Time;DateTime;Timezone;Local;Server;WebAssembly</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
