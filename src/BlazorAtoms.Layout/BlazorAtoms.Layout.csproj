<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Layout</PackageId>
    <Title>Blazor Layout</Title>
    <Description>Layout components for Blazor. AtomDrawer is an overlay panel that opens from any viewport edge with configurable transitions, sizing, and styling.</Description>
    <PackageTags>Blazor;Layout;Drawer;Overlay;Panel;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlazorAtoms.Layout.Tests" />
  </ItemGroup>

</Project>
