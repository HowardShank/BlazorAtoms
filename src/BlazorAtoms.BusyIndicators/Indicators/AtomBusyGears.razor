@inherits AtomBusyIndicatorBase
@if (!CancellationToken.IsCancellationRequested)
{
<svg viewBox="0 0 120 120" width="@Size" height="@Size" class="busy-gears @Class" style="@ThemeStyle">
    <g class="gear-a">
        <circle class="teeth" cx="48" cy="52" r="17" stroke-width="7" stroke-dasharray="5 5.7" />
        <circle class="body"  cx="48" cy="52" r="13" />
        <circle class="hub-a" cx="48" cy="52" r="3.5" />
    </g>
    <g class="gear-b">
        <circle class="teeth" cx="70" cy="70" r="11" stroke-width="6" stroke-dasharray="4 4.6" />
        <circle class="body"  cx="70" cy="70" r="8" />
        <circle class="hub-b" cx="70" cy="70" r="2.8" />
    </g>
</svg>
}

@code {
    /// <summary>Rendered width/height in pixels.</summary>
    [Parameter] public int Size { get; set; } = 48;

    /// <summary>Large-gear hub. Falls back to the built-in light/dark default when null.</summary>
    [Parameter] public string? Blip { get; set; }

    /// <summary>Small-gear hub. Falls back to the built-in default when null.</summary>
    [Parameter] public string? Glow { get; set; }

    /// <summary>Teeth + rim strokes. Falls back to the built-in default when null.</summary>
    [Parameter] public string? Line { get; set; }

    /// <summary>Gear body fill. Falls back to the built-in default when null.</summary>
    [Parameter] public string? Fill { get; set; }

    /// <summary>Extra CSS class(es) on the root svg element.</summary>
    [Parameter] public string? Class { get; set; }

    private string ThemeStyle => string.Concat(
        Blip is null ? "" : $"--ind-blip:{Blip};",
        Glow is null ? "" : $"--ind-glow:{Glow};",
        Line is null ? "" : $"--ind-line:{Line};",
        Fill is null ? "" : $"--ind-fill:{Fill};");
}
