<!--
  Trimmer root descriptor (WASM-AOT / PublishTrimmed safety).

  AtomBusyIndicator discovers the AtomBusy* indicators by REFLECTION
  (Assembly.GetTypes() filtered to subclasses of AtomBusyIndicatorBase). Reflection is
  invisible to the IL linker, so under a trimmed/AOT publish the indicator types —
  referenced nowhere statically — would be stripped and discovery would find nothing.

  Rooting the Indicators namespace keeps every AtomBusy* type (and its members) regardless of
  consumer trim settings, and stays expandable: the <namespace> wildcard covers any
  future indicator added to the folder. Blazor Server never trims, so this is a no-op
  there.
-->
<linker>
  <assembly fullname="BlazorAtoms.BusyIndicators">
    <namespace fullname="BlazorAtoms.BusyIndicators.Indicators" />
  </assembly>
</linker>
