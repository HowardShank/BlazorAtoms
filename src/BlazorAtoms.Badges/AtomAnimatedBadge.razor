@inherits AtomComponentBase

@*
    AtomAnimatedBadge.razor
    ------------------------
    Pops in when the value is "present". Overlays a host at a corner when ChildContent is given,
    else renders inline. Pure CSS; motion disabled under prefers-reduced-motion. See the
    code-behind for value→string conversion and the popup gate (ShowBadge).
*@

@if (ChildContent is not null)
{
    <span @attributes="AdditionalAttributes" class="@ClassAttr("atom-badge-host")" style="@StyleAttr(RootStyle)">
        @ChildContent
        @if (ShowBadge && !CancellationToken.IsCancellationRequested)
        {
            @Badge
        }
    </span>
}
else if (ShowBadge && !CancellationToken.IsCancellationRequested)
{
    @Badge
}

@code {
    // Authored here (not MarkupString) so Blazor scoped CSS applies. @key remounts the badge when
    // it changes, replaying one-shot (Appear/OnChange) animations.
    private RenderFragment Badge => @<span @key="_animKey"
             @attributes="@(ChildContent is null ? AdditionalAttributes : null)"
             class="@(ChildContent is null ? ClassAttr("atom-badge") : "atom-badge")"
             role="status"
             aria-live="polite"
             aria-label="@EffectiveAriaLabel"
             data-placement="@PlacementValue"
             data-shape="@ShapeValue"
             data-variant="@VariantValue"
             data-anim="@AnimValue"
             data-trigger="@TriggerValue"
             data-svg="@(IsSvgShape ? "true" : null)"
             data-dot="@(Dot ? "true" : null)"
             style="@(ChildContent is null ? StyleAttr(RootStyle) : null)">
        @if (Animation == BadgeAnimation.Ping)
        {
            <span class="atom-badge-ring" aria-hidden="true"></span>
        }
        @if (IsSvgShape)
        {
            <svg class="atom-badge-svg" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                <path class="badge-path" d="@CurrentPath" vector-effect="non-scaling-stroke" />
            </svg>
        }
        @if (!Dot)
        {
            <span class="atom-badge-text">@Display</span>
        }
    </span>;
}
