<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="$(RepoRoot)build\Packable.props" />
  <Import Project="$(RepoRoot)build\Shared.props" />

  <PropertyGroup>
    <PackageId>BlazorAtoms.Badges</PackageId>
    <Title>Blazor Badges</Title>
    <Description>Badge components for Blazor. AtomStaticBadge — a no-animation label/count in a rich variety of shapes (pill, circle, square, rounded, plus SVG star, hexagon, diamond, shield, starburst, ribbon). AtomAnimatedBadge — a badge that pops in on value with Pop/Bounce/Spin/Pulse/Ping motion. Both overlay a host element at a corner or render inline, are fully styleable, and accept any object value with type-aware formatting. Server or WebAssembly, no JS.</Description>
    <PackageTags>Blazor;Badge;Label;Count;Shape;Animation;Notification;WebAssembly;Server</PackageTags>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

</Project>
