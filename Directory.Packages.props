<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Versions are defined here once; csproj files use versionless <PackageReference>.
       Multi-targeted libraries/tests need a version per TFM build pass. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="9.0.18" Condition="'$(TargetFramework)'=='net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.10" Condition="'$(TargetFramework)'=='net10.0'" />
    <!-- QR image decoder for AtomQrCodeImage (pure managed, works in Server + WASM). -->
    <PackageVersion Include="ZXing.Net" Version="0.16.9" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="2.1.11" />
  </ItemGroup>

  <!-- Demo host/client dependencies. Also pulled in transitively by bunit (per-TFM) now that
       CentralPackageTransitivePinningEnabled is on, so this needs the same per-TFM split as
       Components.Web above — an unconditioned pin here clobbers bunit's net9.0-pass dependency. -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.18" Condition="'$(TargetFramework)'=='net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" Condition="'$(TargetFramework)'=='net10.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="9.0.18" Condition="'$(TargetFramework)'=='net9.0'" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.10" Condition="'$(TargetFramework)'=='net10.0'" />
  </ItemGroup>

  <!-- Test dependencies -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="bunit" Version="2.7.2" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
    <!-- Transitive via bunit, which only floors it at 1.4.0 (the version NU1902 flagged:
         GHSA-pgww-w46g-26qg, mXSS via MathML annotation-xml, fixed in 1.5.0). Pin up to latest stable. -->
    <PackageVersion Include="AngleSharp" Version="1.5.2" />
  </ItemGroup>

</Project>
