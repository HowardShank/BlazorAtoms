@* AtomsMark.razor — self-contained Blazor mark generated by the BlazorAtoms logo playground.
   No CSS file, no JS, no DI, no package reference. Works in Server or WASM. Namespace-free: it inherits the
   folder's namespace — reference via @using, or drop it in the same folder / list it in _Imports.razor.
   <AtomsMark /> reproduces your current design (settings are baked as the defaults). Override any parameter. *@
@((MarkupString)BuildSvg())

@code {
	/// <summary>Which arrangement to render. Use e.g. Layout="AtomsMark.MarkLayout.Stacked".</summary>
	public enum MarkLayout { Icon, Lockup, Stacked }

	// content
	[Parameter] public MarkLayout Layout { get; set; } = MarkLayout.Icon;
	[Parameter] public int Size { get; set; } = 128;   // icon: edge px; lockup/stacked: height px (width keeps aspect)
	[Parameter] public string Number { get; set; } = "5";
	[Parameter] public string Symbol { get; set; } = "B";
	[Parameter] public string Label { get; set; } = "Atoms";
	[Parameter] public string Word1 { get; set; } = "Blazor";
	[Parameter] public string Word2 { get; set; } = "Atoms";

	// shape
	[Parameter] public string Flame { get; set; } = "A";   // "A" | "B" | "teardrop"
	[Parameter] public double FlameScale { get; set; } = 1;
	[Parameter] public int Corner { get; set; } = 16;
	[Parameter] public double StrokeWidth { get; set; } = 2;
	[Parameter] public int SymbolSize { get; set; } = 46;
	[Parameter] public int NumberSize { get; set; } = 16;
	[Parameter] public double LabelSize { get; set; } = 10;
	[Parameter] public double LabelSpacing { get; set; } = 2.5;
	[Parameter] public int Word1Size { get; set; } = 30;
	[Parameter] public int Word2Size { get; set; } = 46;

	// colors
	[Parameter] public string TileTop { get; set; } = "#fb9752";
	[Parameter] public string TileBottom { get; set; } = "#f97316";
	[Parameter] public string Stroke { get; set; } = "#9f4100";
	[Parameter] public string FlameTip { get; set; } = "#fce792";
	[Parameter] public string FlameMid { get; set; } = "#fa9829";
	[Parameter] public string FlameBase { get; set; } = "#f5450a";
	[Parameter] public string InnerTop { get; set; } = "#ffedb8";
	[Parameter] public string InnerBottom { get; set; } = "#ffb13d";
	[Parameter] public string Ember { get; set; } = "#f8a973";
	[Parameter] public string SymbolColor { get; set; } = "#ffffff";
	[Parameter] public string Cream { get; set; } = "#fefaf7";
	[Parameter] public string Word1Color { get; set; } = "#6b6b6b";
	[Parameter] public string Word2Top { get; set; } = "#fa9829";
	[Parameter] public string Word2Bottom { get; set; } = "#f97316";

	readonly string _u = System.Guid.NewGuid().ToString("N").Substring(0, 8); // unique gradient ids per instance
	static string F(double v) => v.ToString(System.Globalization.CultureInfo.InvariantCulture);
	static string Esc(string s) => (s ?? "").Replace("&", "&amp;").Replace("<", "&lt;").Replace(">", "&gt;");

	string BuildSvg()
	{
		const string font = "Segoe UI, Helvetica Neue, Arial, sans-serif";
		string fo, fi;
		switch (Flame)
		{
			case "B": fo = "M64 4 C 61 16, 52 22, 51 33 C 50 41, 57 47, 64 47 C 71 47, 78 41, 77 33 C 76 22, 67 16, 64 4 Z"; fi = "M64 18 C 61 26, 57 29, 57 36 C 57 42, 60 45, 64 45 C 68 45, 71 42, 71 36 C 71 29, 67 26, 64 18 Z"; break;
			case "teardrop": fo = "M64 6 C 56 20, 49 25, 49 34 C 49 42, 56 46, 64 46 C 72 46, 79 42, 79 34 C 79 25, 72 20, 64 6 Z"; fi = "M64 20 C 59 28, 56 31, 56 37 C 56 42, 60 45, 64 45 C 68 45, 72 42, 72 37 C 72 31, 69 28, 64 20 Z"; break;
			default: fo = "M64 47 C 55 47, 49 42, 50 34 C 51 27, 56 26, 57 20 C 58 15, 55 12, 58 7 C 60 11, 61 16, 63 17 C 64 12, 63 8, 65 5 C 68 11, 69 17, 72 22 C 76 28, 79 31, 79 37 C 79 43, 73 47, 64 47 Z"; fi = "M64 22 C 59 28, 57 31, 57 37 C 57 42, 60 45, 64 45 C 68 45, 71 42, 71 37 C 71 32, 68 30, 66 24 C 65 22, 65 20, 64 22 Z"; break;
		}
		string xf = $"translate(64,47) scale({F(FlameScale)}) translate(-64,-47)";
		string defs =
			"<defs>" +
			$"<linearGradient id='tileGrad_{_u}' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='{TileTop}'/><stop offset='1' stop-color='{TileBottom}'/></linearGradient>" +
			$"<linearGradient id='flameGrad_{_u}' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='{FlameTip}'/><stop offset='0.55' stop-color='{FlameMid}'/><stop offset='1' stop-color='{FlameBase}'/></linearGradient>" +
			$"<linearGradient id='flameInner_{_u}' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='{InnerTop}'/><stop offset='1' stop-color='{InnerBottom}'/></linearGradient>" +
			$"<radialGradient id='emberGlow_{_u}' cx='0.5' cy='0.5' r='0.5'><stop offset='0' stop-color='{Ember}' stop-opacity='0.55'/><stop offset='1' stop-color='{Ember}' stop-opacity='0'/></radialGradient>" +
			$"<linearGradient id='wordGrad_{_u}' x1='0' y1='0' x2='0' y2='1'><stop offset='0' stop-color='{Word2Top}'/><stop offset='1' stop-color='{Word2Bottom}'/></linearGradient>" +
			"</defs>";
		string tile =
			$"<rect x='14' y='28' width='100' height='84' rx='{Corner}' fill='url(#tileGrad_{_u})' stroke='{Stroke}' stroke-width='{F(StrokeWidth)}'/>" +
			$"<g transform='{xf}'>" +
			$"<circle cx='64' cy='30' r='24' fill='url(#emberGlow_{_u})'/>" +
			$"<path d='{fo}' fill='url(#flameGrad_{_u})'/>" +
			$"<path d='{fi}' fill='url(#flameInner_{_u})'/>" +
			"</g>" +
			$"<text x='29' y='52' font-family='{font}' font-size='{NumberSize}' font-weight='600' fill='{Cream}'>{Esc(Number)}</text>" +
			$"<text x='64' y='94' text-anchor='middle' font-family='{font}' font-size='{SymbolSize}' font-weight='700' fill='{SymbolColor}'>{Esc(Symbol)}</text>";
		if (Layout == MarkLayout.Icon && !string.IsNullOrWhiteSpace(Label))
			tile += $"<text x='64' y='106' text-anchor='middle' font-family='{font}' font-size='{F(LabelSize)}' font-weight='600' letter-spacing='{F(LabelSpacing)}' fill='{Cream}'>{Esc(Label)}</text>";

		if (Layout == MarkLayout.Icon)
			return $"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 128 128' width='{Size}' height='{Size}' role='img' aria-label='{Esc(Symbol)} {Esc(Label)}'>{defs}{tile}</svg>";

		if (Layout == MarkLayout.Stacked)
		{
			int ws = (int)System.Math.Round(Size * 320.0 / 220.0);
			string wordsS =
				$"<text x='160' y='158' text-anchor='middle' font-family='{font}' font-size='{Word1Size}' font-weight='500' letter-spacing='0.5' fill='{Word1Color}'>{Esc(Word1)}</text>" +
				$"<text x='160' y='202' text-anchor='middle' font-family='{font}' font-size='{Word2Size}' font-weight='800' letter-spacing='0.5' fill='url(#wordGrad_{_u})'>{Esc(Word2)}</text>";
			return $"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 320 220' width='{ws}' height='{Size}' role='img' aria-label='{Esc(Word1)} {Esc(Word2)}'>{defs}<g transform='translate(96,8)'>{tile}</g>{wordsS}</svg>";
		}

		int w = (int)System.Math.Round(Size * 430.0 / 128.0);
		string words =
			$"<text x='140' y='58' font-family='{font}' font-size='{Word1Size}' font-weight='500' letter-spacing='0.5' fill='{Word1Color}'>{Esc(Word1)}</text>" +
			$"<text x='138' y='102' font-family='{font}' font-size='{Word2Size}' font-weight='800' letter-spacing='0.5' fill='url(#wordGrad_{_u})'>{Esc(Word2)}</text>";
		return $"<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 430 128' width='{w}' height='{Size}' role='img' aria-label='{Esc(Word1)} {Esc(Word2)}'>{defs}<g>{tile}</g>{words}</svg>";
	}
}
